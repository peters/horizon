#!/usr/bin/python3
"""Private worker Git/gh binding. Token permissions remain the GitHub boundary."""
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

CREDENTIAL = Path('/run/horizon-credentials/github.json')
GIT_DIR = Path('/workspace/repository.git')


def validate(value):
    if set(value) != {'repository', 'token', 'author_name', 'author_email'}:
        raise ValueError('Invalid Git binding')
    if not all(isinstance(item, str) for item in value.values()):
        raise ValueError('Invalid Git binding')
    parts = value['repository'].split('/')
    if len(parts) != 2 or any(not re.fullmatch(r'[A-Za-z0-9_.-]{1,100}', part)
                              or part in ('.', '..') for part in parts):
        raise ValueError('Invalid Git repository')
    token = value['token']
    if not token or len(token) > 2048 or any(ord(c) < 33 or ord(c) > 126 for c in token):
        raise ValueError('Invalid Git credential')
    for key in ('author_name', 'author_email'):
        item = value[key]
        if not item or len(item.encode()) > 200 or any(ord(c) < 32 or ord(c) == 127 for c in item):
            raise ValueError('Invalid Git identity')
    return value


def read_binding():
    if not CREDENTIAL.exists():
        return None
    stat = CREDENTIAL.stat()
    if stat.st_mode & 0o077 or stat.st_size > 4096 or not CREDENTIAL.is_file():
        raise ValueError('Git credential file must be private')
    return validate(json.loads(CREDENTIAL.read_text()))


def install(value):
    value = validate(value)
    env = dict(os.environ, HOME='/workspace/home')
    commands = [
        ['git', 'config', '--global', 'user.name', value['author_name']],
        ['git', 'config', '--global', 'user.email', value['author_email']],
        ['git', 'config', '--global', 'credential.https://github.com.useHttpPath', 'true'],
        ['git', 'config', '--global', '--replace-all', 'credential.https://github.com.helper',
         '/usr/local/bin/horizon-worker-git-auth'],
        ['git', '--git-dir=' + str(GIT_DIR), 'config', 'remote.origin.url',
         'https://github.com/' + value['repository'] + '.git'],
    ]
    for command in commands:
        subprocess.run(command, env=env, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    CREDENTIAL.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if CREDENTIAL.parent.stat().st_mode & 0o077:
        raise ValueError('Git credential directory must be private')
    fd, temporary = tempfile.mkstemp(prefix='.github-', dir=CREDENTIAL.parent)
    try:
        with os.fdopen(fd, 'w') as output:
            if os.fstat(output.fileno()).st_mode & 0o077:
                raise ValueError('Git credential storage does not preserve private permissions')
            json.dump(value, output)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, CREDENTIAL)
    finally:
        Path(temporary).unlink(missing_ok=True)


def credential_reply(value, request):
    """Only the bound HTTPS repository receives a Git credential response."""
    fields = dict(line.split('=', 1) for line in request.splitlines() if '=' in line)
    path = fields.get('path', '')
    if path.endswith('.git'):
        path = path[:-4]
    if (value and fields.get('protocol') == 'https' and fields.get('host') == 'github.com'
            and path.casefold() == value['repository'].casefold()):
        return 'username=x-access-token\npassword=' + value['token'] + '\n\n'
    return ''


def main():
    if Path(sys.argv[0]).name == 'gh':
        value = read_binding()
        env = dict(os.environ)
        if value:
            env['GH_TOKEN'] = value['token']
            env['GH_REPO'] = value['repository']
            env['GH_HOST'] = 'github.com'
        os.execve('/usr/bin/gh', ['/usr/bin/gh', *sys.argv[1:]], env)
        return
    operation = sys.argv[1] if len(sys.argv) > 1 else ''
    if operation == 'install':
        source = sys.stdin.read(4097)
        if len(source.encode()) > 4096:
            raise ValueError('Git binding is too large')
        install(json.loads(source))
    elif operation == 'clear':
        CREDENTIAL.unlink(missing_ok=True)
    elif operation == 'get':
        sys.stdout.write(credential_reply(read_binding(), sys.stdin.read(8192)))
    elif operation in ('store', 'erase'):
        pass  # Caller-managed binding: Git cannot overwrite it or remove it after a transient failure.
    elif operation == 'check':
        subprocess.run(['/usr/bin/gh', '--version'], check=True, stdout=subprocess.DEVNULL)
    else:
        raise ValueError('Unknown Git authentication operation')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, subprocess.SubprocessError):
        print('Worker Git authentication failed; inspect the private binding configuration.', file=sys.stderr)
        sys.exit(1)
