#!/usr/bin/python3
"""Private worker Git/gh binding. Token permissions remain the GitHub boundary."""
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile

CREDENTIAL = Path('/run/horizon-credentials/github.json')
GIT_DIR = Path('/workspace/repository.git')
SIBLINGS = Path('/workspace/siblings')
HOME = '/workspace/home'
FIELDS = {'repository', 'token', 'author_name', 'author_email'}
MAX_GRANTS = 16
# 16 maximal grants whose tokens and identities are all JSON escapes serialize to about 90 KB.
MAX_BYTES = 131072
ALIAS = re.compile(r'[a-z][a-z0-9_-]{0,63}')
GITHUB_URL = re.compile(r'https://github\.com/([A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}?)(?:\.git)?/?')
GITHUB_ARGUMENT = re.compile(r'(?:https?://)?(?:www\.)?github\.com/([^/?#\s]+/[^/?#\s]+?)(?:\.git)?(?:[/?#]|$)',
                             re.IGNORECASE)
SHORT_REPOSITORY = re.compile(r'-[A-Za-z]*?R(.*)', re.DOTALL)
API_REPOSITORY = re.compile(r'(?:https?://api\.github\.com)?/?repos/([^/?#\s]+/[^/?#\s]+?)(?:[/?#]|$)',
                            re.IGNORECASE)
# `gh repo` commands whose first positional argument is a repository, with the flags that take a
# separate value, so a flag value is never read as that repository.
POSITIONAL_REPOSITORY_COMMANDS = {
    'archive': (), 'delete': (), 'set-default': (), 'unarchive': (),
    'clone': ('-u', '--upstream-remote-name'),
    'create': ('-d', '--description', '-g', '--gitignore', '-h', '--homepage', '-l', '--license',
               '-p', '--template', '-r', '--remote', '-s', '--source', '-t', '--team'),
    'edit': ('--add-topic', '--default-branch', '-d', '--description', '-h', '--homepage',
             '--remove-topic', '--visibility'),
    'fork': ('--fork-name', '--org', '--remote-name'),
    'sync': ('-b', '--branch', '-s', '--source'),
    'view': ('-b', '--branch', '--json', '-q', '--jq', '-t', '--template'),
}
URL_HOST = re.compile(r'[A-Za-z][A-Za-z0-9+.-]*://([^/?#]*)')
GITHUB_HOSTS = ('github.com', 'www.github.com', 'api.github.com')
TOKEN_VARIABLES = ('GH_TOKEN', 'GITHUB_TOKEN', 'GH_ENTERPRISE_TOKEN', 'GITHUB_ENTERPRISE_TOKEN')


def validate(value):
    if not isinstance(value, dict) or set(value) != FIELDS:
        raise ValueError('Invalid Git binding')
    if not all(isinstance(item, str) for item in value.values()):
        raise ValueError('Invalid Git binding')
    parts = value['repository'].split('/')
    if len(parts) != 2 or any(not re.fullmatch(r'[A-Za-z0-9_.-]{1,100}', part)
                              or part in ('.', '..') for part in parts):
        raise ValueError('Invalid Git repository')
    token = value['token']
    if not token or len(token) > 2048 or any(ord(c) < 33 or ord(c) > 126 for c in token):
        raise ValueError('Invalid Git credential')
    for key in ('author_name', 'author_email'):
        item = value[key]
        if not item or len(item.encode()) > 200 or any(ord(c) < 32 or ord(c) == 127 for c in item):
            raise ValueError('Invalid Git identity')
    return value


def target_directory(target):
    """The bare repository a grant configures; SSH-safe aliases cannot escape the siblings root."""
    if target == 'primary':
        return GIT_DIR
    alias = target[len('sibling:'):] if isinstance(target, str) and target.startswith('sibling:') else ''
    if not ALIAS.fullmatch(alias):
        raise ValueError('Invalid Git grant target')
    return SIBLINGS / alias / 'repository.git'


def grants(value):
    """Normalize version 1 (one primary binding) and version 2 (per-repository grants)."""
    if not isinstance(value, dict):
        raise ValueError('Invalid Git binding')
    if 'version' not in value:
        return 1, [dict(validate(value), target='primary')]
    if set(value) != {'version', 'grants'} or type(value['version']) is not int or value['version'] != 2:
        raise ValueError('Unsupported Git binding version')
    entries = value['grants']
    if not isinstance(entries, list) or not 1 <= len(entries) <= MAX_GRANTS:
        raise ValueError('Invalid Git grant list')
    repositories, targets = set(), set()
    for entry in entries:
        if not isinstance(entry, dict) or set(entry) != FIELDS | {'target'}:
            raise ValueError('Invalid Git grant')
        validate({key: entry[key] for key in FIELDS})
        target_directory(entry['target'])
        repository = entry['repository'].casefold()
        if repository in repositories or entry['target'] in targets:
            raise ValueError('Duplicate Git grant')
        repositories.add(repository)
        targets.add(entry['target'])
    return 2, entries


def unique_keys(pairs):
    if len({key for key, _ in pairs}) != len(pairs):
        raise ValueError('Duplicate Git binding field')
    return dict(pairs)


def parse(source):
    return json.loads(source, object_pairs_hook=unique_keys)


def read_grants():
    """Return (version, grants) from the private file, or None when no binding exists."""
    try:
        fd = os.open(CREDENTIAL, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except FileNotFoundError:
        return None
    with os.fdopen(fd, 'rb') as source:
        status = os.fstat(source.fileno())
        if not stat.S_ISREG(status.st_mode) or status.st_mode & 0o077 or status.st_size > MAX_BYTES:
            raise ValueError('Git credential file must be private')
        data = source.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        raise ValueError('Git credential file must be private')
    return grants(parse(data.decode()))


def same_repository(requested, repository):
    """ASCII-only comparison: Unicode case folding would let another path match."""
    return requested.isascii() and requested.lower() == repository.lower()


def present(directory, target):
    """A real directory; a sibling's alias directory must not redirect it either."""
    links = [directory] if target == 'primary' else [directory, directory.parent]
    return directory.is_dir() and not any(path.is_symlink() for path in links)


def git(env, *args):
    subprocess.run(['git', *args], env=env, check=True, stdin=subprocess.DEVNULL,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def git_output(env, *args):
    result = subprocess.run(['git', *args], env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, text=True)
    return result.stdout.rstrip('\n') if result.returncode == 0 else None


def previous_grants():
    try:
        return read_grants()
    except ValueError:
        return None


def forget_identities(env, previous):
    """Drop the identities the previous install wrote while they are unchanged, so no stale
    global (version 1) or repository (version 2) identity overrides the new install's."""
    if not previous:
        return
    version, entries = previous
    for entry in entries:
        directory = target_directory(entry['target'])
        if version == 1:
            scope = ['config', '--global']
        elif present(directory, entry['target']):
            scope = ['--git-dir=' + str(directory), 'config', '--local']
        else:
            continue
        for key, field in (('user.name', 'author_name'), ('user.email', 'author_email')):
            if git_output(env, *scope, '--get', key) == entry[field]:
                git(env, *scope, '--unset-all', key)


def install(value):
    version, entries = grants(value)
    directories = [target_directory(entry['target']) for entry in entries]
    env = dict(os.environ, HOME=HOME)
    # Refuse before any configuration or token write when a target is absent or not a bare repository.
    if version == 2 and not (
            all(present(path, entry['target']) for path, entry in zip(directories, entries))
            and all(git_output(env, '--git-dir=' + str(path), 'rev-parse', '--is-bare-repository') == 'true'
                    for path in directories)):
        raise ValueError('Git grant target repository is missing')
    forget_identities(env, previous_grants())
    git(env, 'config', '--global', 'credential.https://github.com.useHttpPath', 'true')
    git(env, 'config', '--global', '--replace-all', 'credential.https://github.com.helper',
        '/usr/local/bin/horizon-worker-git-auth')
    for entry, directory in zip(entries, directories):
        # Version 1 keeps its global identity; version 2 scopes identity to each repository.
        config = ['config', '--global'] if version == 1 else ['--git-dir=' + str(directory), 'config']
        git(env, *config, 'user.name', entry['author_name'])
        git(env, *config, 'user.email', entry['author_email'])
        repository = ['--git-dir=' + str(directory), 'config']
        git(env, *repository, '--replace-all', 'remote.origin.url',
            'https://github.com/' + entry['repository'] + '.git')
        # A leftover push URL would take precedence and route pushes to another repository.
        if git_output(env, *repository, '--get-all', 'remote.origin.pushurl') is not None:
            git(env, *repository, '--unset-all', 'remote.origin.pushurl')
    write_private(value)


def write_private(value):
    CREDENTIAL.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if CREDENTIAL.parent.stat().st_mode & 0o077:
        raise ValueError('Git credential directory must be private')
    fd, temporary = tempfile.mkstemp(prefix='.github-', dir=CREDENTIAL.parent)
    try:
        with os.fdopen(fd, 'w') as output:
            if os.fstat(output.fileno()).st_mode & 0o077:
                raise ValueError('Git credential storage does not preserve private permissions')
            json.dump(value, output)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, CREDENTIAL)
    finally:
        Path(temporary).unlink(missing_ok=True)


def credential_reply(entries, request):
    """Only the exactly requested HTTPS repository receives its own Git credential."""
    fields = dict(line.split('=', 1) for line in request.splitlines() if '=' in line)
    path = fields.get('path', '')
    if path.endswith('.git'):
        path = path[:-4]
    if fields.get('protocol') != 'https' or fields.get('host') != 'github.com':
        return ''
    for entry in entries or ():
        if same_repository(path, entry['repository']):
            return 'username=x-access-token\npassword=' + entry['token'] + '\n\n'
    return ''


def repository_arguments(argv):
    """Explicit --repo/-R selections (including short-flag clusters) and the repositories other
    arguments imply: github.com URLs, `gh repo <command> OWNER/REPO` and
    `gh api repos/OWNER/REPO/...`. An argument that selects another host implies None.

    A selector right after a flag without an inline value, or after `--`, may be that flag's
    value or a positional argument rather than a real selector. It only implies a repository,
    so it can never redirect gh; it must agree with the repository chosen otherwise."""
    explicit, implied = [], []
    terminated = False
    for index, argument in enumerate(argv):
        following = argv[index + 1] if index + 1 < len(argv) else ''
        previous = argv[index - 1] if index else ''
        ambiguous = terminated or (previous.startswith('-') and '=' not in previous)
        terminated = terminated or argument == '--'
        selectors = implied if ambiguous else explicit
        short = None if argument.startswith('--') else SHORT_REPOSITORY.fullmatch(argument)
        url = GITHUB_ARGUMENT.match(argument)
        endpoint = API_REPOSITORY.match(argument) if argv[:1] == ['api'] else None
        if argument == '--repo':
            selectors.append(following)
        elif argument.startswith('--repo='):
            selectors.append(argument[len('--repo='):])
        elif short:
            selectors.append(short.group(1).removeprefix('=') or following)
        elif url:
            implied.append(url.group(1))
        elif endpoint:
            # gh fills {owner}/{repo} from GH_REPO, which always matches the injected token.
            if '{' not in endpoint.group(1):
                implied.append(endpoint.group(1))
        elif argument == '--hostname' or argument.startswith('--hostname='):
            host = following if argument == '--hostname' else argument[len('--hostname='):]
            if host.lower() not in GITHUB_HOSTS:
                implied.append(None)
        elif (other := URL_HOST.match(argument)) and other.group(1).lower() not in GITHUB_HOSTS:
            implied.append(None)
    positional = repository_positional(argv)
    if positional is not None and not GITHUB_ARGUMENT.match(positional):
        implied.append(positional)
    return explicit, implied


def repository_positional(argv):
    """The repository argument of `gh repo <command>`, skipping flags and their values."""
    if argv[:1] != ['repo'] or len(argv) < 2 or argv[1] not in POSITIONAL_REPOSITORY_COMMANDS:
        return None
    takes_value = POSITIONAL_REPOSITORY_COMMANDS[argv[1]] + ('-R', '--repo')
    arguments = iter(argv[2:])
    for argument in arguments:
        if argument == '--':
            return next(arguments, None)
        if argument in takes_value:
            next(arguments, None)
        elif not argument.startswith('-'):
            return argument
    return None


def repository_name(requested):
    if requested is None:
        return None
    parts = requested.split('/')
    if len(parts) == 3 and parts[0].lower() == 'github.com':
        parts = parts[1:]
    return '/'.join(parts) if len(parts) == 2 and requested.isascii() else None


def agreed(requests):
    names = [repository_name(requested) for requested in requests]
    if not names or None in names or len({name.lower() for name in names}) != 1:
        return None
    return names[0]


def origin_repository(env):
    try:
        origin = subprocess.run(['git', 'remote', 'get-url', 'origin'], env=env, stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    match = GITHUB_URL.fullmatch(origin.stdout.decode(errors='replace').strip())
    return match.group(1) if origin.returncode == 0 and match else None


def gh_repository(env, argv):
    """The repository a gh invocation targets: --repo/-R, else GH_REPO, else the working
    directory's origin, else what the arguments imply. Every implied repository must agree with
    that choice; conflicts, other hosts and unreadable selections resolve to no repository."""
    if env.get('GH_HOST', 'github.com').lower() != 'github.com':
        return None
    explicit, implied = repository_arguments(argv)
    if explicit:
        repository = agreed(explicit)
    elif env.get('GH_REPO') is not None:
        repository = agreed([env['GH_REPO']])
    else:
        repository = origin_repository(env) or agreed(implied[:1])
    if repository is None or (implied and agreed([repository, *implied]) is None):
        return None
    return repository


def gh_environment(loaded, env, argv=()):
    """Inject only the targeted repository's token; version 1 keeps its single-binding behavior."""
    env = dict(env)
    if not loaded:
        return env
    version, entries = loaded
    if version == 1:
        selected = entries[0]
    else:
        repository = gh_repository(env, list(argv))
        selected = next((entry for entry in entries if repository is not None
                         and same_repository(repository, entry['repository'])), None)
        if selected is None:
            # A nested gh can inherit a token an outer wrapped gh injected; never pass it on.
            tokens = {entry['token'] for entry in entries}
            for variable in TOKEN_VARIABLES:
                if env.get(variable) in tokens:
                    del env[variable]
            print('horizon: no Git grant for this repository; gh runs without Horizon credentials',
                  file=sys.stderr)
            return env
    env['GH_TOKEN'] = selected['token']
    env['GH_REPO'] = selected['repository']
    env['GH_HOST'] = 'github.com'
    return env


def main():
    if Path(sys.argv[0]).name == 'gh':
        env = gh_environment(read_grants(), os.environ, sys.argv[1:])
        os.execve('/usr/bin/gh', ['/usr/bin/gh', *sys.argv[1:]], env)
        return
    operation = sys.argv[1] if len(sys.argv) > 1 else ''
    if operation == 'install':
        source = sys.stdin.read(MAX_BYTES + 1)
        if len(source.encode()) > MAX_BYTES:
            raise ValueError('Git binding is too large')
        install(parse(source))
    elif operation == 'clear':
        CREDENTIAL.unlink(missing_ok=True)
    elif operation == 'get':
        loaded = read_grants()
        sys.stdout.write(credential_reply(loaded[1] if loaded else None, sys.stdin.read(8192)))
    elif operation in ('store', 'erase'):
        pass  # Caller-managed binding: Git cannot overwrite it or remove it after a transient failure.
    elif operation == 'check':
        subprocess.run(['/usr/bin/gh', '--version'], check=True, stdout=subprocess.DEVNULL)
    else:
        raise ValueError('Unknown Git authentication operation')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, RecursionError, subprocess.SubprocessError):
        print('Worker Git authentication failed; inspect the private binding configuration.', file=sys.stderr)
        sys.exit(1)
