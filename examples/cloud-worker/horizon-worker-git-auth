#!/usr/bin/python3
"""Private worker Git/gh binding. Token permissions remain the GitHub boundary."""
import contextlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import socket
import stat
import subprocess
import sys
import tempfile


def load_sibling(name, module):
    """A module beside this script, which runs from /usr/local/bin and as the gh symlink."""
    if module not in sys.modules:
        loader = importlib.machinery.SourceFileLoader(module, str(Path(__file__).resolve().with_name(name)))
        loaded = importlib.util.module_from_spec(importlib.util.spec_from_loader(module, loader))
        sys.modules[module] = loaded
        try:
            loader.exec_module(loaded)
        except BaseException:
            del sys.modules[module]
            raise
    return sys.modules[module]


# Which repository a gh invocation or a Git credential request targets.
targets = load_sibling('horizon-worker-gh-repository', 'horizon_worker_gh_repository')
gh_repository = targets.gh_repository
same_repository = targets.same_repository
credential_reply = targets.credential_reply


CREDENTIAL = Path('/run/horizon-credentials/github.json')
# Under agent isolation only root, the Git proxy and the API broker read the static token.
ROOT_CREDENTIAL = Path('/run/horizon-github/static-binding.json')
AGENT_ISOLATION = Path('/run/horizon-tailnet/agent-isolation')
AGENT_UID = 10001  # Every agent session's account (horizon-worker-tailnet isolate).
AGENT_RUNNER = ('/usr/local/bin/horizon-worker-tailnet', 'agent', '/usr/local/bin/horizon-worker-git-auth')
ROOT_OPERATIONS = ('install', 'clear')  # Run as root under agent isolation; the rest as the agent.
# horizon-worker-github, the root service that refreshes the token chain and answers agents.
SERVICE_SOCKET = Path('/run/horizon-worker/github.sock')
SERVICE_TIMEOUT = 10
# The service's Git proxy, which adds the token to requests for granted repositories, so Git
# never holds one. Git trusts the service's authority only for github.com.
PROXY_PORT = 47281
PROXY_AUTHORITY = '/run/horizon-worker/github-ca.pem'
# The service's API broker. While the service runs, gh sends every request to this socket
# (`http_unix_socket`) with a placeholder token; the broker adds the token that a grant covers.
API_SOCKET = '/run/horizon-worker/github-api.sock'
GH = '/usr/bin/gh'
GITHUB = 'https://github.com/'
ROUTE = (('http.' + GITHUB + '.proxy', 'http://127.0.0.1:%d' % PROXY_PORT),
         ('http.' + GITHUB + '.sslCAInfo', PROXY_AUTHORITY))
# Other ways to write a GitHub remote go over HTTPS through the proxy (no SSH key on the worker).
REWRITTEN = ('git@github.com:', 'ssh://git@github.com/', 'http://github.com/', 'https://www.github.com/',
             'http://www.github.com/')
# The route's own file under HOME, which the global configuration includes; the agent's entries stay.
ROUTE_FILE = '.config/git/horizon-route'
# Set by the gh wrapper when it injects a service token, so a nested gh can drop it.
INJECTED = 'HORIZON_GH_TOKEN_INJECTED'
# What gh holds while the GitHub service's API broker adds the token.
PLACEHOLDER = 'horizon-api-broker'
GIT_DIR = Path('/workspace/repository.git')
SIBLINGS = Path('/workspace/siblings')
HOME = '/workspace/home'
FIELDS = {'repository', 'token', 'author_name', 'author_email'}
IDENTITY_FIELDS = FIELDS - {'token'}
MAX_GRANTS = 16
# 16 maximal grants whose tokens and identities are all JSON escapes serialize to about 90 KB.
MAX_BYTES = 131072
ALIAS = re.compile(r'[a-z][a-z0-9_-]{0,63}')
TOKEN_VARIABLES = ('GH_TOKEN', 'GITHUB_TOKEN', 'GH_ENTERPRISE_TOKEN', 'GITHUB_ENTERPRISE_TOKEN')


def valid_repository(repository):
    parts = repository.split('/') if isinstance(repository, str) else []
    return len(parts) == 2 and all(re.fullmatch(r'[A-Za-z0-9_.-]{1,100}', part) and part not in ('.', '..')
                                   for part in parts)


def valid_token(token):
    return isinstance(token, str) and 0 < len(token) <= 2048 and all(33 <= ord(c) <= 126 for c in token)


def valid_identity(item):
    return (isinstance(item, str) and 0 < len(item.encode()) <= 200
            and not any(ord(c) < 32 or ord(c) == 127 for c in item))


def validate(value, fields=FIELDS):
    if not isinstance(value, dict) or set(value) != fields:
        raise ValueError('Invalid Git binding')
    if not all(isinstance(item, str) for item in value.values()):
        raise ValueError('Invalid Git binding')
    if not valid_repository(value['repository']):
        raise ValueError('Invalid Git repository')
    if 'token' in fields and not valid_token(value['token']):
        raise ValueError('Invalid Git credential')
    if not (valid_identity(value['author_name']) and valid_identity(value['author_email'])):
        raise ValueError('Invalid Git identity')
    return value


def target_directory(target):
    """The bare repository a grant configures; SSH-safe aliases cannot escape the siblings root."""
    if target == 'primary':
        return GIT_DIR
    alias = target[len('sibling:'):] if isinstance(target, str) and target.startswith('sibling:') else ''
    if not ALIAS.fullmatch(alias):
        raise ValueError('Invalid Git grant target')
    return SIBLINGS / alias / 'repository.git'


def grants(value):
    """Normalize version 1 (one primary binding) and version 2 (per-repository grants)."""
    if not isinstance(value, dict):
        raise ValueError('Invalid Git binding')
    if 'version' not in value:
        return 1, [dict(validate(value), target='primary')]
    if set(value) != {'version', 'grants'} or type(value['version']) is not int or value['version'] != 2:
        raise ValueError('Unsupported Git binding version')
    return 2, checked_grants(value['grants'])


def checked_grants(entries, fields=FIELDS, minimum=1):
    """Grants with `fields` and a target; their repositories and targets are unique."""
    if not isinstance(entries, list) or not minimum <= len(entries) <= MAX_GRANTS:
        raise ValueError('Invalid Git grant list')
    repositories, targets = set(), set()
    for entry in entries:
        if not isinstance(entry, dict) or set(entry) != fields | {'target'}:
            raise ValueError('Invalid Git grant')
        validate({key: entry[key] for key in fields}, fields)
        target_directory(entry['target'])
        repository = entry['repository'].casefold()
        if repository in repositories or entry['target'] in targets:
            raise ValueError('Duplicate Git grant')
        repositories.add(repository)
        targets.add(entry['target'])
    return entries


def unique_keys(pairs):
    if len({key for key, _ in pairs}) != len(pairs):
        raise ValueError('Duplicate Git binding field')
    return dict(pairs)


def parse(source):
    return json.loads(source, object_pairs_hook=unique_keys)


def root_holds_token():
    """Whether this process is root under agent isolation, which keeps the token from agents."""
    return os.geteuid() == 0 and AGENT_ISOLATION.exists()


def token_path():
    return ROOT_CREDENTIAL if root_holds_token() else CREDENTIAL


def identity_path():
    return CREDENTIAL.with_name('github-identity.json')


def read_private(path, owner=None):
    """The JSON of a private regular file that `owner` (this account by default) owns, or None
    without one."""
    try:
        # Nonblocking: the Git proxy reads it as root, and a FIFO must not stop it.
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK)
    except FileNotFoundError:
        return None
    with os.fdopen(fd, 'rb') as source:
        status = os.fstat(source.fileno())
        if not stat.S_ISREG(status.st_mode) or status.st_mode & 0o077 or status.st_size > MAX_BYTES \
                or status.st_uid != (os.geteuid() if owner is None else owner):
            raise ValueError('Git credential file must be private')
        data = source.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        raise ValueError('Git credential file must be private')
    return parse(data.decode())


def read_grants():
    """Return (version, grants) with their tokens, or None when no binding exists. Under agent
    isolation only root reads them."""
    value = read_private(token_path())
    return None if value is None else grants(value)


def stripped(value):
    """A binding without its tokens: what agents keep to configure Git identities."""
    version, entries = grants(value)
    if version == 1:
        return {key: value[key] for key in IDENTITY_FIELDS}
    return {'version': 2, 'grants': [{key: entry[key] for key in IDENTITY_FIELDS | {'target'}}
                                     for entry in entries]}


def identity_grants(value):
    """(version, grants) of a binding without tokens."""
    if isinstance(value, dict) and 'version' not in value:
        return 1, [dict(validate(value, IDENTITY_FIELDS), target='primary')]
    if not isinstance(value, dict) or set(value) != {'version', 'grants'} or value['version'] != 2 \
            or type(value['version']) is not int:
        raise ValueError('Unsupported Git binding version')
    return 2, checked_grants(value['grants'], IDENTITY_FIELDS)


def present(directory, target):
    """A real directory; a sibling's alias directory must not redirect it either."""
    links = [directory] if target == 'primary' else [directory, directory.parent]
    return directory.is_dir() and not any(path.is_symlink() for path in links)


def git(env, *args):
    subprocess.run(['git', *args], env=env, check=True, stdin=subprocess.DEVNULL,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def git_output(env, *args):
    result = subprocess.run(['git', *args], env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, text=True)
    return result.stdout.rstrip('\n') if result.returncode == 0 else None


def previous_grants():
    """The identities of the binding in place; under agent isolation never from a token file."""
    try:
        value = read_private(identity_path())
        if value is not None:
            return identity_grants(value)
        return None if AGENT_ISOLATION.exists() else read_grants()
    except ValueError:
        return None


def forget_identities(env, previous):
    """Drop the identities the previous install wrote while they are unchanged, so no stale
    global (version 1) or repository (version 2) identity overrides the new install's."""
    if not previous:
        return
    version, entries = previous
    for entry in entries:
        directory = target_directory(entry['target'])
        if version == 1:
            scope = ['config', '--global']
        elif present(directory, entry['target']):
            scope = ['--git-dir=' + str(directory), 'config', '--local']
        else:
            continue
        for key, field in (('user.name', 'author_name'), ('user.email', 'author_email')):
            if git_output(env, *scope, '--get', key) == entry[field]:
                git(env, *scope, '--unset-all', key)


def install(value):
    """The static binding: Git's identities and the token, in one account's files."""
    install_identities(stripped(value))
    write_private(value, token_path())


def install_identities(value, previous=None):
    """Git's configuration for a binding without tokens, replacing the earlier identities."""
    version, entries = identity_grants(value)
    configure(version, entries, [previous_grants(), identity_grants(previous) if previous else None])
    write_private(value, identity_path())


def empty_earlier():
    """Empties the agents' own token file of an earlier image in place, with its hard links."""
    with contextlib.suppress(OSError), open(os.open(CREDENTIAL, os.O_WRONLY | os.O_NOFOLLOW | os.O_NONBLOCK
                                                    | os.O_CLOEXEC), 'wb', closefd=True) as legacy:
        found = os.fstat(legacy.fileno())
        if stat.S_ISREG(found.st_mode) and found.st_uid == AGENT_UID:
            legacy.truncate(0)


def install_as_root(value, agent=None):
    """Under agent isolation the agent keeps the identities and root the token. An earlier
    image's token file is emptied in place (with its hard links) and removed first."""
    grants(value)
    earlier = previous = None
    with contextlib.suppress(ValueError, OSError, RecursionError, UnicodeDecodeError):
        found = read_private(CREDENTIAL, owner=AGENT_UID)
        earlier, previous = found, stripped(found)
    empty_earlier()
    # Any failure but a directory there stops the install before the agent step.
    with contextlib.suppress(IsADirectoryError):
        CREDENTIAL.unlink(missing_ok=True)
    agent = agent or (lambda operation, data: subprocess.run(
        [*AGENT_RUNNER, operation], input=json.dumps(data).encode(), check=True, cwd='/workspace',
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120))
    kept = None
    with contextlib.suppress(ValueError, OSError, RecursionError, UnicodeDecodeError):
        kept = read_private(ROOT_CREDENTIAL) or earlier
    try:
        agent('install-identity', {'binding': stripped(value), 'previous': previous})
        write_private(value, ROOT_CREDENTIAL)
    except BaseException:
        # Back to one binding (root-only, else earlier), also after a partial agent step.
        if kept is not None and kept is earlier and not ROOT_CREDENTIAL.exists():
            with contextlib.suppress(ValueError, OSError):
                write_private(earlier, ROOT_CREDENTIAL)
        try:
            if kept is not None:
                agent('install-identity', {'binding': stripped(kept), 'previous': stripped(value)})
        except (ValueError, OSError, subprocess.SubprocessError):
            print('horizon: the identities of the earlier static binding could not be restored', file=sys.stderr)
        raise


def clear():
    """Removes the static binding: its token wherever it is (the root-only one first, in every
    mode, so no agent's path can keep it), and its identities."""
    with contextlib.suppress(PermissionError):
        ROOT_CREDENTIAL.unlink(missing_ok=True)
    if root_holds_token():
        empty_earlier()
    for path in (CREDENTIAL, identity_path()):
        with contextlib.suppress(IsADirectoryError, PermissionError):
            path.unlink(missing_ok=True)


def configure(version, entries, previous):
    """Point each target repository at a clean HTTPS origin with its grant's identity, after
    removing the identities that each install in `previous` wrote."""
    directories = [target_directory(entry['target']) for entry in entries]
    env = dict(os.environ, HOME=HOME)
    # Refuse before any configuration or token write when a target is absent or not a bare repository.
    if version == 2 and not (
            all(present(path, entry['target']) for path, entry in zip(directories, entries))
            and all(git_output(env, '--git-dir=' + str(path), 'rev-parse', '--is-bare-repository') == 'true'
                    for path in directories)):
        raise ValueError('Git grant target repository is missing')
    for earlier in previous:
        forget_identities(env, earlier)
    git(env, 'config', '--global', 'credential.https://github.com.useHttpPath', 'true')
    git(env, 'config', '--global', '--replace-all', 'credential.https://github.com.helper',
        '/usr/local/bin/horizon-worker-git-auth')
    for entry, directory in zip(entries, directories):
        # Version 1 keeps its global identity; version 2 scopes identity to each repository.
        config = ['config', '--global'] if version == 1 else ['--git-dir=' + str(directory), 'config']
        git(env, *config, 'user.name', entry['author_name'])
        git(env, *config, 'user.email', entry['author_email'])
        repository = ['--git-dir=' + str(directory), 'config']
        git(env, *repository, '--replace-all', 'remote.origin.url',
            'https://github.com/' + entry['repository'] + '.git')
        # A leftover push URL would take precedence and route pushes to another repository.
        if git_output(env, *repository, '--get-all', 'remote.origin.pushurl') is not None:
            git(env, *repository, '--unset-all', 'remote.origin.pushurl')


def route(env, proxy):
    """Sends Git's github.com requests through the service's proxy, or stops doing so. The
    values are in ROUTE_FILE, which the global configuration includes once; removing the route
    removes only that include and the file. The remote URLs stay github.com URLs, so gh still
    finds the repository of a checkout."""
    path = Path(env['HOME']) / ROUTE_FILE
    included = git_output(env, 'config', '--global', '--fixed-value', '--get-all', 'include.path', str(path))
    if not proxy:
        if included is not None:
            git(env, 'config', '--global', '--fixed-value', '--unset-all', 'include.path', str(path))
        path.unlink(missing_ok=True)
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix='.horizon-route-', dir=path.parent)
    os.close(fd)
    try:
        for key, value in ROUTE + tuple(('url.' + GITHUB + '.insteadOf', form) for form in REWRITTEN):
            git(env, 'config', '--file', temporary, '--add', key, value)
        os.chmod(temporary, 0o644)
        os.replace(temporary, path)
    except BaseException:
        Path(temporary).unlink(missing_ok=True)
        raise
    if included is None:
        git(env, 'config', '--global', '--add', 'include.path', str(path))


def gh_config(env, *args):
    """gh's own configuration command, for the configuration under HOME that agents' gh reads."""
    env = {key: value for key, value in env.items() if key not in ('GH_CONFIG_DIR', 'XDG_CONFIG_HOME')}
    return subprocess.run([GH, 'config', *args], env=env, check=True, stdin=subprocess.DEVNULL,
                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=30).stdout.strip()


def route_gh(env, broker):
    """Sends gh's requests to the service's API broker, or stops doing so. Only the value this
    helper writes is removed."""
    current = gh_config(env, 'get', 'http_unix_socket')
    if broker and current != API_SOCKET:
        gh_config(env, 'set', 'http_unix_socket', API_SOCKET)
    elif not broker and current == API_SOCKET:
        gh_config(env, 'set', 'http_unix_socket', '')


def configure_chain(value):
    """Git configuration for a horizon-worker-github chain; no token reaches this helper. The
    service sends its grants with their identity and the grants of the chain it replaces."""
    if not isinstance(value, dict) or set(value) != {'grants', 'previous'}:
        raise ValueError('Invalid Git configuration')
    entries = checked_grants(value['grants'], IDENTITY_FIELDS)
    previous = checked_grants(value['previous'], IDENTITY_FIELDS, minimum=0)
    configure(2, entries, [previous_grants(), (2, previous)])
    # The static binding stays until horizon-worker-github removes it with `clear`.


def restore_static(value):
    """After a failed first chain install: the static binding's configuration again."""
    if not isinstance(value, dict) or set(value) != {'previous'}:
        raise ValueError('Invalid Git configuration')
    failed = (2, checked_grants(value['previous'], IDENTITY_FIELDS, minimum=0))
    loaded = previous_grants()
    if loaded:
        configure(loaded[0], loaded[1], [failed])
    else:
        forget_identities(dict(os.environ, HOME=HOME), failed)


def private_folder(path):
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    folder = path.lstat()
    if not stat.S_ISDIR(folder.st_mode) or folder.st_mode & 0o077 or folder.st_uid != os.geteuid():
        raise ValueError('Git credential directory must be private')


def write_private(value, path):
    private_folder(path.parent)
    fd, temporary = tempfile.mkstemp(prefix='.github-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as output:
            if os.fstat(output.fileno()).st_mode & 0o077:
                raise ValueError('Git credential storage does not preserve private permissions')
            json.dump(value, output)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def gh_environment(loaded, env, argv=()):
    """Inject only the targeted repository's token; version 1 keeps its single-binding behavior."""
    env = dict(env)
    if not loaded:
        return env
    version, entries = loaded
    if version == 1:
        selected = entries[0]
    else:
        repository = gh_repository(env, list(argv))
        selected = next((entry for entry in entries if repository is not None
                         and same_repository(repository, entry['repository'])), None)
        if selected is None:
            # A nested gh can inherit a token an outer wrapped gh injected; never pass it on.
            tokens = {entry['token'] for entry in entries}
            for variable in TOKEN_VARIABLES:
                if env.get(variable) in tokens:
                    del env[variable]
            print('horizon: no Git grant for this repository; gh runs without Horizon credentials',
                  file=sys.stderr)
            return env
    env['GH_TOKEN'] = selected['token']
    env['GH_REPO'] = selected['repository']
    env['GH_HOST'] = 'github.com'
    return env


def call_service(request, path=None):
    """The chain service's reply as an object, or None when no service answers."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(SERVICE_TIMEOUT)
            connection.connect(str(path or SERVICE_SOCKET))
            connection.sendall((json.dumps(request) + '\n').encode())
            with connection.makefile('rb') as stream:
                reply = json.loads(stream.readline(65536))
    except (OSError, ValueError):
        return None
    return reply if isinstance(reply, dict) else None


def ask_service(request):
    """The chain service's reply, or None when no service answers or it holds no chain, so
    the caller falls back to the private file."""
    reply = call_service(request)
    return None if reply is None or reply.get('state') == 'absent' else reply


def service_credential(request, ask=call_service):
    """'' while the chain service answers: Git then goes through its proxy, which adds the token
    of the chain or of the static binding itself, so Git gets no credential. None when no
    service answers; the caller then falls back to the private file."""
    fields = dict(line.split('=', 1) for line in request.splitlines() if '=' in line)
    reply = ask({'request': 'credential', **{key: fields.get(key, '') for key in ('protocol', 'host', 'path')}})
    return None if reply is None else ''


def service_environment(env, argv, ask=call_service):
    """gh's environment with the service's answer for the targeted repository, or None when no
    service answers. Without a chain the broker serves the static binding, so gh never gets the
    static token. A refusal drops a token that an outer wrapped gh injected, and gives gh the
    placeholder unless the caller set a token, so the API broker answers with its reason."""
    reply = ask({'request': 'gh-token', 'repository': gh_repository(env, list(argv)) or ''})
    if reply is None:
        return None
    # gh reads the routed configuration, whatever HOME, XDG_CONFIG_HOME or GH_CONFIG_DIR says.
    env = dict(env, GH_CONFIG_DIR=str(Path(HOME) / '.config/gh'))
    if (reply.get('ok') is True and valid_token(reply.get('token'))
            and valid_repository(reply.get('repository'))):
        env.update({'GH_TOKEN': reply['token'], 'GH_REPO': reply['repository'], 'GH_HOST': 'github.com',
                    INJECTED: '1'})
        return env
    # The broker refuses the request with its reason, which gh prints; gh needs a token to send it.
    env = without_injected(env)
    if not any(env.get(variable) for variable in TOKEN_VARIABLES):
        env.update({'GH_TOKEN': PLACEHOLDER, INJECTED: '1'})
    return env


def without_injected(env):
    """The environment without the GH_TOKEN that an outer wrapped gh took from the chain
    service; every other token variable belongs to the caller and stays."""
    env = dict(env)
    if env.pop(INJECTED, None) is not None:
        env.pop('GH_TOKEN', None)
    return env


def read_input():
    source = sys.stdin.read(MAX_BYTES + 1)
    if len(source.encode()) > MAX_BYTES:
        raise ValueError('Git binding is too large')
    return source


def main():
    if Path(sys.argv[0]).name == 'gh':
        env = service_environment(os.environ, sys.argv[1:])
        if env is None:
            # The service does not answer: a token an outer gh took from it must not outlive it.
            env = gh_environment(read_grants(), without_injected(os.environ), sys.argv[1:])
            if AGENT_ISOLATION.exists():
                # The broker's route, once a service sets it again, is in this configuration.
                env['GH_CONFIG_DIR'] = str(Path(HOME) / '.config/gh')
        os.execve('/usr/bin/gh', ['/usr/bin/gh', *sys.argv[1:]], env)
        return
    operation = sys.argv[1] if len(sys.argv) > 1 else ''
    if operation == 'install':
        (install_as_root if root_holds_token() else install)(parse(read_input()))
    elif operation == 'install-identity':
        value = parse(read_input())
        if not isinstance(value, dict) or set(value) != {'binding', 'previous'}:
            raise ValueError('Invalid Git configuration')
        install_identities(value['binding'], value['previous'])
    elif operation == 'configure':
        configure_chain(parse(read_input()))
    elif operation == 'restore':
        restore_static(parse(read_input()))
    elif operation == 'clear':
        clear()
    elif operation in ('route', 'unroute'):
        # The service routes Git through its proxy and gh through its broker once they listen;
        # the worker's start and the end of the service route both to GitHub directly again.
        route(dict(os.environ, HOME=HOME), proxy=operation == 'route')
        route_gh(dict(os.environ, HOME=HOME), broker=operation == 'route')
    elif operation == 'get':
        request = sys.stdin.read(8192)
        reply = service_credential(request)
        if reply is None:
            loaded = read_grants()
            reply = credential_reply(loaded[1] if loaded else None, request)
        sys.stdout.write(reply)
    elif operation in ('store', 'erase'):
        pass  # Caller-managed binding: Git cannot overwrite it or remove it after a transient failure.
    elif operation == 'check':
        subprocess.run(['/usr/bin/gh', '--version'], check=True, stdout=subprocess.DEVNULL)
    else:
        raise ValueError('Unknown Git authentication operation')


if __name__ == '__main__':
    # The agents own their Git files, so root runs this helper as the agent, except for the
    # token that root keeps (ROOT_OPERATIONS). horizon-worker-github imports it as root.
    if root_holds_token() and not (Path(sys.argv[0]).name != 'gh' and sys.argv[1:2]
                                   and sys.argv[1] in ROOT_OPERATIONS):
        os.chdir('/workspace')
        os.execv(AGENT_RUNNER[0], ['horizon-worker-tailnet', *AGENT_RUNNER[1:], *sys.argv[1:]])
    try:
        main()
    except (ValueError, OSError, RecursionError, subprocess.SubprocessError):
        print('Worker Git authentication failed; inspect the private binding configuration.', file=sys.stderr)
        sys.exit(1)
