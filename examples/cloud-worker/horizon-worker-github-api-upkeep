"""The Upkeep checks of the worker's API broker (horizon-worker-github-api): the policy's
refusals, the list of workflows, the approvals of reviews and the merge gate. A mixin of the
broker's Exchange, which provides `broker`, `record` and `output`. A module that
horizon-worker-github loads, not a command."""
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import re
import sys
import urllib.parse


def load_common():
    name = 'horizon_worker_github_common'
    if name not in sys.modules:
        loader = importlib.machinery.SourceFileLoader(
            name, str(Path(__file__).resolve().with_name('horizon-worker-github-common')))
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
        sys.modules[name] = module
        loader.exec_module(module)
    return sys.modules[name]


common = load_common()
relay = common.load_sibling('horizon-worker-github-http', 'horizon_worker_github_http')
rest = common.load_sibling('horizon-worker-github-api-rest', 'horizon_worker_github_api_rest')
upkeep = common.load_sibling('horizon-worker-github-upkeep', 'horizon_worker_github_upkeep')
policy = rest.policy

PREFIX = 'Horizon: '
# A review is read in full to find its event, a dispatch to find its ref, and a merge to find
# its head.
MAX_REVIEW = 1 << 20
MAX_DISPATCH = 65536
# A file change is read in full to find its branch.
MAX_CONTENTS = 32 << 20
MAX_MERGE = 65536
# Which pull request a GraphQL merge names.
MERGED_PULL = 'query($id: ID!) { node(id: $id) { __typename ... on PullRequest { number repository { nameWithOwner } } } }'
# The gate: what GitHub must report, and how many pages of 100 it reads of a list.
CLEAN = {'clean', 'has_hooks'}
GOOD_CONCLUSIONS = {'success', 'neutral', 'skipped'}
MAX_PAGES = 30
# The account of Upkeep's own pull requests marks their branches so.
OWN_BRANCH = 'upkeep/'
HEAD = re.compile(r'[0-9a-f]{40}')
MERGE = re.compile(r'/pulls/(?P<number>[1-9][0-9]{0,9})/merge')
# The line of the person's approval that also lets a workflow change through.
ALLOW_WORKFLOWS = re.compile(r'(?mi)^[ \t]*upkeep-allow:[ \t]*workflows[ \t]*$')


def refusal(status, message):
    return relay.Refusal(status, PREFIX + message)


def unique(pairs):
    """A JSON object whose fields each come once; ValueError otherwise."""
    found = dict(pairs)
    if len(found) != len(pairs):
        raise ValueError('a field comes twice')
    return found


def merge_number(parts, method):
    """The pull request number of a REST merge, or None for a request that is not one. A PUT
    on a pull request path that names `merge` in any other form is refused, so no spelling
    of a merge goes around the gate."""
    if method != 'PUT' or not parts or parts[0] != 'pulls' or 'merge' not in parts:
        return None
    match = MERGE.fullmatch('/' + '/'.join(parts))
    if match is None:
        raise upkeep.Refused('this Upkeep merges only through /pulls/<number>/merge.')
    return int(match['number'])


def pages(call, path, key=None):
    """Every item of a paged GitHub list, at most MAX_PAGES pages of 100."""
    items = []
    for page in range(1, MAX_PAGES + 1):
        status, reply = call('GET', '%s?per_page=100&page=%d' % (path, page))
        found = reply.get(key) if key and isinstance(reply, dict) else reply
        if status != 200 or not isinstance(found, list):
            raise upkeep.Refused('GitHub did not answer %s; try again.' % path)
        items.extend(found)
        if len(found) < 100:
            return items
    raise upkeep.Refused('%s has too many entries for the gate to check.' % path)


def login_of(value):
    login = value.get('login') if isinstance(value, dict) else None
    return login.lower() if isinstance(login, str) else None


def gate(rules, call, repository, number, head):
    """`check`, with each reason in the words of every refusal of the policy, which the agent
    knows not to work around."""
    try:
        check(rules, call, repository, number, head)
    except upkeep.Refused as refused:
        reason = str(refused)
        raise upkeep.Refused(reason if reason.startswith('this Upkeep') else
                             'this Upkeep does not merge #%d yet: %s' % (number, reason)) from None


def bot_commit(rules, commit):
    """Whether `commit`, an item of GitHub's commit list, is the work of a listed bot: the bot
    wrote it, and GitHub or the bot committed it with a signature that GitHub verified."""
    verification = (commit.get('commit') or {}).get('verification') or {}
    committer = login_of(commit.get('committer'))
    return (login_of(commit.get('author')) in rules.bots and (committer == 'web-flow' or committer in rules.bots)
            and verification.get('verified') is True)


def workflows_changed_by_others(rules, call, base, head, pull):
    """Whether a file under .github/workflows changes between the pull request's base commit
    and `head`, and not every commit between them is a listed bot's: an agent may push to a
    bot's branch, and the author check sees only who opened it. Both are read by commit, so a
    push meanwhile changes nothing here. A comparison that GitHub cuts short (300 files, 250
    commits) counts as changed by others."""
    since = (pull.get('base') or {}).get('sha')
    if not isinstance(since, str) or not HEAD.fullmatch(since):
        raise upkeep.Refused('GitHub did not show the base commit of the pull request; try again.')
    files, commits, total = None, [], None
    for page in range(1, MAX_PAGES + 1):
        status, reply = call('GET', '%s/compare/%s...%s?per_page=100&page=%d' % (base, since, head, page))
        found = reply.get('commits') if status == 200 and isinstance(reply, dict) else None
        if not isinstance(found, list):
            raise upkeep.Refused('GitHub did not compare the pull request with its base; try again.')
        if files is None:
            files, total = reply.get('files'), reply.get('total_commits')
        commits.extend(found)
        if len(found) < 100:
            break
    if not isinstance(files, list) or len(files) >= 300:
        return True
    if not any(isinstance(item, dict) and any(str(item.get(key) or '').startswith(upkeep.WORKFLOWS)
                                              for key in ('filename', 'previous_filename')) for item in files):
        return False
    return (not commits or total != len(commits)
            or not all(isinstance(commit, dict) and bot_commit(rules, commit) for commit in commits))


def check(rules, call, repository, number, head):
    """Refuses the merge of pull request `number` of `repository` unless GitHub shows all of
    these. Hard checks, which nothing lifts: the merge names `head`, which is the head of an
    open pull request that is not a draft; GitHub reports it ready to merge; every check run
    and status on the head passed. Blockers, which the person's approval of `head` lifts:
    `author` (neither a listed bot nor the account's own `upkeep/` branch opened it),
    `no-checks` (the head has no checks) and `workflows` (a workflow file changes in a commit
    that is not a listed bot's). An approval is the latest review of the signed-in account,
    APPROVED, on `head`; for `workflows` its body also has the line `upkeep-allow: workflows`.
    The policy refuses every approval of an agent, so only the person writes one. `call(method, path)` asks GitHub with the cloud's token."""
    base = '/repos/%s' % repository
    if not isinstance(head, str) or not HEAD.fullmatch(head):
        raise upkeep.Refused('this Upkeep merges only the head commit that the merge names: use '
                             'gh pr merge --match-head-commit <head>.')
    status, pull = call('GET', '%s/pulls/%d' % (base, number))
    if status != 200 or not isinstance(pull, dict):
        raise upkeep.Refused('GitHub did not show pull request #%d of %s; try again.' % (number, repository))
    found = (pull.get('head') or {}).get('sha')
    if found != head:
        raise upkeep.Refused('the head of #%d is %s, not the commit that the merge names.' % (number, str(found)[:12]))
    if pull.get('state') != 'open' or pull.get('draft'):
        raise upkeep.Refused('#%d is not an open pull request that is ready for review.' % number)
    if pull.get('mergeable_state') not in CLEAN:
        raise upkeep.Refused('GitHub reports #%d as %s, not ready to merge: a required check or review is '
                             'missing, or the branch is behind or in conflict.' % (number, pull.get('mergeable_state')))
    runs = pages(call, '%s/commits/%s/check-runs' % (base, head), 'check_runs')
    for run in runs:
        if not isinstance(run, dict) or run.get('status') != 'completed' or run.get('conclusion') not in GOOD_CONCLUSIONS:
            raise upkeep.Refused('the check %s on the head of #%d did not pass.'
                                 % (run.get('name') if isinstance(run, dict) else '?', number))
    status, combined = call('GET', '%s/commits/%s/status' % (base, head))
    if status != 200 or not isinstance(combined, dict) or not isinstance(combined.get('statuses'), list):
        raise upkeep.Refused('GitHub did not show the commit statuses of #%d; try again.' % number)
    if combined['statuses'] and combined.get('state') != 'success':
        raise upkeep.Refused('the commit statuses on the head of #%d did not all pass.' % number)
    status, user = call('GET', '/user')
    login = login_of(user) if status == 200 else None
    if login is None:
        raise upkeep.Refused('GitHub did not say which account this worker works as; try again.')
    blockers = []
    author = login_of(pull.get('user'))
    head_repository = ((pull.get('head') or {}).get('repo') or {}).get('full_name')
    own = (author == login and str((pull.get('head') or {}).get('ref')).startswith(OWN_BRANCH)
           and isinstance(head_repository, str) and head_repository.lower() == repository.lower())
    if author not in rules.bots and not own:
        blockers.append('author')
    if not runs and not combined['statuses']:
        blockers.append('no-checks')
    if workflows_changed_by_others(rules, call, base, head, pull):
        blockers.append('workflows')
    if not blockers:
        return
    # As on GitHub, the person's latest approval or change request counts, not an earlier one.
    latest = None
    for review in pages(call, '%s/pulls/%d/reviews' % (base, number)):
        if isinstance(review, dict) and login_of(review.get('user')) == login \
                and review.get('state') in ('APPROVED', 'CHANGES_REQUESTED', 'DISMISSED'):
            latest = review
    lifted = set()
    if latest is not None and latest.get('state') == 'APPROVED' and latest.get('commit_id') == head:
        lifted = {'author', 'no-checks'}
        if ALLOW_WORKFLOWS.search(str(latest.get('body') or '')):
            lifted.add('workflows')
    blockers = [blocker for blocker in blockers if blocker not in lifted]
    if not blockers:
        return
    ask = 'Approve with the line upkeep-allow: workflows' if 'workflows' in blockers else 'Approve to merge'
    if author == login:
        ask = 'merge it yourself, because GitHub does not let an account approve its own pull request'
    raise upkeep.Refused('#%d is blocked on %s. For the person: %s (head %s).'
                         % (number, ', '.join(blockers), ask, head[:12]))


class Checks:
    """The broker's checks for a cloud with an Upkeep policy."""

    def upkeep_refused(self, kind, repository, reason):
        """Logs a refusal of the Upkeep policy for the board and refuses the request."""
        self.broker.log.refused(kind, repository, reason)
        raise refusal(403, reason)

    def upkeep_body(self, request, repository, kind, limit):
        """(JSON, bytes) of a request body that the broker reads before the request goes; the
        bytes are then sent as read. GitHub reads only that body, so there is no query."""
        if '?' in request.target:
            self.upkeep_refused(kind, repository, 'this Upkeep reads this request only from its body, '
                                                  'so it has no query.')
        relay.continue_if_asked(request, self.output)
        data = relay.read_body(request, limit)
        try:
            # A repeated field could mean one thing here and another on GitHub.
            return (json.loads(data, object_pairs_hook=unique) if data else {}), data
        except (ValueError, RecursionError):
            self.upkeep_refused(kind, repository, 'this Upkeep reads this request only as JSON with each field once.')

    def upkeep_dispatch(self, rules, request, route, candidate, repository):
        """Refuses a workflow dispatch of a workflow that the person did not list, and one on
        another ref than the default branch, where an agent can push a changed workflow.
        Returns the body of a dispatch, which is then sent as read, or None."""
        workflow = upkeep.dispatched(route.parts, request.method)
        if workflow is None:
            return None
        found = self.github_get(candidate, '/repos/%s/actions/workflows/%s'
                                % (repository, urllib.parse.quote(workflow, safe='')))
        try:
            upkeep.check_dispatch(rules, repository, found.get('path'))
        except upkeep.Refused as refused:
            self.upkeep_refused('dispatch', repository, str(refused))
        body, data = self.upkeep_body(request, repository, 'dispatch', MAX_DISPATCH)
        default = self.github_get(candidate, '/repos/%s' % repository).get('default_branch')
        ref = body.get('ref') if isinstance(body, dict) else None
        if not isinstance(default, str) or not default or ref not in (default, 'refs/heads/' + default):
            self.upkeep_refused('dispatch', repository, 'this Upkeep starts a listed workflow only on the default '
                                                        'branch of its repository.')
        return data

    def upkeep_branch(self, request, route, candidate, repository):
        """Refuses a change of the default branch without a pull request: a file change through
        the contents API, whose branch is the default one unless its body names another, the
        update of a pull request whose head is that branch, or a change of the branch's
        reference. Returns the body of a file change, which is then sent
        as read, or None."""
        branch = upkeep.branch_written(request.method, route.parts)
        if branch is None:
            return None
        data = None
        if type(branch) is int:
            pull = self.github_get(candidate, '/repos/%s/pulls/%d' % (repository, branch))
            head = pull.get('head') if isinstance(pull.get('head'), dict) else {}
            same = str((head.get('repo') or {}).get('full_name') or '').lower() == repository.lower()
            # A head in a fork is not this repository's default branch.
            branch = head.get('ref') if same or not head else 'fork:' + str(head.get('ref'))
            branch = branch if isinstance(branch, str) else ''
        elif branch is upkeep.CONTENTS:
            body, data = self.upkeep_body(request, repository, 'api', MAX_CONTENTS)
            branch = body.get('branch') if isinstance(body, dict) else None
            if branch is not None and not isinstance(branch, str):
                self.upkeep_refused('api', repository, 'this Upkeep reads the branch of a file change only as text.')
            branch = (branch or '').removeprefix('refs/heads/')
        default = self.github_get(candidate, '/repos/%s' % repository).get('default_branch')
        if not isinstance(default, str) or not default or branch in ('', default):
            self.upkeep_refused('api', repository, 'this Upkeep changes the default branch only through a merged '
                                                   'pull request: change another branch and open one.')
        return data

    def github_get(self, candidate, path):
        """GitHub's JSON object at `path`, read with the token of `candidate`, or {}."""
        status, reply = self.broker.call(rest.API, 'GET', path, candidate.token,
                                         sent=lambda: self.record.update(granted=True))
        return reply if status == 200 and isinstance(reply, dict) else {}

    def upkeep_review(self, request, repository):
        """Reads a new or submitted review and refuses an approval. Returns the body, which is
        then sent as read."""
        body, data = self.upkeep_body(request, repository, 'review', MAX_REVIEW)
        if isinstance(body, dict) and upkeep.approves(body.get('event')):
            self.upkeep_refused('review', repository, upkeep.APPROVAL)
        return data

    def upkeep_merge(self, rules, request, repository, number, candidate):
        """Reads a REST merge and sends it through the gate. Returns its body, which is then
        sent as read."""
        # GitHub reads only the JSON body that the gate reads, in no other form.
        content_type = (request.field('content-type') or 'application/json').split(';')[0].strip().lower()
        if content_type != 'application/json':
            self.upkeep_refused('merge', repository, 'this Upkeep reads a merge only as a JSON body.')
        body, data = self.upkeep_body(request, repository, 'merge', MAX_MERGE)
        try:
            gate(rules, self.github(candidate), repository, number, body.get('sha') if isinstance(body, dict) else None)
        except upkeep.Refused as refused:
            self.upkeep_refused('merge', repository, str(refused))
        return data

    def github(self, candidate, sent=None):
        """call(method, path) on GitHub's API with the token of `candidate`."""
        def call(method, path):
            return self.broker.call(rest.API, method, path, candidate.token,
                                    sent=sent or (lambda: self.record.update(granted=True)))
        return call

    def upkeep_merges(self, rules, plan, candidate, granted):
        """Sends a GraphQL merge of a pull request through the gate. GitHub runs the mutations
        of a document in order, after the gate read its state, so a merge comes alone."""
        if len(plan.mutations) > 1 and any(name == 'mergePullRequest' for name, _ in plan.mutations):
            reason = 'this Upkeep merges a pull request only in a GraphQL request without other mutations.'
            self.broker.log.refused('merge', None, reason)
            raise policy.Refused(reason)
        for name, arguments in plan.mutations:
            if name != 'mergePullRequest':
                continue
            values = arguments.get('input') if isinstance(arguments.get('input'), dict) else {}
            status, reply = self.broker.call(rest.API, 'POST', '/graphql', candidate.token,
                                             {'query': MERGED_PULL, 'variables': {'id': values.get('pullRequestId')}},
                                             sent=granted)
            node = ((reply or {}).get('data') or {}).get('node') if status == 200 and isinstance(reply, dict) else None
            node = node if isinstance(node, dict) and node.get('__typename') == 'PullRequest' else {}
            repository = (node.get('repository') or {}).get('nameWithOwner')
            number = node.get('number')
            try:
                if not isinstance(repository, str) or type(number) is not int:
                    raise upkeep.Refused('GitHub did not show the pull request that the merge names; try again.')
                gate(rules, self.github(candidate, granted), repository, number, values.get('expectedHeadOid'))
            except upkeep.Refused as refused:
                self.broker.log.refused('merge', repository if isinstance(repository, str) else None, str(refused))
                raise policy.Refused(str(refused)) from None

    def upkeep_mutations(self, plan):
        """Refuses auto-merge and the approval of a pull request for an Upkeep."""
        for name, arguments in plan.mutations:
            values = arguments.get('input') if isinstance(arguments.get('input'), dict) else {}
            reason = None
            if name == 'enablePullRequestAutoMerge':
                reason = 'this Upkeep does not let an agent turn on auto-merge.'
            elif name == 'addPullRequestReview' and upkeep.approves(values.get('event')):
                reason = upkeep.APPROVAL
            if reason is not None:
                self.broker.log.refused('merge' if name == 'enablePullRequestAutoMerge' else 'review', None, reason)
                raise policy.Refused(reason)


if __name__ == '__main__':
    raise SystemExit('horizon-worker-github-api-upkeep is a module of horizon-worker-github, not a command.')
