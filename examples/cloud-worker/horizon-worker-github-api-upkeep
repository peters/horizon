"""The Upkeep checks of the worker's API broker (horizon-worker-github-api): the policy's
refusals, the list of workflows and the approvals of reviews. A mixin of the broker's
Exchange, which provides `broker`, `record` and `output`. A module that horizon-worker-github
loads, not a command."""
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import sys
import urllib.parse


def load_common():
    name = 'horizon_worker_github_common'
    if name not in sys.modules:
        loader = importlib.machinery.SourceFileLoader(
            name, str(Path(__file__).resolve().with_name('horizon-worker-github-common')))
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
        sys.modules[name] = module
        loader.exec_module(module)
    return sys.modules[name]


common = load_common()
relay = common.load_sibling('horizon-worker-github-http', 'horizon_worker_github_http')
rest = common.load_sibling('horizon-worker-github-api-rest', 'horizon_worker_github_api_rest')
upkeep = common.load_sibling('horizon-worker-github-upkeep', 'horizon_worker_github_upkeep')
policy = rest.policy

PREFIX = 'Horizon: '
# A review is read in full to find its event, and a dispatch to find its ref.
MAX_REVIEW = 1 << 20
MAX_DISPATCH = 65536
# A file change is read in full to find its branch.
MAX_CONTENTS = 32 << 20


def refusal(status, message):
    return relay.Refusal(status, PREFIX + message)


def unique(pairs):
    """A JSON object whose fields each come once; ValueError otherwise."""
    found = dict(pairs)
    if len(found) != len(pairs):
        raise ValueError('a field comes twice')
    return found


class Checks:
    """The broker's checks for a cloud with an Upkeep policy."""

    def upkeep_refused(self, kind, repository, reason):
        """Logs a refusal of the Upkeep policy for the board and refuses the request."""
        self.broker.log.refused(kind, repository, reason)
        raise refusal(403, reason)

    def upkeep_body(self, request, repository, kind, limit):
        """(JSON, bytes) of a request body that the broker reads before the request goes; the
        bytes are then sent as read. GitHub reads only that body, so there is no query."""
        if '?' in request.target:
            self.upkeep_refused(kind, repository, 'this Upkeep reads this request only from its body, '
                                                  'so it has no query.')
        relay.continue_if_asked(request, self.output)
        data = relay.read_body(request, limit)
        try:
            # A repeated field could mean one thing here and another on GitHub.
            return (json.loads(data, object_pairs_hook=unique) if data else {}), data
        except (ValueError, RecursionError):
            self.upkeep_refused(kind, repository, 'this Upkeep reads this request only as JSON with each field once.')

    def upkeep_dispatch(self, rules, request, route, candidate, repository):
        """Refuses a workflow dispatch of a workflow that the person did not list, and one on
        another ref than the default branch, where an agent can push a changed workflow.
        Returns the body of a dispatch, which is then sent as read, or None."""
        workflow = upkeep.dispatched(route.parts, request.method)
        if workflow is None:
            return None
        found = self.github_get(candidate, '/repos/%s/actions/workflows/%s'
                                % (repository, urllib.parse.quote(workflow, safe='')))
        try:
            upkeep.check_dispatch(rules, repository, found.get('path'))
        except upkeep.Refused as refused:
            self.upkeep_refused('dispatch', repository, str(refused))
        body, data = self.upkeep_body(request, repository, 'dispatch', MAX_DISPATCH)
        default = self.github_get(candidate, '/repos/%s' % repository).get('default_branch')
        ref = body.get('ref') if isinstance(body, dict) else None
        if not isinstance(default, str) or not default or ref not in (default, 'refs/heads/' + default):
            self.upkeep_refused('dispatch', repository, 'this Upkeep starts a listed workflow only on the default '
                                                        'branch of its repository.')
        return data

    def upkeep_branch(self, request, route, candidate, repository):
        """Refuses a change of the default branch without a pull request: a file change through
        the contents API, whose branch is the default one unless its body names another, the
        update of a pull request whose head is that branch, or a change of the branch's
        reference. Returns the body of a file change, which is then sent
        as read, or None."""
        branch = upkeep.branch_written(request.method, route.parts)
        if branch is None:
            return None
        data = None
        if type(branch) is int:
            pull = self.github_get(candidate, '/repos/%s/pulls/%d' % (repository, branch))
            head = pull.get('head') if isinstance(pull.get('head'), dict) else {}
            same = str((head.get('repo') or {}).get('full_name') or '').lower() == repository.lower()
            # A head in a fork is not this repository's default branch.
            branch = head.get('ref') if same or not head else 'fork:' + str(head.get('ref'))
            branch = branch if isinstance(branch, str) else ''
        elif branch is upkeep.CONTENTS:
            body, data = self.upkeep_body(request, repository, 'api', MAX_CONTENTS)
            branch = body.get('branch') if isinstance(body, dict) else None
            if branch is not None and not isinstance(branch, str):
                self.upkeep_refused('api', repository, 'this Upkeep reads the branch of a file change only as text.')
            branch = (branch or '').removeprefix('refs/heads/')
        default = self.github_get(candidate, '/repos/%s' % repository).get('default_branch')
        if not isinstance(default, str) or not default or branch in ('', default):
            self.upkeep_refused('api', repository, 'this Upkeep changes the default branch only through a merged '
                                                   'pull request: change another branch and open one.')
        return data

    def github_get(self, candidate, path):
        """GitHub's JSON object at `path`, read with the token of `candidate`, or {}."""
        status, reply = self.broker.call(rest.API, 'GET', path, candidate.token,
                                         sent=lambda: self.record.update(granted=True))
        return reply if status == 200 and isinstance(reply, dict) else {}

    def upkeep_review(self, request, repository):
        """Reads a new or submitted review and refuses an approval. Returns the body, which is
        then sent as read."""
        body, data = self.upkeep_body(request, repository, 'review', MAX_REVIEW)
        if isinstance(body, dict) and upkeep.approves(body.get('event')):
            self.upkeep_refused('review', repository, upkeep.APPROVAL)
        return data

    def upkeep_mutations(self, plan):
        """Refuses auto-merge and the approval of a pull request for an Upkeep."""
        for name, arguments in plan.mutations:
            values = arguments.get('input') if isinstance(arguments.get('input'), dict) else {}
            reason = None
            if name == 'enablePullRequestAutoMerge':
                reason = 'this Upkeep does not let an agent turn on auto-merge.'
            elif name == 'addPullRequestReview' and upkeep.approves(values.get('event')):
                reason = upkeep.APPROVAL
            if reason is not None:
                self.broker.log.refused('merge' if name == 'enablePullRequestAutoMerge' else 'review', None, reason)
                raise policy.Refused(reason)


if __name__ == '__main__':
    raise SystemExit('horizon-worker-github-api-upkeep is a module of horizon-worker-github, not a command.')
