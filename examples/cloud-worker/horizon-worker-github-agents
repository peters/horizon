"""The agent side of horizon-worker-github: the socket that answers agents, and the access
requests that agents make and the person decides in Horizon, for the whole cloud or for the
task that asked (horizon-worker-github-tasks). The github_access MCP tool that makes the
requests is horizon-worker-github-mcp. A module that horizon-worker-github loads, not a
command."""
import contextlib
import http.client
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import secrets
import socket
import struct
import sys
import threading
import time
import unicodedata
import urllib.error
import urllib.request

def load_common():
    name = 'horizon_worker_github_common'
    if name not in sys.modules:
        loader = importlib.machinery.SourceFileLoader(
            name, str(Path(__file__).resolve().with_name('horizon-worker-github-common')))
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
        sys.modules[name] = module
        loader.exec_module(module)
    return sys.modules[name]


common = load_common()
auth = common.auth
# The stop watcher's mapping from a process to its agent session, so both tools identify
# sessions the same way.
idle = common.load_sibling('horizon-worker-idle', 'horizon_worker_idle')
tasks = common.load_sibling('horizon-worker-github-tasks', 'horizon_worker_github_tasks')

SOCKET = Path('/run/horizon-worker/github.sock')
LOG = 'requests.log'
LOG_LIMIT = 1 << 20
BOOK = 'access-requests.json'
MAX_BOOK = 262144
# Root, and the agent identity that horizon-worker-tailnet isolate gives every session.
ALLOWED_UIDS = (0, 10001)
ROOT_UID = 0
MAX_REQUEST = 8192
CONNECTIONS = 16
MAX_PENDING = 32
# Cloud grants are stored with the chain, whose file has a size limit when it is read back.
MAX_CLOUD_GRANTS = 32
# In UTF-8 bytes, as Horizon reads them; also for the session and agent names it shows.
REASON_LIMIT = 300
NAME_LIMIT = 100
REQUEST_SECONDS = 24 * 3600
# Decided and expired requests stay readable for the session for one more day.
RETAIN_SECONDS = 48 * 3600
# For the whole cloud, for the agent session that asked, or not at all.
DECISIONS = ('allow-cloud', 'allow-task', 'deny')
KINDS = ('credential', 'gh-token', 'request', 'request-status')


def refusal(state, message):
    return {'ok': False, 'state': state, 'message': message}


class Book:
    """Access requests and task grants, root-only on tmpfs: they end with the container."""

    def __init__(self, runtime=common.RUNTIME):
        self.runtime = runtime

    def read(self):
        try:
            data = common.read_json(self.runtime / BOOK, MAX_BOOK)
        except (OSError, ValueError, RecursionError):
            data = None
        if not isinstance(data, dict) or not isinstance(data.get('requests'), list):
            return {'requests': [], 'task_grants': []}
        grants = data.get('task_grants')
        return {'requests': data['requests'],
                'task_grants': [grant for grant in grants if tasks.valid(grant)] if isinstance(grants, list) else []}

    @contextlib.contextmanager
    def edit(self):
        """The book under its lock; what the block leaves in it is stored when it ends."""
        with common.locked(self.runtime, 'access-requests.lock'):
            data = self.read()
            yield data
            common.write_private(self.runtime, BOOK, json.dumps(data, separators=(',', ':')))

    def clear(self):
        with common.locked(self.runtime, 'access-requests.lock'):
            (self.runtime / BOOK).unlink(missing_ok=True)


def tidy(data, now):
    """Expires old requests and forgets them a day later."""
    for record in data['requests']:
        if record['status'] == 'pending' and now - record['created_at'] >= REQUEST_SECONDS:
            record['status'] = 'expired'
    data['requests'] = [record for record in data['requests'] if now - record['created_at'] < RETAIN_SECONDS]
    return data


def pending(data):
    return [record for record in data['requests'] if record['status'] == 'pending']


def account(state):
    """The app and GitHub account a chain acts for; without a login, that install alone.
    A request belongs to the account of the chain it was made under."""
    if state is None:
        return None
    login = state.get('login')
    return [state['client_id'], login if login else 'install:%s' % state.get('install_id', state.get('installed_at'))]


def expire_other_accounts(data, current):
    """Expires the waiting requests that were made under another chain's account, so a new
    app or account never receives them. A request of the current account stays."""
    for record in pending(data):
        if record.get('account') != current:
            record['status'] = 'expired'
    return data


def utf8_length(text):
    """The UTF-8 length of `text`, or one past any limit when it is not valid Unicode."""
    try:
        return len(text.encode('utf-8'))
    except UnicodeEncodeError:
        return REASON_LIMIT + 1


def reportable(record):
    """Whether Horizon can show the record: valid Unicode within its limits. A record it
    would leave out never reaches it, so a waiting card is never hidden."""
    return (utf8_length(str(record['repository'])) <= REASON_LIMIT
            and utf8_length(str(record['reason'])) <= REASON_LIMIT
            and utf8_length(str(record['session'])) <= NAME_LIMIT)


def covered(grant_access, needed):
    return grant_access == 'push' or grant_access == needed


def cloud_access(state, repository):
    """The widest access the installed and cloud grants give `repository`, or None."""
    best = None
    for grant in state['grants'] + state.get('cloud_grants', []):
        if auth.same_repository(repository, grant['repository']):
            best = common.stronger(best, grant['access'])
    return best


def granted_access(state, repository, task=None):
    """(access, repository name) from the installed and cloud grants, and from the task grants
    of the caller when `task(repository)` gives their access."""
    if not auth.valid_repository(repository):
        return None, repository
    access = cloud_access(state, repository)
    if task is not None and access != 'push':
        access = common.stronger(access, task(repository))
    return access, canonical(state, repository)


def task_access(book, state, pids):
    """`task` for granted_access: the task grants of the caller held by the processes `pids`."""
    def access(repository):
        return tasks.access(book.read()['task_grants'], repository, pids, account(state))
    return access


def canonical(state, repository):
    """The spelling of the grant that matches, so gh gets the repository's own name."""
    grants = state['grants'] + state.get('cloud_grants', [])
    return next((grant['repository'] for grant in grants if auth.same_repository(repository, grant['repository'])),
                repository)


def credential_answer(request, state, now, task=None):
    if request['request'] == 'credential':
        # Git reaches GitHub through the service's Git proxy, which adds the token itself.
        return refusal('ok', 'Git reaches GitHub through this worker\'s Git proxy, which hands out no token.'), None
    chain = state['chain']
    if chain['access_expires_at'] - now <= common.SERVE_MARGIN:
        return refusal('ok', 'The GitHub access token has expired or expires within a minute, and this worker '
                             'could not refresh it yet.'), None
    repository = request.get('repository')
    access, name = granted_access(state, repository, task)
    if access is None:
        return refusal('ok', 'This repository has no GitHub grant on this worker.'), repository
    return {'ok': True, 'state': 'ok', 'token': chain['access_token'], 'repository': name, 'access': access,
            'expires_at': chain['access_expires_at']}, name


def valid_reason(reason):
    """One short line that reads as it is: no control, formatting, surrogate or line and
    paragraph separator characters, which could make the person's approval card read
    differently from what it asks, or keep the host from reading the list."""
    return (isinstance(reason, str) and reason.strip() != '' and utf8_length(reason) <= REASON_LIMIT
            and not any(unicodedata.category(character) in ('Cc', 'Cf', 'Cs', 'Zl', 'Zp') for character in reason))


def ask(request, state, book, now, identify):
    """Records an agent's request for access, or answers that it already has it."""
    repository, access, reason = request.get('repository'), request.get('access'), request.get('reason')
    if not auth.valid_repository(repository) or access not in common.ACCESS:
        return refusal('ok', 'Name a repository as owner/name and the access as push or read.'), None
    if not valid_reason(reason):
        return refusal('ok', 'Give a reason of at most %d bytes (plain characters count one each) on one line.'
                       % REASON_LIMIT), repository
    try:
        who = identify()
    except idle.Refused:
        return refusal('refused', 'Only an agent session on this worker can ask for GitHub access.'), repository
    if covered(cloud_access(state, repository), access):
        return {'ok': True, 'state': 'ok', 'status': 'allowed', 'scope': 'cloud', 'id': None}, repository
    window, session, agent, root = who
    with book.edit() as data:
        expire_other_accounts(tidy(data, now), account(state))
        if root is not None and covered(tasks.widest(data['task_grants'], repository, {tuple(root)},
                                                     account(state)), access):
            return {'ok': True, 'state': 'ok', 'status': 'allowed', 'scope': 'task', 'id': None}, repository
        for record in pending(data):
            if (record['window'], record['session']) == (window, session) and \
                    auth.same_repository(repository, record['repository']):
                # A request for more than the pending one asks for that, with its reason, so an
                # allow gives what the agent now needs.
                if common.stronger(record['access'], access) != record['access']:
                    record.update(access=access, reason=reason)
                return {'ok': True, 'state': 'ok', 'status': 'pending', 'id': record['id'],
                        'access': record['access']}, repository
        if len(pending(data)) >= MAX_PENDING:
            return refusal('ok', 'Too many GitHub access requests wait for the person.'), repository
        record = {'id': secrets.token_hex(8), 'repository': repository, 'access': access, 'reason': reason,
                  'session': session, 'window': window, 'agent': agent, 'root': root, 'created_at': int(now),
                  'status': 'pending', 'scope': None, 'decided_at': None, 'account': account(state)}
        data['requests'].append(record)
    return {'ok': True, 'state': 'ok', 'status': 'pending', 'id': record['id'], 'access': access}, repository


def request_status(request, state, book, now, identify):
    try:
        window, session, _, _ = identify()
    except idle.Refused:
        return refusal('refused', 'Only an agent session on this worker can read its requests.'), None
    data = expire_other_accounts(tidy(book.read(), now), account(state))
    for record in data['requests']:
        if record['id'] == request.get('id') and (record['window'], record['session']) == (window, session):
            return {'ok': True, 'state': 'ok', 'id': record['id'], 'status': record['status'],
                    'scope': record['scope'], 'repository': record['repository'],
                    'access': record['access']}, record['repository']
    return refusal('ok', 'This session has no GitHub access request with that ID.'), None


def answer(request, store, book, now, identify, pid=None):
    """The reply to one agent request from process `pid`, and the repository it named for the
    log. Only a chain that may be served counts; one that is not stored yet is refused as
    `unstored`, never as `absent`, which would send gh to the static file."""
    if not isinstance(request, dict) or request.get('request') not in KINDS:
        return refusal('refused', 'Malformed GitHub request.'), None
    state = store.load(serving=True)[0]
    if state is None and store.load()[0] is not None:
        return refusal('unstored', 'The GitHub token chain is not stored yet; try again in a minute.'), None
    if state is None:
        return refusal('absent', 'No GitHub token chain is installed on this worker.'), None
    if state['state'] != 'ok':
        return refusal('revoked', 'GitHub access on this worker was revoked; connect GitHub again in Horizon.'), None
    if request['request'] == 'request':
        return ask(request, state, book, now, identify)
    if request['request'] == 'request-status':
        return request_status(request, state, book, now, identify)
    return credential_answer(request, state, now, task_access(book, state, [pid] if pid else []))


def peer(connection):
    """(pid, uid) of the connecting process, as the kernel reports them."""
    pid, uid, _ = struct.unpack('3i', connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                                            struct.calcsize('3i')))
    return pid, uid


# The socket and the Git proxy log from many threads; one rotation at a time.
LOG_LOCK = threading.Lock()


def log_request(directory, record):
    """One line per request without any token, in a root-only log that keeps two files."""
    path = directory / LOG
    with LOG_LOCK:
        with contextlib.suppress(FileNotFoundError):
            if path.lstat().st_size > LOG_LIMIT:
                os.replace(path, directory / (LOG + '.1'))
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        with os.fdopen(fd, 'a') as output:
            output.write(json.dumps(record, separators=(',', ':')) + '\n')


def identify_session(pid):
    """The agent session of process `pid`, as (window, session, agent, root), where root names
    the session's pane process for a task grant; raises idle.Refused."""
    pane, window, session, agent = idle.pane(pid)
    return window, session, agent, tasks.root(pane)


def handle(connection, store, book, report=None):
    pid, uid = peer(connection)
    connection.settimeout(5)
    with connection.makefile('rb') as stream:
        line = stream.readline(MAX_REQUEST + 1)
    try:
        request = json.loads(line) if len(line) <= MAX_REQUEST else None
    except ValueError:
        request = None
    now = time.time()
    if uid not in ALLOWED_UIDS:
        reply, repository = refusal('refused', 'This account may not use GitHub access on this worker.'), None
    elif isinstance(request, dict) and request.get('request') == 'status' and report is not None:
        # Only root (the host's status command) reads the status of the serving process.
        reply = dict(report(store), ok=True) if uid == ROOT_UID else refusal('refused', 'Only root reads the status.')
        repository = None
    else:
        reply, repository = answer(request, store, book, now, lambda: identify_session(pid), pid)
        # An agent's gh gets the placeholder: it reaches GitHub through the API broker, which
        # adds the token itself, so no agent process holds one.
        if uid != ROOT_UID and 'token' in reply:
            reply = dict(reply, token=common.PLACEHOLDER)
    kind = request.get('request') if isinstance(request, dict) else None
    with contextlib.suppress(OSError):
        log_request(store.runtime, {'at': int(now), 'uid': uid, 'pid': pid,
                                    'request': kind if kind in KINDS + ('status',) else 'invalid',
                                    'repository': repository if auth.valid_repository(repository) else None,
                                    'granted': reply['ok']})
    connection.sendall((json.dumps(reply) + '\n').encode())


def listen(path):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.unlink(missing_ok=True)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(path))
    # Any account may connect; the kernel's peer credentials decide who gets an answer.
    path.chmod(0o666)
    server.listen(CONNECTIONS)
    return server


def accept_forever(server, store, book, report=None):
    slots = threading.BoundedSemaphore(CONNECTIONS)

    def run(connection):
        try:
            with connection:
                handle(connection, store, book, report)
        # One bad client must not end the service.
        except Exception as error:
            print('GitHub request failed: ' + type(error).__name__, flush=True)
        finally:
            slots.release()

    while True:
        try:
            connection, _ = server.accept()
        except OSError as error:
            if server.fileno() < 0:
                return
            print('GitHub socket accept failed: ' + type(error).__name__, flush=True)
            time.sleep(1)
            continue
        slots.acquire()
        threading.Thread(target=run, args=(connection,), daemon=True).start()


def reachable(token, repository, access, environ=os.environ, timeout=15):
    """None when the token reaches `repository` with `access`, else the reason as a code."""
    _, api, loopback = common.github_bases(environ)
    request = urllib.request.Request(api + '/repos/' + repository, headers={
        'Accept': 'application/vnd.github+json', 'Authorization': 'Bearer ' + token,
        'X-GitHub-Api-Version': '2022-11-28', 'User-Agent': 'horizon-worker-github/1'})
    try:
        with common.opener(loopback).open(request, timeout=timeout) as response:
            body = json.loads(response.read(1 << 20))
    except urllib.error.HTTPError as error:
        error.close()
        return {401: 'token_invalid', 403: 'forbidden', 404: 'not_installed'}.get(error.code, 'unreachable')
    except (OSError, http.client.HTTPException, ValueError):
        return 'unreachable'
    permissions = body.get('permissions') if isinstance(body, dict) else None
    if access == 'push' and not (isinstance(permissions, dict) and permissions.get('push') is True):
        return 'no_push'
    return None


MESSAGES = {
    'unknown_request': 'No pending GitHub access request has this ID.',
    'not_pending': 'This request was already decided or expired.',
    'account_changed': 'This request was made for another GitHub account, so it expired.',
    'too_many_grants': 'This cloud already has the most repositories that can be allowed for it.',
    'too_many_task_grants': 'This worker already holds the most repositories that can be allowed for tasks.',
    'session_ended': 'The agent session that asked has ended, so it can no longer be allowed for this task.',
    'chain_changed': 'GitHub access on this worker changed while the request was checked; decide again.',
    'no_chain': 'This worker holds no usable GitHub sign-in.',
    'token_expired': 'The GitHub access token expired; wait for the worker to refresh it.',
    'not_installed': 'The GitHub App is not installed on this repository, or the account cannot see it.',
    'no_push': 'The GitHub account cannot push to this repository.',
    'token_invalid': 'GitHub refused the access token.',
    'forbidden': 'GitHub refused access to this repository.',
    'unreachable': 'GitHub could not be reached; try again.',
}


def failure(identifier, code):
    return {'ok': False, 'id': identifier, 'error': code, 'message': MESSAGES[code]}


def decide(store, book, identifier, decision, now=time.time, check=reachable, proc=tasks.PROC):
    """The person's decision on one request. A failed check leaves the request pending. A
    repository allowed for the cloud joins the cloud's grants, so every agent session of the
    cloud gets it; one allowed for the task reaches only the session that asked, until it ends."""
    if decision not in DECISIONS:
        raise ValueError('Unknown decision')
    with book.edit() as data:
        current = now()
        tidy(data, current)
        record = next((item for item in data['requests'] if item['id'] == identifier), None)
        if record is None:
            return failure(identifier, 'unknown_request')
        if record['status'] != 'pending':
            return dict(failure(identifier, 'not_pending'), status=record['status'])
        result = {'ok': True, 'id': identifier, 'decision': decision, 'repository': record['repository'],
                  'access': record['access']}
        if decision == 'deny':
            record.update(status='denied', decided_at=int(current))
            return dict(result, status='denied')
        checked = store.load()[0]
        if checked is None or checked['state'] != 'ok':
            return failure(identifier, 'no_chain')
        # A request belongs to the account it was made under; another one never receives it.
        if record.get('account') != account(checked):
            record.update(status='expired', decided_at=int(current))
            return failure(identifier, 'account_changed')
        if checked['chain']['access_expires_at'] - current <= common.SERVE_MARGIN:
            return failure(identifier, 'token_expired')
        if decision == 'allow-task' and not task_possible(record, proc):
            record.update(status='expired', decided_at=int(current))
            return failure(identifier, 'session_ended')
        if decision == 'allow-cloud' and len(other_grants(checked, record)) >= MAX_CLOUD_GRANTS:
            return failure(identifier, 'too_many_grants')
        # Checked without the store lock, which a refresh or an install holds for long.
        code = check(checked['chain']['access_token'], record['repository'], record['access'])
        if code is not None:
            return failure(identifier, code)
        if decision == 'allow-task':
            # GitHub was asked without the store lock: the chain and the session may have
            # changed since.
            state = store.load()[0]
            if state is None or state['state'] != 'ok':
                return failure(identifier, 'no_chain')
            if not same_chain(checked, state):
                return failure(identifier, 'chain_changed')
            if not task_possible(record, proc):
                record.update(status='expired', decided_at=int(current))
                return failure(identifier, 'session_ended')
            return allow_task(data, record, result, int(current), proc)
        with store.lock():
            state = store.load()[0]
            if state is None or state['state'] != 'ok':
                return failure(identifier, 'no_chain')
            if not same_chain(checked, state):
                return failure(identifier, 'chain_changed')
            others = other_grants(state, record)
            if len(others) >= MAX_CLOUD_GRANTS:
                return failure(identifier, 'too_many_grants')
            access = common.stronger(record['access'], cloud_access(
                {'grants': [], 'cloud_grants': state.get('cloud_grants', [])}, record['repository']))
            grants = others + [{'repository': record['repository'], 'access': access}]
            store.save(dict(state, cloud_grants=grants), retain=False)
        record.update(status='allowed', scope='cloud', decided_at=int(current))
        return dict(result, status='allowed')


def allow_task(data, record, result, current, proc):
    """Adds a task grant for the session that asked, under the book's lock."""
    grants, access = [], record['access']
    for grant in tasks.prune(data['task_grants'], proc):
        if grant['root'] == record['root'] and grant['account'] == record['account'] \
                and auth.same_repository(grant['repository'], record['repository']):
            access = common.stronger(access, grant['access'])
        else:
            grants.append(grant)
    if len(grants) >= tasks.MAX_TASK_GRANTS:
        data['task_grants'] = grants
        return failure(record['id'], 'too_many_task_grants')
    grants.append({'repository': record['repository'], 'access': access, 'root': record['root'],
                   'window': record['window'], 'session': record['session'], 'account': record['account'],
                   'granted_at': current})
    data['task_grants'] = grants
    record.update(status='allowed', scope='task', decided_at=current)
    return dict(result, status='allowed', scope='task')


def other_grants(state, record):
    """The cloud grants for repositories other than the request's."""
    return [grant for grant in state.get('cloud_grants', [])
            if not auth.same_repository(record['repository'], grant['repository'])]


def same_chain(checked, current):
    """Whether `current` is the chain that GitHub checked: the same token, or a refresh of the
    same app and known account. Another install in between must not receive the grant."""
    if current['chain']['access_token'] == checked['chain']['access_token']:
        return True
    return (current['client_id'] == checked['client_id'] and bool(checked.get('login'))
            and current.get('login') == checked.get('login'))


def requests_report(book, state, now=time.time, proc=tasks.PROC):
    """The pending requests of the current chain's account for the host, without secrets.
    `task` says whether the session that asked still runs, so it can be allowed alone."""
    data = expire_other_accounts(tidy(book.read(), now()), account(state))
    # The agent name comes from a session marker that any process of the cloud can write,
    # so it is not reported: the card names the session, not a verified agent.
    return {'requests': [dict({key: record[key] for key in ('id', 'repository', 'access', 'reason', 'session',
                                                            'created_at')}, task=task_possible(record, proc))
                         for record in pending(data) if reportable(record)]}


def task_possible(record, proc):
    root = record.get('root')
    return isinstance(root, list) and len(root) == 2 and tasks.alive({'root': root}, proc)


if __name__ == '__main__':
    sys.exit('horizon-worker-github-agents is a module of horizon-worker-github, not a command.')
