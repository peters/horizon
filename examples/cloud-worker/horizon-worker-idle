#!/usr/bin/python3
"""Stop this dedicated worker after its configured period without agent activity, or
when an agent whose task is done asks through horizon-worker-stop."""
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import threading
import time
import urllib.request


CPU_STAT = Path('/sys/fs/cgroup/cpu.stat')
# Some provider hosts still use cgroup v1, which reports nanoseconds instead.
CPU_ACCOUNTING = (Path('/sys/fs/cgroup/cpuacct/cpuacct.usage'), Path('/sys/fs/cgroup/cpu,cpuacct/cpuacct.usage'))
# The pod credential is refused by the REST API but accepted by GraphQL, as runpodctl uses it.
GRAPHQL_URL = 'https://api.runpod.io/graphql'
STOP = 'mutation Stop($pod: String!) { podStop(input: {podId: $pod}) { id desiredStatus } }'
POLL_SECONDS = 60
RETRY_SECONDS = 600
# Average cores used by the container that still count as work, such as a quiet build.
BUSY_CORES = 0.5
# Agents ask for a stop here; only this watcher holds the worker credential.
STOP_SOCKET = Path('/run/horizon-worker/stop.sock')
# Kept on the workspace volume, so it survives the stop and the checker reports it on resume.
STOP_LOG = Path('/workspace/.horizon/self-stops.jsonl')
# Another agent session with output this recent is still working.
QUIET_SECONDS = 120
CPU_SAMPLE_SECONDS = 3
REASON_LIMIT = 200


def last_output():
    """Newest output time of any agent tmux window, or None without sessions."""
    try:
        listing = subprocess.run(['tmux', '-L', 'horizon-cloud', 'list-windows', '-a', '-F', '#{window_activity}'],
                                 capture_output=True, text=True, timeout=10, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    return max((int(stamp) for stamp in listing.split() if stamp.isdigit()), default=None)


def cpu_seconds(path=CPU_STAT, accounting=CPU_ACCOUNTING):
    """CPU time used by this container's cgroup, or None where it is not exposed."""
    try:
        for line in path.read_text().splitlines():
            name, value = line.split()
            if name == 'usage_usec':
                return int(value) / 1e6
    except (OSError, ValueError):
        pass
    for usage in accounting:
        try:
            return int(usage.read_text()) / 1e9
        except (OSError, ValueError):
            continue
    return None


class Activity:
    def __init__(self, idle_seconds, now, cpu=None):
        self.idle_seconds = idle_seconds
        self.last_active = now
        # A baseline at start lets work during the first poll interval count.
        self.last_cpu = cpu
        self.last_sample = now

    def observe(self, now, output, cpu):
        """Records one sample and reports whether the idle period has elapsed."""
        if output is not None:
            self.last_active = max(self.last_active, output)
        if cpu is not None and self.last_cpu is not None and now > self.last_sample:
            if (cpu - self.last_cpu) / (now - self.last_sample) >= BUSY_CORES:
                self.last_active = now
        self.last_cpu, self.last_sample = cpu, now
        return now - self.last_active >= self.idle_seconds


def stop_worker(pod_id, key):
    body = json.dumps({'query': STOP, 'variables': {'pod': pod_id}}).encode()
    request = urllib.request.Request(GRAPHQL_URL, data=body, method='POST',
                                     headers={'Authorization': 'Bearer ' + key, 'Content-Type': 'application/json',
                                              # The provider's edge rejects the default Python agent.
                                              'User-Agent': 'horizon-worker-idle/1'})
    with urllib.request.urlopen(request, timeout=30) as response:
        reply = json.load(response)
    data = reply.get('data') if isinstance(reply, dict) else None
    stopped = data.get('podStop') if isinstance(data, dict) else None
    if (reply.get('errors') or not isinstance(stopped, dict) or stopped.get('id') != pod_id
            or stopped.get('desiredStatus') != 'EXITED'):
        print('Stop request refused: ' + json.dumps(reply.get('errors') or stopped)[:300], flush=True)
        return False
    return True


class Refused(Exception):
    """A stop this worker must not make now, with the reason to give the agent."""


def reason_text(reason):
    text = ' '.join(str(reason or '').split())
    if not text:
        raise Refused('Give a short reason for stopping this worker.')
    return text[:REASON_LIMIT]


def other_output(own):
    """Newest output time of any agent window except `own`, or None without others."""
    try:
        listing = subprocess.run(['tmux', '-L', 'horizon-cloud', 'list-windows', '-a', '-F',
                                  '#{window_id} #{window_activity}'],
                                 capture_output=True, text=True, timeout=10, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    stamps = []
    for line in listing.splitlines():
        window, _, stamp = line.partition(' ')
        if window != own and stamp.isdigit():
            stamps.append(int(stamp))
    return max(stamps, default=None)


def busy_cores(sample=CPU_SAMPLE_SECONDS):
    """Average cores the container used over a short sample, or None where it is not exposed."""
    before = cpu_seconds()
    time.sleep(sample)
    after = cpu_seconds()
    if before is None or after is None:
        return None
    return (after - before) / sample


def self_stop(reason, window, pod_id, key, log=STOP_LOG, now=time.time, output=other_output, cores=busy_cores,
              request=None):
    """Checks, records and requests a stop an agent asked for. Returns the agent's message."""
    text = reason_text(reason)
    newest = output(window)
    if newest is not None and now() - newest < QUIET_SECONDS:
        raise Refused('Another agent session on this worker produced output in the last two minutes; '
                      'leave the worker running.')
    used = cores()
    if used is not None and used >= BUSY_CORES:
        raise Refused(f'This worker is busy ({used:.1f} cores in use); leave it running.')
    log.parent.mkdir(parents=True, exist_ok=True)
    before = log.stat().st_size if log.exists() else 0
    with log.open('a') as file:
        file.write(json.dumps({'at': int(now() * 1000), 'reason': text}) + '\n')
    os.sync()
    try:
        stopped = (request or stop_worker)(pod_id, key)
    # Any failure of this one request is reported; an escaping error would end the watcher.
    except Exception as error:
        print('Stop request failed: ' + type(error).__name__, flush=True)
        stopped = False
    if not stopped:
        # Only stops the provider accepted stay on record.
        with log.open('r+') as file:
            file.truncate(before)
        raise Refused('The provider did not accept the stop request; the worker keeps running.')
    print('Stopping this worker at an agent\'s request: ' + text, flush=True)
    return 'Stop requested. This worker is stopping; the person can resume it.'


def answer(line, pod_id, key, stop=self_stop):
    """The reply to one request line from horizon-worker-stop."""
    try:
        request = json.loads(line)
        if not isinstance(request, dict):
            raise ValueError
        message = stop(request.get('reason'), request.get('window'), pod_id, key)
        return {'ok': True, 'message': message}
    except Refused as refusal:
        return {'ok': False, 'message': str(refusal)}
    except ValueError:
        return {'ok': False, 'message': 'Malformed stop request.'}


def serve_stop_requests(pod_id, key, path=STOP_SOCKET, stop=self_stop):
    """Answers stop requests one at a time on a socket only this machine can reach."""
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.unlink(missing_ok=True)
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(str(path))
        path.chmod(0o600)
        server.listen(4)
    # Idle stop keeps working; agents are told the worker cannot stop itself.
    except OSError as error:
        print('Stop requests from agents unavailable: ' + type(error).__name__, flush=True)
        return
    while True:
        connection, _ = server.accept()
        with connection:
            try:
                connection.settimeout(30)
                line = connection.makefile('r').readline(4096)
                reply = answer(line, pod_id, key, stop)
                connection.sendall((json.dumps(reply) + '\n').encode())
            # One bad client must not end the watcher.
            except Exception as error:
                print('Stop request connection failed: ' + type(error).__name__, flush=True)


def passive(reason):
    # Exiting would end the supervised worker; stay passive instead.
    print('Idle stop disabled: ' + reason, flush=True)
    while True:
        time.sleep(3600)


def main():
    minutes = os.environ.get('HORIZON_IDLE_STOP_MINUTES', '')
    if not minutes.isdigit() or not 10 <= int(minutes) <= 1440:
        passive('invalid idle period')
    minutes = int(minutes)
    pod_id, key = os.environ.get('RUNPOD_POD_ID'), os.environ.get('RUNPOD_API_KEY')
    if not pod_id or not key:
        passive('the provider supplied no worker credential')
    threading.Thread(target=serve_stop_requests, args=(pod_id, key), daemon=True).start()
    activity = Activity(minutes * 60, time.time(), cpu_seconds())
    next_request = 0
    while True:
        # Activity is sampled every poll; only the provider request waits between retries.
        time.sleep(POLL_SECONDS)
        now = time.time()
        if not activity.observe(now, last_output(), cpu_seconds()) or now < next_request:
            continue
        print(f'No agent activity for {minutes} minutes; stopping this worker', flush=True)
        os.sync()
        try:
            stopped = stop_worker(pod_id, key)
        # Any failure of this one request is retried; an escaping error would end the worker.
        except Exception as error:
            print('Stop request failed: ' + type(error).__name__, flush=True)
            stopped = False
        # A stopped worker ends this process. Still running later means the stop did not
        # take effect, so a later idle check requests it again.
        print('Stop requested' if stopped else 'Retrying the stop later', flush=True)
        next_request = now + RETRY_SECONDS


if __name__ == '__main__':
    sys.exit(main())
