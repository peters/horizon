# Worker helpers built from a public Horizon revision, published as
# ghcr.io/peters/horizon-worker-helpers. The build needs no context:
#   docker build --build-arg HORIZON_REVISION=<commit> --target helpers - < Dockerfile.helpers
# A recipe copies the published image, pinned by digest, over its own base:
#   COPY --from=ghcr.io/peters/horizon-worker-helpers@sha256:<digest> / /
ARG HORIZON_REVISION

FROM rust:1.99.0-slim-bookworm@sha256:452176c0cefca88c0b3184ce85a4eb03e3d4fa05d2afb5366abcba853221019e AS build
ARG HORIZON_REVISION
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config nasm libssl-dev libxkbcommon-dev git ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*
# The image bootstraps rustup; the fetched repository's toolchain file selects the build compiler.
# Debian 12 links the helpers against glibc 2.36, so they run on any base the checker accepts.
RUN printf '%s\n' "$HORIZON_REVISION" | grep -Eqx '[0-9a-f]{40}' \
        || { echo 'HORIZON_REVISION must be a full 40-character commit' >&2; exit 1; }
RUN git init -q /src && git -C /src fetch -q --depth 1 https://github.com/peters/horizon.git "$HORIZON_REVISION" \
    && git -C /src -c advice.detachedHead=false checkout -q FETCH_HEAD \
    && cd /src && GIT_LFS_SKIP_SMUDGE=1 CARGO_HOME=/tmp/helper-cargo cargo build --locked --release \
        -p horizon-cloud-worker -p horizon-browser-cli -p horizon-device --features horizon-device/cli \
    && mkdir -p /output/usr/local/bin /output/usr/local/share/licenses/horizon \
    && install -m 755 -s target/release/horizon-cloud-worker target/release/horizon-browser \
        target/release/horizon-device /output/usr/local/bin/ \
    && install -m 755 examples/cloud-worker/horizon-worker-* /output/usr/local/bin/ \
    && ln -s /usr/local/bin/horizon-worker-git-auth /output/usr/local/bin/gh \
    && install -m 644 LICENSE /output/usr/local/share/licenses/horizon/LICENSE \
    && printf 'https://github.com/peters/horizon/tree/%s\n' "$HORIZON_REVISION" \
        > /output/usr/local/share/licenses/horizon/SOURCE \
    # The same revision's collector copies every dependency's notices, as the worker images do.
    && python3 .horizon/collect-helper-notices.py \
    && mv /output/share/licenses/horizon-dependencies /output/usr/local/share/licenses/ \
    && rmdir /output/share/licenses /output/share \
    && rm -rf /src /tmp/helper-cargo

FROM scratch AS helpers
ARG HORIZON_REVISION
COPY --from=build /output/ /
LABEL org.opencontainers.image.source="https://github.com/peters/horizon" \
    org.opencontainers.image.revision="${HORIZON_REVISION}" \
    org.opencontainers.image.description="Horizon cloud worker helpers and scripts for COPY --from into a worker recipe"

# Smallest base that meets the worker contract, used to check the published layout
# before it is pushed. It is never published.
FROM tailscale/tailscale:v1.102.5@sha256:c507f3a2a6ab1cabd8d809b98edeb41edbd5c3fb6ad9632ffd098b4c7d0b4065 AS tailnet-runtime
FROM ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3 AS probe
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-server openssh-client tmux git git-lfs gh ca-certificates python3 util-linux \
        xvfb openbox x11vnc x11-utils \
    && rm -rf /var/lib/apt/lists/*
COPY --from=helpers / /
COPY --from=tailnet-runtime /usr/local/bin/tailscale /usr/local/bin/tailscaled /usr/local/bin/
RUN groupadd --gid 10001 horizon-agent \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /bin/bash horizon-agent
RUN mkdir -p /etc/horizon-worker \
    && printf '%s\n' '{"agents":[],"browsers":[],"desktop":true}' > /etc/horizon-worker/capabilities.json \
    && horizon-browser --version && horizon-device --help > /dev/null \
    # With no command the worker prints its usage and exits 1; the exact line proves it loaded.
    && { horizon-cloud-worker 2>&1 || true; } | grep -q '^Cloud worker service: Usage: horizon-cloud-worker ' \
    && horizon-worker-check --git-auth
