#!/usr/bin/python3
"""Root service that keeps a GitHub App user token chain fresh while the host is offline and
gives agents the short-lived access token of their granted repositories over a Unix socket.
Agents never read the chain. Never prints a token. Operations: install (JSON on stdin),
serve (started by horizon-worker-supervise), status (JSON without secrets) and clear."""
import contextlib
import http.client
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import random
import re
import socket
import struct
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request


def load_common():
    name = 'horizon_worker_github_common'
    if name not in sys.modules:
        loader = importlib.machinery.SourceFileLoader(
            name, str(Path(__file__).resolve().with_name('horizon-worker-github-common')))
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
        sys.modules[name] = module
        loader.exec_module(module)
    return sys.modules[name]


common = load_common()
auth = common.auth
GIT_AUTH = common.GIT_AUTH
Store = common.Store
STATE = common.STATE
TEST_URL = common.TEST_URL
SOCKET = Path('/run/horizon-worker/github.sock')
LOG = 'requests.log'
# The grants an install is configuring, kept while it runs. A live install holds the store
# lock, so whoever gets the lock and still finds this file knows the install was cut off.
INTENT = 'install.intent'
LOG_LIMIT = 1 << 20
# Root, and the agent identity that horizon-worker-tailnet isolate gives every session.
ALLOWED_UIDS = (0, 10001)
ROOT_UID = 0
MAX_INSTALL = 65536
MAX_REQUEST = 8192
REFRESH_MARGIN = 30 * 60
# A token this close to its expiry is refused: Git or gh would fail with it mid-operation.
SERVE_MARGIN = 60
POLL_SECONDS = 60
RETRY_BASE_SECONDS = 15
RETRY_MAX_SECONDS = 15 * 60
# Start attempts and the first wait between them, before serve exits for the supervisor.
START_ATTEMPTS = 5
START_WAIT_SECONDS = 2
CONNECTIONS = 16
CLIENT_ID = re.compile(r'[A-Za-z0-9._-]{1,128}')
ERROR_CODE = re.compile(r'[a-z0-9_]{1,64}')
INSTALL_FIELDS = {'version', 'client_id', 'client_secret', 'login', 'author_name', 'author_email', 'grants', 'chain'}
# Fields an installation may leave out.
OPTIONAL_FIELDS = {'client_secret', 'login'}
LOGIN = re.compile(r'[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?')
GRANT_FIELDS = {'repository', 'target', 'access'}
ACCESS = ('push', 'read')


class Transient(Exception):
    """A refresh that did not reach GitHub or got no usable reply; it is retried."""


def validate_install(value, now):
    if not isinstance(value, dict) or not INSTALL_FIELDS - OPTIONAL_FIELDS <= set(value) <= INSTALL_FIELDS:
        raise ValueError('Invalid GitHub chain installation')
    if type(value['version']) is not int or value['version'] != 1:
        raise ValueError('Unsupported GitHub chain installation version')
    if not isinstance(value['client_id'], str) or not CLIENT_ID.fullmatch(value['client_id']):
        raise ValueError('Invalid GitHub App client')
    if 'client_secret' in value and not auth.valid_token(value['client_secret']):
        raise ValueError('Invalid GitHub App client')
    if 'login' in value and not (isinstance(value['login'], str) and LOGIN.fullmatch(value['login'])):
        raise ValueError('Invalid GitHub login')
    chain = common.validate_chain(value['chain'])
    if chain['refresh_expires_at'] <= now:
        raise ValueError('The GitHub token chain expired')
    grants = value['grants']
    if not isinstance(grants, list) or not 1 <= len(grants) <= auth.MAX_GRANTS:
        raise ValueError('Invalid GitHub grant list')
    repositories, targets = set(), set()
    for grant in grants:
        if not isinstance(grant, dict) or set(grant) != GRANT_FIELDS or grant['access'] not in ACCESS:
            raise ValueError('Invalid GitHub grant')
        # The Git helper's own checks: repository, token characters and identity.
        auth.validate({'repository': grant['repository'], 'token': chain['access_token'],
                       'author_name': value['author_name'], 'author_email': value['author_email']})
        auth.target_directory(grant['target'])
        if grant['repository'].casefold() in repositories or grant['target'] in targets:
            raise ValueError('Duplicate GitHub grant')
        repositories.add(grant['repository'].casefold())
        targets.add(grant['target'])
    return value


def token_endpoint(environ):
    base, _, loopback = common.github_bases(environ)
    return base + '/login/oauth/access_token', loopback


def post_refresh(form, environ=os.environ, timeout=30):
    """GitHub's JSON reply to one refresh. OAuth errors arrive as HTTP 200 with `error`."""
    url, loopback = token_endpoint(environ)
    request = urllib.request.Request(url, data=urllib.parse.urlencode(form).encode(), method='POST', headers={
        'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded',
        'User-Agent': 'horizon-worker-github/1'})
    try:
        with common.opener(loopback).open(request, timeout=timeout) as response:
            body = response.read(MAX_REQUEST * 8 + 1)
    except (OSError, http.client.HTTPException) as error:
        if isinstance(error, urllib.error.HTTPError):
            error.close()
        raise Transient('transport') from None
    try:
        reply = json.loads(body) if len(body) <= MAX_REQUEST * 8 else None
    except ValueError:
        reply = None
    if not isinstance(reply, dict):
        raise Transient('malformed_reply')
    return reply


def rotated_chain(reply, now):
    access, refresh = reply.get('access_token'), reply.get('refresh_token')
    lifetime, refresh_lifetime = reply.get('expires_in'), reply.get('refresh_token_expires_in')
    if (not auth.valid_token(access) or not auth.valid_token(refresh)
            or not common.timestamp(lifetime) or not common.timestamp(refresh_lifetime)
            or str(reply.get('token_type', 'bearer')).lower() != 'bearer'):
        raise Transient('malformed_reply')
    return {'access_token': access, 'access_expires_at': now + lifetime,
            'refresh_token': refresh, 'refresh_expires_at': now + refresh_lifetime}


def refresh_once(store, now=time.time, post=post_refresh):
    """One refresh check: 'absent', 'revoked', 'fresh', 'refreshed' or 'retry'."""
    with store.lock():
        state, _ = store.load()
        if state is None:
            return 'absent'
        if state['state'] != 'ok':
            return 'revoked'
        started = int(now())
        chain = state['chain']
        if chain['refresh_expires_at'] <= started:
            store.save(dict(state, state='revoked', last_error='refresh_expired'))
            return 'revoked'
        if chain['access_expires_at'] - started > REFRESH_MARGIN:
            return 'fresh'
        form = {'client_id': state['client_id'], 'grant_type': 'refresh_token',
                'refresh_token': chain['refresh_token']}
        # Only a chain from a web sign-in carries a secret; a device flow chain refreshes without one.
        if state.get('client_secret'):
            form['client_secret'] = state['client_secret']
        try:
            reply = post(form)
            error = reply.get('error')
            if error is None:
                rotated = rotated_chain(reply, started)
        except Transient as failure:
            store.save(dict(state, last_error=str(failure)))
            return 'retry'
        if error is not None:
            code = error if isinstance(error, str) and ERROR_CODE.fullmatch(error) else 'unknown_error'
            if code == 'bad_refresh_token':
                store.save(dict(state, state='revoked', last_error=code))
                return 'revoked'
            store.save(dict(state, last_error=code))
            return 'retry'
        # GitHub already invalidated the old chain: store the new one before any agent can use it.
        store.save(dict(state, chain=rotated, last_refresh_at=started, last_error=None))
        return 'refreshed'


def retry_delay(failures, jitter=random.random):
    ceiling = min(RETRY_MAX_SECONDS, RETRY_BASE_SECONDS * 2 ** min(failures - 1, 16))
    return ceiling * (0.5 + jitter() / 2)


def next_check(store, now):
    state, _ = store.load()
    if state is None or state['state'] != 'ok':
        return POLL_SECONDS
    due = state['chain']['access_expires_at'] - REFRESH_MARGIN - now
    return max(1, min(POLL_SECONDS, due))


def refresh_step(store, failures, now=time.time, post=post_refresh, jitter=random.random, log=print,
                 configure=None, static=None):
    """One refresh check; returns (delay before the next check, consecutive failures)."""
    try:
        # An install that was cut off, such as by a closed SSH connection, left repositories
        # configured for a chain it never stored; the stored state decides again.
        with store.lock():
            if (store.runtime / INTENT).exists():
                settle(store, configure or run_configure, static or run_restore)
                log('GitHub repositories reconciled after an interrupted install', flush=True)
    except Exception as error:
        log('GitHub repositories not reconciled: ' + type(error).__name__, flush=True)
    try:
        # A rotated chain that no storage accepted is written again at every check.
        with store.lock():
            store.retry_pending()
    except Exception as error:
        log('GitHub token chain still not stored: ' + type(error).__name__, flush=True)
    try:
        outcome = refresh_once(store, now, post)
    # Storage or lock failures are retried; the refresh thread must never end.
    except Exception as error:
        log('GitHub refresh failed: ' + type(error).__name__, flush=True)
        outcome = 'retry'
    if outcome == 'retry':
        failures += 1
        return retry_delay(failures, jitter), failures
    if outcome in ('refreshed', 'revoked'):
        log('GitHub token chain ' + outcome, flush=True)
    return next_check(store, now()), 0


def refresh_loop(store, sleep=time.sleep):
    failures = 0
    while True:
        delay, failures = refresh_step(store, failures)
        sleep(delay)


def refusal(state, message):
    return {'ok': False, 'state': state, 'message': message}


def request_path(path):
    """(repository path, whether it names a push) for a credential request path."""
    path = path.strip('/')
    push = False
    for suffix in ('/info/refs', '/git-receive-pack', '/git-upload-pack'):
        if path.endswith(suffix):
            push = push or suffix == '/git-receive-pack'
            path = path[:-len(suffix)]
    if '?' in path:
        path, query = path.split('?', 1)
        push = push or 'git-receive-pack' in query
    return path.removesuffix('.git'), push


def granted(state, repository):
    if not isinstance(repository, str):
        return None
    return next((grant for grant in state['grants'] if auth.same_repository(repository, grant['repository'])), None)


def answer(request, state, now):
    """The reply to one agent request, and the repository it named for the log."""
    if not isinstance(request, dict) or request.get('request') not in ('credential', 'gh-token'):
        return refusal('refused', 'Malformed GitHub credential request.'), None
    if state is None:
        return refusal('absent', 'No GitHub token chain is installed on this worker.'), None
    if state['state'] != 'ok':
        return refusal('revoked', 'GitHub access on this worker was revoked; connect GitHub again in Horizon.'), None
    chain = state['chain']
    if chain['access_expires_at'] - now <= SERVE_MARGIN:
        return refusal('ok', 'The GitHub access token has expired or expires within a minute, and this worker '
                             'could not refresh it yet.'), None
    if request['request'] == 'credential':
        if request.get('protocol') != 'https' or request.get('host') != 'github.com':
            return refusal('ok', 'Only HTTPS access to github.com is granted.'), None
        repository, push = request_path(str(request.get('path', '')))
        grant = granted(state, repository)
        if grant is None:
            return refusal('ok', 'This repository has no GitHub grant on this worker.'), repository
        if push and grant['access'] != 'push':
            return refusal('ok', 'This repository is granted for reading only.'), repository
        return {'ok': True, 'state': 'ok', 'username': 'x-access-token', 'password': chain['access_token'],
                'expires_at': chain['access_expires_at']}, grant['repository']
    grant = granted(state, request.get('repository'))
    if grant is None:
        return refusal('ok', 'This repository has no GitHub grant on this worker.'), request.get('repository')
    return {'ok': True, 'state': 'ok', 'token': chain['access_token'], 'repository': grant['repository'],
            'access': grant['access'], 'expires_at': chain['access_expires_at']}, grant['repository']


def serve_request(request, store, now):
    """`answer` for the chain that may be served. A chain that exists but is not stored yet is
    refused as `unstored`, never as `absent`, which would send Git to the static file."""
    served = store.load(serving=True)[0]
    if served is None and store.load()[0] is not None:
        return refusal('unstored', 'The GitHub token chain is not stored yet; try again in a minute.'), None
    return answer(request, served, now)


def peer(connection):
    """(pid, uid) of the connecting process, as the kernel reports them."""
    pid, uid, _ = struct.unpack('3i', connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                                            struct.calcsize('3i')))
    return pid, uid


def log_request(directory, record):
    """One line per request without any token, in a root-only log that keeps two files."""
    path = directory / LOG
    with contextlib.suppress(FileNotFoundError):
        if path.lstat().st_size > LOG_LIMIT:
            os.replace(path, directory / (LOG + '.1'))
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    with os.fdopen(fd, 'a') as output:
        output.write(json.dumps(record, separators=(',', ':')) + '\n')


def handle(connection, store):
    pid, uid = peer(connection)
    connection.settimeout(5)
    with connection.makefile('rb') as stream:
        line = stream.readline(MAX_REQUEST + 1)
    try:
        request = json.loads(line) if len(line) <= MAX_REQUEST else None
    except ValueError:
        request = None
    now = time.time()
    if uid not in ALLOWED_UIDS:
        reply, repository = refusal('refused', 'This account may not use GitHub access on this worker.'), None
    elif isinstance(request, dict) and request.get('request') == 'status':
        # Only root (the host's status command) reads the status of the serving process.
        reply = dict(status(store), ok=True) if uid == ROOT_UID else refusal('refused', 'Only root reads the status.')
        repository = None
    else:
        reply, repository = serve_request(request, store, now)
    kind = request.get('request') if isinstance(request, dict) else None
    with contextlib.suppress(OSError):
        log_request(store.runtime, {'at': int(now), 'uid': uid, 'pid': pid,
                                    'request': kind if kind in ('credential', 'gh-token', 'status') else 'invalid',
                                    'repository': repository if auth.valid_repository(repository) else None,
                                    'granted': reply['ok']})
    connection.sendall((json.dumps(reply) + '\n').encode())


def listen(path):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.unlink(missing_ok=True)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(path))
    # Any account may connect; the kernel's peer credentials decide who gets an answer.
    path.chmod(0o666)
    server.listen(CONNECTIONS)
    return server


def accept_forever(server, store):
    slots = threading.BoundedSemaphore(CONNECTIONS)

    def run(connection):
        try:
            with connection:
                handle(connection, store)
        # One bad client must not end the service.
        except Exception as error:
            print('GitHub request failed: ' + type(error).__name__, flush=True)
        finally:
            slots.release()

    while True:
        try:
            connection, _ = server.accept()
        except OSError as error:
            if server.fileno() < 0:
                return
            print('GitHub socket accept failed: ' + type(error).__name__, flush=True)
            time.sleep(1)
            continue
        slots.acquire()
        threading.Thread(target=run, args=(connection,), daemon=True).start()


def start(store, path, sleep=None, prepare=None):
    """The listening socket, after up to START_ATTEMPTS tries with doubled waits, or None.
    `prepare` runs after the checks and before the socket exists, until it succeeds once."""
    sleep, attempts, wait = sleep or time.sleep, START_ATTEMPTS, START_WAIT_SECONDS
    for attempt in range(attempts):
        try:
            if not common.AGENT_ISOLATION.exists():
                raise ValueError('Agent isolation is not active')
            common.github_bases(os.environ)
            common.private_directory(store.runtime, create=True)
            # Repeated on the next attempt when it fails: the socket never opens before it is done.
            if prepare is not None:
                prepare()
                prepare = None
            return listen(path)
        except (OSError, ValueError) as error:
            print('GitHub access cannot start: ' + type(error).__name__, flush=True)
            if attempt + 1 < attempts:
                sleep(wait * 2 ** attempt)
    return None


def serve(store=None, path=SOCKET):
    """Runs for the worker's life. Returns 1 when it cannot start; the supervisor then drops
    the service and the Git helper falls back to its private file."""
    store = store or Store()
    # The socket opens only after the repositories match the stored chain, so the supervisor
    # never publishes a service that does not answer yet.
    server = start(store, path, prepare=lambda: reconcile(store))
    if server is None:
        return 1
    threading.Thread(target=refresh_loop, args=(store,), daemon=True).start()
    accept_forever(server, store)
    return 0


def reconcile(store, configure=None, static=None):
    """Configures the repositories for the stored chain, or for the static binding without
    one. An install that stopped between its configuration and its save left the
    repositories configured for a chain that was never stored; the stored state decides.
    Raises ValueError when that fails, so the service does not open its socket over
    repositories configured for another chain."""
    try:
        with store.lock():
            settle(store, configure or run_configure, static or run_restore)
    except Exception as error:
        raise ValueError('GitHub repositories not reconciled: ' + type(error).__name__) from None


def settle(store, configure, static):
    """Under the store lock: configures the repositories for the stored chain, or for the
    static binding without one, after forgetting the identities that a cut-off install
    wrote, then drops that install's intent."""
    try:
        intent = common.read_json(store.runtime / INTENT)
    except (OSError, ValueError, RecursionError):
        intent = None
    intended = intent.get('grants') if isinstance(intent, dict) and isinstance(intent.get('grants'), list) else []
    state, _ = store.load()
    # The repositories follow the stored grants whether or not the chain can be served now.
    if state is not None:
        configure({'grants': identity_grants(state), 'previous': intended})
    else:
        static({'previous': intended})
    (store.runtime / INTENT).unlink(missing_ok=True)


def run_configure(payload):
    # The Git helper runs as the agent under isolation, because the agent owns the repositories.
    subprocess.run([str(GIT_AUTH), 'configure'], input=json.dumps(payload).encode(), check=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120)


def run_restore(payload):
    # As the agent, like the configuration it undoes.
    subprocess.run([str(GIT_AUTH), 'restore'], input=json.dumps(payload).encode(), check=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120)


def run_retire():
    # The static binding belongs to the agent under isolation, so the Git helper removes it.
    subprocess.run([str(GIT_AUTH), 'clear'], check=True, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, timeout=60)


def identity_grants(state):
    return [{'repository': grant['repository'], 'target': grant['target'],
             'author_name': state['author_name'], 'author_email': state['author_email']}
            for grant in (state or {}).get('grants', [])]


def install(value, store, now=time.time, configure=run_configure, retire=run_retire, static=run_restore):
    """Configures each target repository, stores the chain, then retires the static binding.

    The previous chain stays stored and served while the repositories are configured, so no
    agent gets the new token before they are, and a worker that stops midway still holds the
    previous chain. A failed configuration or save configures the previous chain's
    repositories again, as far as that works, and keeps the previous chain. The static
    binding goes last; one that cannot be removed stays as a fallback, which the service
    overrides whenever it answers. Returns status."""
    validate_install(value, int(now()))
    with store.lock():
        try:
            previous, _ = store.load()
        except (OSError, ValueError):
            previous = None
        state = {key: value[key] for key in ('client_id', 'author_name', 'author_email', 'grants', 'chain')}
        if value.get('client_secret'):
            state['client_secret'] = value['client_secret']
        if value.get('login'):
            state['login'] = value['login']
        # Written before any repository changes; if this process dies before its end, the
        # service's next check finds it and reconciles. Without it nothing changes.
        try:
            common.write_private(common.private_directory(store.runtime, create=True), INTENT,
                                 json.dumps({'grants': identity_grants(value)}))
        except common.Unsynced:
            pass  # In place on tmpfs, which needs no crash durability.
        except (OSError, ValueError):
            raise ValueError('No private GitHub storage accepted the install intent') from None
        try:
            configure({'grants': identity_grants(value), 'previous': identity_grants(previous)})
            store.save(dict(state, version=1, state='ok', installed_at=int(now()), last_refresh_at=None,
                            last_error=None), retain=False)
        except BaseException:
            restored = restore(previous, value, configure, static)
            keep(store, previous)
            # A rollback that did not finish leaves the intent, so the service still finishes it.
            if restored:
                (store.runtime / INTENT).unlink(missing_ok=True)
            raise
        (store.runtime / INTENT).unlink(missing_ok=True)
        try:
            retire()
        except (OSError, subprocess.SubprocessError):
            print('horizon-worker-github: the static Git binding could not be removed; the service '
                  'still answers first.', file=sys.stderr)
    return status(store)


def restore(previous, value, configure, static):
    """Configures the previous chain's repositories again after a failed install, as far as
    that works; `keep` puts the previous chain itself back when a save replaced it. Without a
    previous chain the static binding's configuration comes back, which the failed install's
    configuration replaced. Returns whether that worked."""
    try:
        if previous is not None:
            configure({'grants': identity_grants(previous), 'previous': identity_grants(value)})
        else:
            static({'previous': identity_grants(value)})
    except Exception:
        return False
    return True


def keep(store, previous):
    """After a failed save, removes a copy of the new chain that no storage confirmed, so the
    previous chain, or none, stays the stored one. Runs under the store lock."""
    with contextlib.suppress(Exception):
        current, _ = store.load()
        if current is not None and current != previous:
            if previous is None:
                store.clear()
            else:
                store.save(previous, retain=False)


def status(store):
    state, persistent = store.load()
    if state is None:
        return {'version': 1, 'state': 'absent', 'persistent': False, 'pending_write': False, 'login': None,
                'access_expires_at': None, 'refresh_expires_at': None, 'last_refresh_at': None, 'last_error': None,
                'repositories': []}
    return {'version': 1, 'state': state['state'], 'persistent': persistent, 'pending_write': store.pending_write(),
            'login': state.get('login'), 'access_expires_at': state['chain']['access_expires_at'],
            'refresh_expires_at': state['chain']['refresh_expires_at'],
            'last_refresh_at': state.get('last_refresh_at'), 'last_error': state.get('last_error'),
            'repositories': [{key: grant[key] for key in ('repository', 'target', 'access')}
                             for grant in state['grants']]}


def host_status(store, path=SOCKET):
    """The serving process's status, which also sees a chain that only its memory holds, with
    `serving`. Without an answer, the status of the stored copies."""
    reply = auth.call_service({'request': 'status'}, path)
    if isinstance(reply, dict) and reply.pop('ok', None) is True:
        return dict(reply, serving=True)
    return dict(status(store), serving=False)


def clear(store, retire=None):
    """Removes the static Git binding first, then the chain. When the binding cannot be
    removed, the chain stays, so agents never keep access while status reports none."""
    (retire or run_retire)()
    with store.lock():
        store.clear()


def main(argv):
    if len(argv) != 1 or argv[0] not in ('install', 'serve', 'status', 'clear'):
        print('Usage: horizon-worker-github install|serve|status|clear', file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print('horizon-worker-github runs as root only.', file=sys.stderr)
        return 1
    os.umask(0o077)
    store = Store()
    if argv[0] == 'serve':
        return serve(store)
    elif argv[0] == 'install':
        # Without agent isolation agents run as root, so no chain may come to this worker.
        if not common.AGENT_ISOLATION.exists():
            raise ValueError('GitHub access requires agent isolation')
        source = sys.stdin.buffer.read(MAX_INSTALL + 1)
        if len(source) > MAX_INSTALL:
            raise ValueError('GitHub chain installation is too large')
        print(json.dumps(install(auth.parse(source.decode()), store), separators=(',', ':')))
    elif argv[0] == 'status':
        print(json.dumps(host_status(store), separators=(',', ':')))
    else:
        clear(store)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except (ValueError, OSError, RecursionError, UnicodeDecodeError, subprocess.SubprocessError):
        print('Worker GitHub access failed; inspect the chain installation, target repositories and '
              'private storage.', file=sys.stderr)
        sys.exit(1)
