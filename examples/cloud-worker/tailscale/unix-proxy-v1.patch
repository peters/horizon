+func TestHorizonUnixUnsupportedMeteredHalfCloseRefuses(t *testing.T) {
+	front, peer := net.Pipe()
+	defer front.Close()
+	defer peer.Close()
+	back, receiver, err := horizonCancellationPair()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer back.Close()
+	defer receiver.Close()
+	if err := forwardHorizonUnix(context.Background(), &serviceMeteredConn{Conn: front}, back, []byte("PROXY ")); err == nil {
+		t.Fatal("metered wrapper hid unsupported CloseWrite")
+	}
+}
+
+func awaitBlockedHorizonHeader(t *testing.T, done <-chan error) {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	stack := make([]byte, 1024*1024)
+	for time.Now().Before(deadline) {
+		select {
+		case err := <-done:
+			t.Fatalf("header send returned before cancellation: %v", err)
+		default:
+		}
+		n := runtime.Stack(stack, true)
+		for _, goroutine := range bytes.Split(stack[:n], []byte("\n\n")) {
+			trace := string(goroutine)
+			if strings.Contains(trace, "sendHorizonHeader.func1") && strings.Contains(trace, "WriteMsgUnix") && strings.Contains(trace, "internal/poll.runtime_pollWait") {
+				return
+			}
+		}
+		runtime.Gosched()
+	}
+	t.Fatal("original descriptor send was not observed blocked in network poll")
+}
