+
+const horizonFlowDrained byte = 0x01
+
+// forwardHorizonUnix retains the original payload connections until both write
+// halves drain, or the separate descriptor channel explicitly cancels the flow.
+func forwardHorizonUnix(ctx context.Context, front net.Conn, back *net.UnixConn, header []byte) error {
+	underlying := front
+	for {
+		metered, ok := underlying.(*serviceMeteredConn)
+		if !ok {
+			break
+		}
+		underlying = metered.Conn
+	}
+	frontWrite, ok := underlying.(interface{ CloseWrite() error })
+	if !ok {
+		return fmt.Errorf("Horizon flow cancellation requires frontend write-half close support")
+	}
+	if len(header) == 0 || header[0] != 'P' {
+		return fmt.Errorf("Horizon flow cancellation requires a PROXY1 header")
+	}
+	cancelRead, passedEnd, err := horizonCancellationPair()
+	if err != nil {
+		return err
+	}
+	defer cancelRead.Close()
+	cancelled := make(chan error, 1)
+	go func() {
+		var byte [1]byte
+		n, err := cancelRead.Read(byte[:])
+		if n != 0 {
+			err = fmt.Errorf("unexpected data on Horizon cancellation channel")
+		} else if err == io.EOF {
+			err = fmt.Errorf("Horizon consumer cancelled the flow")
+		} else if err == nil {
+			err = io.ErrNoProgress
+		}
+		cancelled <- err
+	}()
+	copied := make(chan error, 2)
+	go func() {
+		// This goroutine exclusively owns passedEnd. Closing back interrupts an
+		// in-flight send; nobody races a close/reused FD with SCM_RIGHTS.
+		err := sendHorizonHeader(back, passedEnd, header)
+		if err == nil {
+			_, err = io.Copy(back, front)
+		}
+		if err == nil {
+			err = back.CloseWrite()
+		}
+		copied <- err
+	}()
+	go func() {
+		_, err := io.Copy(front, back)
+		if err == nil {
+			err = frontWrite.CloseWrite()
+		}
+		copied <- err
+	}()
+	var result error
+	stopped := false
+	stop := func(err error) {
+		if stopped {
+			return
+		}
+		stopped = true
+		result = err
+		front.Close()
+		back.Close()
+		cancelRead.Close()
+	}
+	cancelResult := cancelled
+	contextDone := ctx.Done()
+	for remaining := 2; remaining > 0; {
+		select {
+		case err := <-copied:
+			remaining--
+			if err != nil {
+				stop(err)
+			}
+		case err := <-cancelResult:
+			cancelResult = nil
+			stop(err)
+		case <-contextDone:
+			contextDone = nil
+			stop(ctx.Err())
+		}
+	}
+	// Both copies and their CloseWrite have succeeded before a normal commit.
+	// The receiver must retain its endpoint until this acknowledgement and EOF.
+	if !stopped {
+		select {
+		case err := <-cancelResult:
+			cancelResult = nil
+			stop(err)
+		default:
+		}
+		if err := ctx.Err(); err != nil {
+			stop(err)
+		}
+		if !stopped {
+			n, err := cancelRead.Write([]byte{horizonFlowDrained}) // DRAINED; never payload data.
+			if err == nil && n != 1 {
+				err = io.ErrShortWrite
+			}
+			if err != nil {
+				stop(err)
+			}
+		}
+	}
+	cancelRead.Close()
+	if cancelResult != nil {
+		// Local Close induces net.ErrClosed. Peer EOF/unexpected data retain
+		// their distinct meaningful failure, including a cancellation race.
+		if err := <-cancelResult; !stopped && !errors.Is(err, net.ErrClosed) {
+			stop(err)
+		}
+	}
+	if err := ctx.Err(); err != nil && !stopped {
+		stop(err)
+	}
+	return result
+}
+
+func horizonCancellationPair() (*net.UnixConn, *net.UnixConn, error) {
+	fds, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_STREAM|unix.SOCK_CLOEXEC|unix.SOCK_NONBLOCK, 0)
+	if err != nil {
+		return nil, nil, err
+	}
+	wrap := func(fd int) (*net.UnixConn, error) {
+		file := os.NewFile(uintptr(fd), "horizon-flow-cancel")
+		conn, err := net.FileConn(file)
+		// FileConn duplicates the same original socket; retire the temporary
+		// handle immediately, leaving exactly one live local owner per end.
+		file.Close()
+		if err != nil {
+			return nil, err
+		}
+		c, ok := conn.(*net.UnixConn)
+		if !ok {
+			conn.Close()
+			return nil, fmt.Errorf("cancellation socket is not Unix")
+		}
+		return c, nil
+	}
+	reader, err := wrap(fds[0])
+	if err != nil {
+		unix.Close(fds[1])
+		return nil, nil, err
+	}
+	passed, err := wrap(fds[1])
+	if err != nil {
+		reader.Close()
+		return nil, nil, err
+	}
+	return reader, passed, nil
+}
+
+func sendHorizonHeader(back, passedEnd *net.UnixConn, header []byte) error {
+	defer passedEnd.Close()
+	raw, err := passedEnd.SyscallConn()
+	if err != nil {
+		return err
+	}
+	var sendErr error
+	// The FD is valid only inside Control. Cancellation closes back to unblock
+	// WriteMsgUnix, then this sole owner closes passedEnd after Control returns.
+	err = raw.Control(func(fd uintptr) {
+		rights := unix.UnixRights(int(fd))
+		n, oobn, err := back.WriteMsgUnix(header[:1], rights, nil)
+		if err != nil {
+			sendErr = err
+		} else if n != 1 || oobn != len(rights) {
+			sendErr = io.ErrShortWrite
+		}
+	})
+	if err != nil {
+		return err
+	}
+	if sendErr != nil {
+		return sendErr
+	}
+	// Do not retain a local peer-end copy while forwarding application bytes.
+	passedEnd.Close()
+	n, err := back.Write(header[1:])
+	if err == nil && n != len(header)-1 {
+		err = io.ErrShortWrite
+	}
+	return err
+}
