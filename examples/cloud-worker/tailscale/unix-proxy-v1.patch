+func TestHorizonUnixReceiverExit(t *testing.T) {
+	if os.Getenv("HORIZON_CANCEL_ENDPOINT_CHILD") == "1" {
+		os.Exit(0)
+	}
+	f := newHorizonFlow(t, false)
+	file, err := f.cancel.File()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestHorizonUnixReceiverExit$")
+	cmd.Env = append(os.Environ(), "HORIZON_CANCEL_ENDPOINT_CHILD=1")
+	cmd.ExtraFiles = []*os.File{file}
+	cmd.Stdout = io.Discard
+	cmd.Stderr = io.Discard
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	file.Close()
+	f.cancel.Close()
+	if err := cmd.Wait(); err != nil {
+		t.Fatal(err)
+	}
+	f.finished(t, true)
+}
