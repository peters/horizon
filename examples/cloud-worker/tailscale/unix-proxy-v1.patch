+func TestHorizonFlowCancelCLI(t *testing.T) {
+	lc := &fakeLocalServeClient{}
+	var flagOut bytes.Buffer
+	if runtime.GOOS != "linux" {
+		err := newServeV2Command(&serveEnv{lc: lc, testFlagOut: &flagOut}, serve).ParseAndRun(t.Context(), []string{"--tcp=20000", "--proxy-protocol=1", "--horizon-flow-cancel", "--bg", "unix:/run/original.sock"})
+		if err == nil || lc.setCount != 0 {
+			t.Fatalf("unsupported opt-in mutated config: %v", err)
+		}
+		return
+	}
+	if err := newServeV2Command(&serveEnv{lc: lc, testFlagOut: &flagOut}, serve).ParseAndRun(t.Context(), []string{"--tcp=20000", "--proxy-protocol=1", "--horizon-flow-cancel", "--bg", "unix:/run/original.sock"}); err != nil {
+		t.Fatal(err)
+	}
+	if !lc.config.TCP[20000].HorizonFlowCancel {
+		t.Fatal("CLI did not persist explicit opt-in")
+	}
+	before, err := json.Marshal(lc.config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	count := lc.setCount
+	for _, args := range [][]string{
+		{"--tcp=20000", "--horizon-flow-cancel", "--bg", "unix:/run/replacement.sock"},
+		{"--tcp=20000", "--proxy-protocol=2", "--horizon-flow-cancel", "--bg", "unix:/run/replacement.sock"},
+		{"--tcp=20000", "--proxy-protocol=1", "--horizon-flow-cancel", "--bg", "tcp://localhost:8080"},
+		{"--tls-terminated-tcp=20000", "--proxy-protocol=1", "--horizon-flow-cancel", "--bg", "unix:/run/replacement.sock"},
+		{"--http=20000", "--horizon-flow-cancel", "--bg", "http://localhost:8080"},
+	} {
+		if err := newServeV2Command(&serveEnv{lc: lc, testFlagOut: &flagOut}, serve).ParseAndRun(t.Context(), args); err == nil {
+			t.Fatalf("invalid flags accepted: %v", args)
+		}
+		after, err := json.Marshal(lc.config)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if lc.setCount != count || !bytes.Equal(before, after) {
+			t.Fatalf("rejected update mutated original route: %v", args)
+		}
+	}
+	if err := newServeV2Command(&serveEnv{lc: lc, testFlagOut: &flagOut}, funnel).ParseAndRun(t.Context(), []string{"--horizon-flow-cancel", "443"}); err == nil {
+		t.Fatal("Funnel accepted private flow flag")
+	}
+	if lc.setCount != count {
+		t.Fatal("Funnel rejection mutated config")
+	}
+	// Omitting the opt-in explicitly returns this route to ordinary Unix PROXY1.
+	if err := newServeV2Command(&serveEnv{lc: lc, testFlagOut: &flagOut}, serve).ParseAndRun(t.Context(), []string{"--tcp=20000", "--proxy-protocol=1", "--bg", "unix:/run/original.sock"}); err != nil {
+		t.Fatal(err)
+	}
+	if lc.config.TCP[20000].HorizonFlowCancel {
+		t.Fatal("ordinary route retained stale opt-in")
+	}
+}
