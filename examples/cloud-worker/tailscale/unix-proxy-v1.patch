+func TestHorizonFlowCancelFunnelScopes(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("other platforms reject every opt-in")
+	}
+	for _, scope := range []string{"same", "foreground-handler", "foreground-funnel", "siblings", "nested"} {
+		t.Run(scope, func(t *testing.T) {
+			h := &TCPPortHandler{TCPForward: "unix:/run/private/producer.sock", ProxyProtocol: 1, HorizonFlowCancel: true}
+			handler := &ServeConfig{TCP: map[uint16]*TCPPortHandler{20000: h}}
+			funnel := &ServeConfig{AllowFunnel: map[HostPort]bool{"different-host.ts.net:20000": true}}
+			var sc *ServeConfig
+			switch scope {
+			case "same":
+				sc = handler
+				sc.AllowFunnel = funnel.AllowFunnel
+			case "foreground-handler":
+				sc = funnel
+				sc.Foreground = map[string]*ServeConfig{"handler": handler}
+			case "foreground-funnel":
+				sc = handler
+				sc.Foreground = map[string]*ServeConfig{"funnel": funnel}
+			case "siblings":
+				sc = &ServeConfig{Foreground: map[string]*ServeConfig{"handler": handler, "funnel": funnel}}
+			case "nested":
+				sc = funnel
+				sc.Foreground = map[string]*ServeConfig{"outer": {Foreground: map[string]*ServeConfig{"handler": handler}}}
+			}
+			if err := sc.CheckHorizonFlowCancel(); err == nil {
+				t.Fatal("Funnel can route to opted-in handler across scopes")
+			}
+		})
+	}
+	// Distinct ports, disabled Funnel entries and separate VIP service handlers
+	// do not route public ingress to the node's opted-in payload connection.
+	h := &TCPPortHandler{TCPForward: "unix:/run/private/producer.sock", ProxyProtocol: 1, HorizonFlowCancel: true}
+	for _, sc := range []*ServeConfig{
+		{TCP: map[uint16]*TCPPortHandler{20000: h}, AllowFunnel: map[HostPort]bool{"example.ts.net:443": true}},
+		{TCP: map[uint16]*TCPPortHandler{20000: h}, AllowFunnel: map[HostPort]bool{"example.ts.net:20000": false}},
+		{Services: map[tailcfg.ServiceName]*ServiceConfig{"svc:private": {TCP: map[uint16]*TCPPortHandler{20000: h}}}, AllowFunnel: map[HostPort]bool{"example.ts.net:20000": true}},
+	} {
+		if err := sc.CheckHorizonFlowCancel(); err != nil {
+			t.Fatalf("unrelated Funnel rejected: %v", err)
+		}
+	}
+}
