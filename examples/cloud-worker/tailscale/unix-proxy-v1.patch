+func TestHorizonUnixHalfClose(t *testing.T) {
+	for _, userspace := range []bool{false, true} {
+		name := "kernel"
+		if userspace {
+			name = "gonet"
+		}
+		t.Run(name+"-request-EOF-delayed-response", func(t *testing.T) {
+			f := newHorizonFlow(t, userspace)
+			if _, err := io.WriteString(f.client, "request"); err != nil {
+				t.Fatal(err)
+			}
+			if err := f.client.CloseWrite(); err != nil {
+				t.Fatal(err)
+			}
+			request, err := io.ReadAll(f.back)
+			if err != nil || string(request) != "request" {
+				t.Fatalf("request = %q, %v", request, err)
+			}
+			// The response is deliberately sent only after the backend sees request EOF.
+			if _, err := io.WriteString(f.back, "delayed response"); err != nil {
+				t.Fatal(err)
+			}
+			if err := f.back.CloseWrite(); err != nil {
+				t.Fatal(err)
+			}
+			response, err := io.ReadAll(f.client)
+			if err != nil || string(response) != "delayed response" {
+				t.Fatalf("response = %q, %v", response, err)
+			}
+			f.finished(t, false)
+		})
+		t.Run(name+"-reverse-EOF-still-writable", func(t *testing.T) {
+			f := newHorizonFlow(t, userspace)
+			if err := f.back.CloseWrite(); err != nil {
+				t.Fatal(err)
+			}
+			response, err := io.ReadAll(f.client)
+			if err != nil || len(response) != 0 {
+				t.Fatalf("reverse EOF = %q, %v", response, err)
+			}
+			if _, err := io.WriteString(f.client, "after reverse EOF"); err != nil {
+				t.Fatal(err)
+			}
+			if err := f.client.CloseWrite(); err != nil {
+				t.Fatal(err)
+			}
+			request, err := io.ReadAll(f.back)
+			if err != nil || string(request) != "after reverse EOF" {
+				t.Fatalf("request = %q, %v", request, err)
+			}
+			f.finished(t, false)
+		})
+	}
+}
+
+func TestHorizonUnixCancellation(t *testing.T) {
+	for _, mode := range []string{"idle", "unexpected-byte", "context", "response-write-blocked-after-request-EOF", "frontend-read-error", "frontend-write-error", "half-close-error"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newHorizonFlow(t, false)
+			switch mode {
+			case "idle":
+				f.cancel.Close()
+			case "unexpected-byte":
+				if _, err := f.cancel.Write([]byte{1}); err != nil {
+					t.Fatal(err)
+				}
+			case "context":
+				f.shutdown()
+			case "response-write-blocked-after-request-EOF":
+				if err := f.client.CloseWrite(); err != nil {
+					t.Fatal(err)
+				}
+				if data, err := io.ReadAll(f.back); err != nil || len(data) != 0 {
+					t.Fatalf("request EOF: %q, %v", data, err)
+				}
+				f.front.blockWrite.Store(true)
+				if _, err := io.WriteString(f.back, "buffered response"); err != nil {
+					t.Fatal(err)
+				}
+				select {
+				case <-f.front.writeEntered:
+				case <-time.After(5 * time.Second):
+					t.Fatal("response write did not block")
+				}
+				f.cancel.Close()
+			case "frontend-read-error":
+				// Wake the already-blocked original read, then fail the next copy read.
+				f.front.failRead.Store(true)
+				if _, err := io.WriteString(f.client, "wake"); err != nil {
+					t.Fatal(err)
+				}
+			case "frontend-write-error":
+				f.front.failWrite.Store(true)
+				if _, err := io.WriteString(f.back, "response"); err != nil {
+					t.Fatal(err)
+				}
+			case "half-close-error":
+				f.front.failHalf.Store(true)
+				if err := f.back.CloseWrite(); err != nil {
+					t.Fatal(err)
+				}
+			}
+			f.finished(t, true)
+		})
+	}
+}
+
+func TestHorizonUnixResponseDrainDoesNotTreatHUPAsCancel(t *testing.T) {
+	f := newHorizonFlow(t, false)
+	if err := f.client.CloseWrite(); err != nil {
+		t.Fatal(err)
+	}
+	if data, err := io.ReadAll(f.back); err != nil || len(data) != 0 {
+		t.Fatalf("request EOF: %q, %v", data, err)
+	}
+	f.front.blockWrite.Store(true)
+	if _, err := io.WriteString(f.back, "response held across both half closes"); err != nil {
+		t.Fatal(err)
+	}
+	if err := f.back.CloseWrite(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-f.front.writeEntered:
+	case <-time.After(5 * time.Second):
+		t.Fatal("response write did not block")
+	}
+	if err := f.cancel.SetReadDeadline(time.Now().Add(30 * time.Millisecond)); err != nil {
+		t.Fatal(err)
+	}
+	var early [1]byte
+	if n, err := f.cancel.Read(early[:]); n != 0 || err == nil {
+		t.Fatalf("acknowledged a still-blocked response: %x, %v", early[:n], err)
+	} else if timeout, ok := err.(net.Error); !ok || !timeout.Timeout() {
+		t.Fatalf("control retired before response drain: %v", err)
+	}
+	if err := f.cancel.SetReadDeadline(time.Now().Add(5 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	// Both payload write halves are now closed, which can produce Unix POLLHUP.
+	// The explicit cancellation descriptor remains live; release the original write.
+	close(f.front.releaseWrite)
+	response, err := io.ReadAll(f.client)
+	if err != nil || string(response) != "response held across both half closes" {
+		t.Fatalf("response = %q, %v", response, err)
+	}
+	f.finished(t, false)
+}
+
+type horizonFlow struct {
+	client       horizonHalfConn
+	back, cancel *net.UnixConn
+	front        *horizonTrackedFront
+	done         <-chan error
+	shutdown     context.CancelFunc
+}
+
+func newHorizonFlow(t *testing.T, userspace bool) *horizonFlow {
+	t.Helper()
+	b := newTestBackend(t)
+	b.currentNode().SetNetMap(&netmap.NetworkMap{SelfNode: (&tailcfg.Node{Addresses: []netip.Prefix{netip.MustParsePrefix("100.150.151.151/32")}}).View()})
+	ctx, cancel := context.WithCancel(b.ctx)
+	b.ctx = ctx
+	t.Cleanup(cancel)
+	client, incoming := horizonFrontPair(t, userspace)
+	tracked := &horizonTrackedFront{Conn: incoming, closed: make(chan struct{}), writeEntered: make(chan struct{}, 1), releaseWrite: make(chan struct{})}
+	ln, err := net.ListenUnix("unix", &net.UnixAddr{Name: filepath.Join(t.TempDir(), "backend.sock"), Net: "unix"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { ln.Close() })
+	if err := ln.SetDeadline(time.Now().Add(5 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	handler := b.tcpHandlerForServeTCP((&ipn.TCPPortHandler{TCPForward: "unix:" + ln.Addr().String(), ProxyProtocol: 1, HorizonFlowCancel: true}).View(), 20000, netip.MustParseAddrPort("100.101.102.103:4567"), &serveHTTPContext{}, "")
+	done := make(chan error, 1)
+	go func() { done <- handler(tracked) }()
+	back, err := ln.AcceptUnix()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { back.Close() })
+	if err := back.SetDeadline(time.Now().Add(5 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	cancelEnd := receiveHorizonHeader(t, back)
+	return &horizonFlow{client: client, back: back, cancel: cancelEnd, front: tracked, done: done, shutdown: cancel}
+}
+
+func receiveHorizonHeader(t *testing.T, back *net.UnixConn) *net.UnixConn {
+	t.Helper()
+	var first [1]byte
+	oob := make([]byte, unix.CmsgSpace(4))
+	rawSocket, err := back.SyscallConn()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var n, oobn, flags int
+	var recvErr error
+	err = rawSocket.Read(func(fd uintptr) bool {
+		for {
+			n, oobn, flags, _, recvErr = unix.Recvmsg(int(fd), first[:], oob, unix.MSG_CMSG_CLOEXEC|unix.MSG_DONTWAIT)
+			if recvErr != unix.EINTR {
+				break
+			}
+		}
+		return recvErr != unix.EAGAIN
+	})
+	if err == nil {
+		err = recvErr
+	}
+	if err != nil || n != 1 || first[0] != 'P' || flags&(unix.MSG_CTRUNC|unix.MSG_TRUNC) != 0 {
+		t.Fatalf("first byte/control: %d %q %x %v", n, first, flags, err)
+	}
+	messages, err := unix.ParseSocketControlMessage(oob[:oobn])
+	if err != nil {
+		t.Fatal(err)
+	}
+	var files []*os.File
+	t.Cleanup(func() {
+		for _, file := range files {
+			file.Close()
+		}
+	})
+	for _, message := range messages {
+		fds, err := unix.ParseUnixRights(&message)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, fd := range fds {
+			files = append(files, os.NewFile(uintptr(fd), "received-cancel"))
+		}
+	}
+	if len(messages) != 1 || len(files) != 1 {
+		t.Fatalf("control messages=%d descriptors=%d", len(messages), len(files))
+	}
+	if flags, err := unix.FcntlInt(files[0].Fd(), unix.F_GETFD, 0); err != nil || flags&unix.FD_CLOEXEC == 0 {
+		t.Fatalf("CLOEXEC: %x, %v", flags, err)
+	}
+	raw, err := net.FileConn(files[0])
+	files[0].Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cancelEnd, ok := raw.(*net.UnixConn)
+	if !ok {
+		raw.Close()
+		t.Fatalf("cancel endpoint %T", raw)
+	}
+	t.Cleanup(func() { cancelEnd.Close() })
+	for _, addr := range []net.Addr{cancelEnd.LocalAddr(), cancelEnd.RemoteAddr()} {
+		if addr.Network() != "unix" || (addr.String() != "" && addr.String() != "@") {
+			t.Fatalf("not unnamed socketpair: %q", addr)
+		}
+	}
+	want := "ROXY TCP4 100.101.102.103 100.150.151.151 4567 20000\r\n"
+	header := make([]byte, len(want))
+	if _, err := io.ReadFull(back, header); err != nil || string(header) != want {
+		t.Fatalf("remaining header %q, %v", header, err)
+	}
+	return cancelEnd
+}
+
+func (f *horizonFlow) finished(t *testing.T, wantError bool) {
+	t.Helper()
+	select {
+	case err := <-f.done:
+		if (err != nil) != wantError {
+			t.Fatalf("handler error=%v, wantError=%v", err, wantError)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("handler/copy/cancellation goroutines did not retire")
+	}
+	if !wantError {
+		if err := f.cancel.SetReadDeadline(time.Now().Add(5 * time.Second)); err != nil {
+			t.Fatal(err)
+		}
+		ack, err := io.ReadAll(f.cancel)
+		if err != nil || len(ack) != 1 || ack[0] != 1 {
+			t.Fatalf("DRAINED+EOF = %x, %v", ack, err)
+		}
+	}
+	if got := f.front.active.Load(); got != 0 {
+		t.Fatalf("original frontend operations still live: %d", got)
+	}
+}
+
+type horizonTrackedFront struct {
+	net.Conn
+	active                                    atomic.Int32
+	blockWrite, failRead, failWrite, failHalf atomic.Bool
+	closed, writeEntered, releaseWrite        chan struct{}
+	closeOnce                                 sync.Once
+}
+
+func (c *horizonTrackedFront) Read(b []byte) (int, error) {
+	c.active.Add(1)
+	defer c.active.Add(-1)
+	if c.failRead.Load() {
+		return 0, io.ErrUnexpectedEOF
+	}
+	return c.Conn.Read(b)
+}
+func (c *horizonTrackedFront) Write(b []byte) (int, error) {
+	c.active.Add(1)
+	defer c.active.Add(-1)
+	if c.failWrite.Load() {
+		return 0, io.ErrClosedPipe
+	}
+	if c.blockWrite.Load() {
+		select {
+		case c.writeEntered <- struct{}{}:
+		default:
+		}
+		select {
+		case <-c.closed:
+			return 0, net.ErrClosed
+		case <-c.releaseWrite:
+		}
+	}
+	return c.Conn.Write(b)
+}
+func (c *horizonTrackedFront) Close() error {
+	c.closeOnce.Do(func() { close(c.closed) })
+	return c.Conn.Close()
+}
+func (c *horizonTrackedFront) CloseWrite() error {
+	if c.failHalf.Load() {
+		return io.ErrClosedPipe
+	}
+	return c.Conn.(horizonHalfConn).CloseWrite()
+}
+
+func horizonFrontPair(t *testing.T, userspace bool) (horizonHalfConn, horizonHalfConn) {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	var ln net.Listener
+	var dial func() (net.Conn, error)
+	if userspace {
+		s := stack.New(stack.Options{NetworkProtocols: []stack.NetworkProtocolFactory{ipv4.NewProtocol}, TransportProtocols: []stack.TransportProtocolFactory{tcp.NewProtocol}})
+		t.Cleanup(func() { s.Close(); s.Wait() })
+		if err := s.SetTransportProtocolOption(tcp.ProtocolNumber, &tcpip.TCPReceiveBufferSizeRangeOption{Min: 65536, Default: 65536, Max: 65536}); err != nil {
+			t.Fatal(err)
+		}
+		if err := s.SetTransportProtocolOption(tcp.ProtocolNumber, &tcpip.TCPSendBufferSizeRangeOption{Min: 65536, Default: 65536, Max: 65536}); err != nil {
+			t.Fatal(err)
+		}
+		var receive tcpip.TCPReceiveBufferSizeRangeOption
+		if err := s.TransportProtocolOption(tcp.ProtocolNumber, &receive); err != nil || receive.Max != 65536 {
+			t.Fatalf("gonet receive capacity: %+v, %v", receive, err)
+		}
+
+		if err := s.CreateNIC(1, loopback.New()); err != nil {
+			t.Fatal(err)
+		}
+		addr := tcpip.AddrFrom4([4]byte{127, 0, 0, 1})
+		if err := s.AddProtocolAddress(1, tcpip.ProtocolAddress{Protocol: ipv4.ProtocolNumber, AddressWithPrefix: addr.WithPrefix()}, stack.AddressProperties{}); err != nil {
+			t.Fatal(err)
+		}
+		s.SetRouteTable([]tcpip.Route{{Destination: header.IPv4EmptySubnet, NIC: 1}})
+		var err error
+		ln, err = gonet.ListenTCP(s, tcpip.FullAddress{NIC: 1, Addr: addr}, ipv4.ProtocolNumber)
+		if err != nil {
+			t.Fatal(err)
+		}
+		dial = func() (net.Conn, error) {
+			ctx, cancel := context.WithDeadline(context.Background(), deadline)
+			defer cancel()
+			return gonet.DialContextTCP(ctx, s, tcpip.FullAddress{NIC: 1, Addr: addr, Port: uint16(ln.Addr().(*net.TCPAddr).Port)}, ipv4.ProtocolNumber)
+		}
+	} else {
+		var err error
+		ln, err = net.Listen("tcp4", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := ln.(*net.TCPListener).SetDeadline(deadline); err != nil {
+			t.Fatal(err)
+		}
+		dial = func() (net.Conn, error) { return net.DialTimeout("tcp4", ln.Addr().String(), 5*time.Second) }
+	}
+	t.Cleanup(func() { ln.Close() })
+	client, err := dial()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { client.Close() })
+	type accepted struct {
+		conn net.Conn
+		err  error
+	}
+	ch := make(chan accepted, 1)
+	go func() { conn, err := ln.Accept(); ch <- accepted{conn, err} }()
+	var incoming net.Conn
+	select {
+	case result := <-ch:
+		if result.err != nil {
+			t.Fatal(result.err)
+		}
+		incoming = result.conn
+	case <-time.After(time.Until(deadline)):
+		ln.Close()
+		result := <-ch
+		if result.conn != nil {
+			result.conn.Close()
+		}
+		t.Fatal("frontend accept deadline")
+	}
+	t.Cleanup(func() { incoming.Close() })
+	if !userspace {
+		if err := client.(*net.TCPConn).SetReadBuffer(65536); err != nil {
+			t.Fatal(err)
+		}
+		if err := incoming.(*net.TCPConn).SetWriteBuffer(65536); err != nil {
+			t.Fatal(err)
+		}
+		raw, err := client.(*net.TCPConn).SyscallConn()
+		if err != nil {
+			t.Fatal(err)
+		}
+		var capacity int
+		var capacityErr error
+		if err := raw.Control(func(fd uintptr) { capacity, capacityErr = unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_RCVBUF) }); err != nil || capacityErr != nil || capacity <= 0 || capacity > 131072 {
+			t.Fatalf("kernel receive capacity: %d, %v, %v", capacity, err, capacityErr)
+		}
+	}
+
+	for _, conn := range []net.Conn{client, incoming} {
+		if err := conn.SetDeadline(deadline); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return client.(horizonHalfConn), incoming.(horizonHalfConn)
+}
+
+func TestHorizonUnixLargeResponseDrain(t *testing.T) {
+	for _, userspace := range []bool{false, true} {
+		t.Run(fmt.Sprintf("gonet=%v", userspace), func(t *testing.T) {
+			f := newHorizonFlow(t, userspace)
+			if err := f.client.CloseWrite(); err != nil {
+				t.Fatal(err)
+			}
+			if request, err := io.ReadAll(f.back); err != nil || len(request) != 0 {
+				t.Fatalf("request EOF: %q, %v", request, err)
+			}
+			// 2MiB exceeds the actual verified 128KiB kernel receive buffer and
+			// the pinned gonet stack's 64KiB receive/send limits.
+			response := make([]byte, 2*1024*1024)
+			for i := range response {
+				response[i] = byte((i*31 + i/257) % 251)
+			}
+			written := make(chan error, 1)
+			go func() {
+				_, err := f.back.Write(response)
+				if err == nil {
+					err = f.back.CloseWrite()
+				}
+				written <- err
+			}()
+			awaitBlockedHorizonResponse(t, userspace, written)
+			if err := f.cancel.SetReadDeadline(time.Now().Add(30 * time.Millisecond)); err != nil {
+				t.Fatal(err)
+			}
+			var early [1]byte
+			if n, err := f.cancel.Read(early[:]); n != 0 || err == nil {
+				t.Fatalf("early DRAINED before real response drain: %x, %v", early[:n], err)
+			} else if timeout, ok := err.(net.Error); !ok || !timeout.Timeout() {
+				t.Fatalf("control retired before drain: %v", err)
+			}
+			if err := f.cancel.SetReadDeadline(time.Now().Add(5 * time.Second)); err != nil {
+				t.Fatal(err)
+			}
+			got, err := io.ReadAll(f.client)
+			if err != nil || !bytes.Equal(got, response) {
+				t.Fatalf("large response changed/truncated: got%d want%d err=%v", len(got), len(response), err)
+			}
+			select {
+			case err := <-written:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("backend response writer did not retire")
+			}
+			f.finished(t, false)
+		})
+	}
+}
+
+func awaitBlockedHorizonResponse(t *testing.T, userspace bool, written <-chan error) {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	stack := make([]byte, 1024*1024)
+	for time.Now().Before(deadline) {
+		select {
+		case err := <-written:
+			t.Fatalf("large response did not exceed forwarding capacity: %v", err)
+		default:
+		}
+		n := runtime.Stack(stack, true)
+		for _, goroutine := range bytes.Split(stack[:n], []byte("\n\n")) {
+			trace := string(goroutine)
+			if !strings.Contains(trace, "(*horizonTrackedFront).Write") {
+				continue
+			}
+			if (!userspace && strings.Contains(trace, "internal/poll.runtime_pollWait")) || (userspace && strings.Contains(trace, "gonet.(*TCPConn).Write") && strings.Contains(trace, "[select]")) {
+				return
+			}
+		}
+		runtime.Gosched()
+	}
+	t.Fatal("original frontend write was not observed blocked by receive capacity")
+}
