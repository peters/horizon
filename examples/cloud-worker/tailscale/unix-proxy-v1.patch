+					!bytes.Equal(header[16:24], []byte{100, 101, 102, 103, 100, 150, 151, 151}) ||
+					binary.BigEndian.Uint16(header[24:26]) != 4567 || int(binary.BigEndian.Uint16(header[26:28])) != wantPort {
