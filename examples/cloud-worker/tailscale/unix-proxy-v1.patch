+// A rejected Unix v2 update must not overwrite an already configured v1 route.
+func TestServeUnixProxyV2PreservesConfig(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("Unix sockets are unsupported on Windows")
+	}
+	lc := &fakeLocalServeClient{}
+	e := &serveEnv{lc: lc}
+	if err := newServeV2Command(e, serve).ParseAndRun(t.Context(), []string{
+		"--tcp=3128", "--proxy-protocol=1", "--bg", "unix:/var/run/original.sock",
+	}); err != nil {
+		t.Fatal(err)
+	}
+	before, err := json.Marshal(lc.config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	count := lc.setCount
+	if err := newServeV2Command(&serveEnv{lc: lc}, serve).ParseAndRun(t.Context(), []string{
+		"--tcp=3128", "--proxy-protocol=2", "--bg", "unix:/var/run/replacement.sock",
+	}); err == nil {
+		t.Fatal("Unix v2 update succeeded")
+	}
+	after, err := json.Marshal(lc.config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if lc.setCount != count || !bytes.Equal(before, after) {
+		t.Fatalf("rejected update changed original configuration: %s -> %s", before, after)
+	}
+}
