+func TestHorizonFlowCancelConfig(t *testing.T) {
+	for _, scope := range []string{"node", "foreground", "service"} {
+		t.Run(scope, func(t *testing.T) {
+			h := &TCPPortHandler{TCPForward: "unix:/run/private/producer.sock", ProxyProtocol: 1, HorizonFlowCancel: true}
+			sc := &ServeConfig{TCP: map[uint16]*TCPPortHandler{20000: h}}
+			if scope == "foreground" {
+				sc = &ServeConfig{Foreground: map[string]*ServeConfig{"original": sc}}
+			}
+			if scope == "service" {
+				sc = &ServeConfig{Services: map[tailcfg.ServiceName]*ServiceConfig{"svc:original": {TCP: sc.TCP}}}
+			}
+			if err := sc.CheckHorizonFlowCancel(); (err == nil) != (runtime.GOOS == "linux") {
+				t.Fatalf("platform validation: %v", err)
+			}
+			encoded, err := json.Marshal(sc)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var decoded ServeConfig
+			if err := json.Unmarshal(encoded, &decoded); err != nil {
+				t.Fatal(err)
+			}
+			cloned := decoded.Clone()
+			after, err := json.Marshal(cloned)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(encoded, after) {
+				t.Fatalf("clone/JSON changed contract: %s -> %s", encoded, after)
+			}
+			var got *TCPPortHandler
+			switch scope {
+			case "node":
+				got = cloned.TCP[20000]
+			case "foreground":
+				got = cloned.Foreground["original"].TCP[20000]
+			case "service":
+				got = cloned.Services["svc:original"].TCP[20000]
+			}
+			if !got.View().HorizonFlowCancel() {
+				t.Fatal("view lost opt-in")
+			}
+			switch scope {
+			case "node":
+				h = decoded.TCP[20000]
+			case "foreground":
+				h = decoded.Foreground["original"].TCP[20000]
+			case "service":
+				h = decoded.Services["svc:original"].TCP[20000]
+			}
+			h.HorizonFlowCancel = false
+			if !got.HorizonFlowCancel {
+				t.Fatal("clone aliases decoded handler")
+			}
+		})
+	}
+}
+
+func TestHorizonFlowCancelInvalidHandlers(t *testing.T) {
+	for _, invalid := range []string{"tcp", "relative", "no-proxy", "v2", "zero-port", "tls", "http", "https"} {
+		t.Run(invalid, func(t *testing.T) {
+			h := &TCPPortHandler{TCPForward: "unix:/run/private/producer.sock", ProxyProtocol: 1, HorizonFlowCancel: true}
+			port := uint16(20000)
+			switch invalid {
+			case "tcp":
+				h.TCPForward = "127.0.0.1:20032"
+			case "relative":
+				h.TCPForward = "unix:relative.sock"
+			case "no-proxy":
+				h.ProxyProtocol = 0
+			case "v2":
+				h.ProxyProtocol = 2
+			case "zero-port":
+				port = 0
+			case "tls":
+				h.TerminateTLS = "example.ts.net"
+			case "http":
+				h.HTTP = true
+			case "https":
+				h.HTTPS = true
+			}
+			if err := h.CheckHorizonFlowCancel(port); err == nil {
+				t.Fatal("invalid opted-in handler accepted")
+			}
+			h.HorizonFlowCancel = false
+			if err := h.CheckHorizonFlowCancel(port); err != nil {
+				t.Fatalf("new validation changed ordinary false-field behavior: %v", err)
+			}
+		})
+	}
+}
+
+func TestHorizonFlowCancelAbsentIsWireCompatible(t *testing.T) {
+	const original = `{"TCP":{"20000":{"TCPForward":"unix:/run/original.sock","ProxyProtocol":1}}}`
+	var sc ServeConfig
+	if err := json.Unmarshal([]byte(original), &sc); err != nil {
+		t.Fatal(err)
+	}
+	if sc.TCP[20000].View().HorizonFlowCancel() {
+		t.Fatal("old config enabled cancellation")
+	}
+	after, err := json.Marshal(&sc)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(after) != original {
+		t.Fatalf("old config bytes changed: %s", after)
+	}
+}
