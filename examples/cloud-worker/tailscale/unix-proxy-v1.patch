+		{"unix-v1-header-looking-payload", "unix", "100.101.102.103:4567", 1, 20000, false},
+		{"unix-no-proxy", "unix", "100.101.102.103:4567", 0, 20000, false},
+		{"unix-zero-port-refused", "unix", "100.101.102.103:4567", 1, 0, true},
+		{"unix-no-node-address-refused", "unix", "100.101.102.103:4567", 1, 20000, true},
+		{"unix-v2-refused", "unix", "100.101.102.103:4567", 2, 20000, true},
+		{"tcp-v1-retained", "tcp", "100.101.102.103:4567", 1, 20000, false},
+		{"tcp-v2-retained", "tcp", "100.101.102.103:4567", 2, 20000, false},
