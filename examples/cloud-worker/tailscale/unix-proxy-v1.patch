+// CheckHorizonFlowCancel validates the explicit ancillary cancellation contract.
+func (h *TCPPortHandler) CheckHorizonFlowCancel(port uint16) error {
+	if h == nil || !h.HorizonFlowCancel {
+		return nil
+	}
+	path, isUnix := strings.CutPrefix(h.TCPForward, "unix:")
+	if runtime.GOOS != "linux" || !isUnix || !filepath.IsAbs(path) ||
+		h.ProxyProtocol != 1 || port == 0 || h.HTTP || h.HTTPS || h.TerminateTLS != "" {
+		return fmt.Errorf("Horizon flow cancellation requires Linux raw TCP to an absolute Unix target with PROXY1 and a nonzero Serve port")
+	}
+	return nil
+}
+
+// CheckHorizonFlowCancel validates opted-in handlers, including foreground and
+// service entries, before any incoming configuration is persisted.
+func (sc *ServeConfig) CheckHorizonFlowCancel() error {
+	horizonPorts := make(map[uint16]bool)
+	funnelPorts := make(map[uint16]bool)
+	if err := sc.checkHorizonFlowCancel(horizonPorts, funnelPorts); err != nil {
+		return err
+	}
+	for port := range horizonPorts {
+		if funnelPorts[port] {
+			return fmt.Errorf("Horizon flow cancellation cannot share port %d with Funnel", port)
+		}
+	}
+	return nil
+}
+
+func (sc *ServeConfig) checkHorizonFlowCancel(horizonPorts, funnelPorts map[uint16]bool) error {
+	if sc == nil {
+		return nil
+	}
+	for port, handler := range sc.TCP {
+		if err := handler.CheckHorizonFlowCancel(port); err != nil {
+			return err
+		}
+		if handler != nil && handler.HorizonFlowCancel {
+			horizonPorts[port] = true
+		}
+	}
+	for target, allowed := range sc.AllowFunnel {
+		if allowed {
+			if port, err := target.Port(); err == nil {
+				funnelPorts[port] = true
+			}
+		}
+	}
+	// Funnel target and TCP handler lookups cross the background/foreground
+	// boundary by port, so independent per-block validation is insufficient.
+	for _, foreground := range sc.Foreground {
+		if err := foreground.checkHorizonFlowCancel(horizonPorts, funnelPorts); err != nil {
+			return err
+		}
+	}
+	for _, service := range sc.Services {
+		if service == nil {
+			continue
+		}
+		for port, handler := range service.TCP {
+			if err := handler.CheckHorizonFlowCancel(port); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
