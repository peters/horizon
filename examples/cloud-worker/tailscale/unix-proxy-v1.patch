+func TestHorizonUnixHeaderSendCancellation(t *testing.T) {
+	for _, mode := range []string{"blocked-header", "header-write-error"} {
+		t.Run(mode, func(t *testing.T) {
+			_, incoming := horizonFrontPair(t, false)
+			back, peer, err := horizonCancellationPair()
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { back.Close(); peer.Close() })
+			if mode == "blocked-header" {
+				raw, err := back.SyscallConn()
+				if err != nil {
+					t.Fatal(err)
+				}
+				var fillErr error
+				err = raw.Control(func(fd uintptr) {
+					if err := unix.SetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_SNDBUF, 4096); err != nil {
+						fillErr = err
+						return
+					}
+					var buffer [4096]byte
+					for sent := 0; sent < 4*1024*1024; {
+						n, err := unix.Write(int(fd), buffer[:])
+						sent += n
+						if err == unix.EAGAIN {
+							return
+						}
+						if err != nil {
+							fillErr = err
+							return
+						}
+					}
+					fillErr = errors.New("fixture could not fill original backend write buffer")
+				})
+				if err != nil || fillErr != nil {
+					t.Fatalf("buffer precondition: %v, %v", err, fillErr)
+				}
+			} else {
+				peer.Close()
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			done := make(chan error, 1)
+			go func() {
+				done <- forwardHorizonUnix(ctx, incoming, back, []byte("PROXY TCP4 100.1.1.1 100.2.2.2 1 2\r\n"))
+			}()
+			if mode == "blocked-header" {
+				// Require the original send to be parked in network poll, not merely
+				// a scheduled goroutine that cancellation could beat to first poll.
+				awaitBlockedHorizonHeader(t, done)
+				cancel()
+			}
+			select {
+			case err := <-done:
+				if err == nil {
+					t.Fatal("header failure/cancellation reported success")
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("header writer/cancellation reader leaked")
+			}
+		})
+	}
+}
