#!/usr/bin/python3
"""Install worker-local tool bindings without copying account authentication."""
import json
import shutil
import os
import subprocess
from pathlib import Path
import os, sys
if os.geteuid() == 0 and Path('/run/horizon-tailnet/agent-isolation').exists():
    os.chdir('/workspace')
    os.execv('/usr/local/bin/horizon-worker-tailnet', ['horizon-worker-tailnet', 'agent', '/usr/local/bin/horizon-worker-configure', *sys.argv[1:]])
home = Path('/workspace/home')
subprocess.run(['git', 'lfs', 'install', '--skip-repo'], check=True)
subprocess.run(['git', 'config', '--global', 'lfs.storage', '/workspace/source/lfs'], check=True)
# The GitHub service routes Git through its proxy again once it holds a chain; until it does,
# Git must not point at a proxy that no process serves.
subprocess.run(['/usr/local/bin/horizon-worker-git-auth', 'unroute'], check=True)
capabilities = json.loads(Path('/workspace/capabilities.json').read_text())
servers = {}
if capabilities.get('agents', []):
    servers['horizon-cloud-companions'] = {'command': '/usr/local/bin/horizon-cloud-worker', 'args': ['companions', 'mcp']}
    # Reports "off" until the owner shares their local network from the cloud card.
    servers['horizon-local-network'] = {'command': '/usr/local/bin/horizon-cloud-worker', 'args': ['local-network', 'mcp']}
if capabilities.get('browsers', []) or capabilities.get('browserstack') is not None:
    servers['horizon-browser'] = {'command': '/usr/local/bin/horizon-browser', 'args': ['mcp', '--connect']}
if capabilities.get('desktop', False):
    servers['horizon-device'] = {'command': '/usr/local/bin/horizon-device', 'args': ['--target', '/workspace/device.json', 'mcp']}
# Agents may stop the worker when done only where the profile opts in to stopping by itself
# and the provider gave the worker a credential to stop with; a Hetzner worker has none
# (Horizon stops it), so the tool could only ever refuse there.
stops_itself = os.environ.get('HORIZON_WORKER_SELF_STOP_AVAILABLE') == '1' or bool(os.environ.get('RUNPOD_POD_ID') and os.environ.get('RUNPOD_API_KEY'))
# The watcher serves stop requests only for a period it accepts, as horizon-worker-idle does.
minutes = os.environ.get('HORIZON_IDLE_STOP_MINUTES', '')
idle_period = minutes.isdigit() and 10 <= int(minutes) <= 1440
if capabilities.get('agents', []) and idle_period and stops_itself:
    servers['horizon-worker'] = {'command': '/usr/local/bin/horizon-worker-stop', 'args': ['mcp']}
# Agents ask the person for more GitHub access whenever the image has the GitHub service; the
# tool says when no GitHub sign-in is installed, because the host installs one after this runs.
if capabilities.get('agents', []) and shutil.which('horizon-worker-github'):
    servers['horizon-github'] = {'command': '/usr/local/bin/horizon-worker-github', 'args': ['mcp']}
Path('/workspace/agent-mcp.json').write_text(json.dumps({'mcpServers': servers}))
if capabilities.get('desktop', False):
    Path('/workspace/device.json').write_text(json.dumps({'id': 'cloud-desktop', 'endpoint': {'kind': 'local_x11', 'display': ':99'}}))
for agent in ['codex', 'grok']:
    root = home / ('.' + agent)
    config = root / 'config.toml'
    if agent not in capabilities.get('agents', []) and not config.exists():
        continue
    root.mkdir(parents=True, exist_ok=True)
    original = config.read_text() if config.exists() else ''
    addition = ''
    enabled = servers if agent in capabilities.get('agents', []) else {}
    for name, server in enabled.items():
        addition += '\n[mcp_servers.' + name + ']\ncommand = ' + json.dumps(server['command'])
        addition += '\nargs = ' + json.dumps(server['args']) + '\ntool_timeout_sec = 3660\n'
        if agent == 'codex':
            addition += 'env_vars = ["HORIZON_BROWSER_ACTOR", "HORIZON_BROWSER_HOST_INSTANCE", "HORIZON_BROWSER_ROOT", "HORIZON_DEVICE_ACTOR"]\n'
        else:
            addition += '[mcp_servers.' + name + '.env]\n'
            for var in ['HORIZON_BROWSER_ACTOR','HORIZON_BROWSER_HOST_INSTANCE','HORIZON_BROWSER_ROOT','HORIZON_DEVICE_ACTOR']:
                addition += var + ' = "${' + var + ':-}"\n'
    result = subprocess.run(['horizon-cloud-worker', 'configure-agent-tools'],
                            input=json.dumps({'original': original, 'managed': addition}),
                            text=True, capture_output=True, check=True)
    pending = config.with_suffix('.new')
    pending.write_text(result.stdout)
    pending.chmod(0o600)
    pending.replace(config)

# One checkout serves every panel: tell agents where it is and that extra worktrees are theirs to make.
GUIDE_BEGIN = '<!-- horizon-cloud-worker:begin -->'
GUIDE_END = '<!-- horizon-cloud-worker:end -->'
GUIDE = """## Horizon cloud worker

This repository is checked out once, at /workspace/checkout, when the cloud is deployed. Work there and
do not clone it again. For another branch or an isolated task, create a worktree from that checkout
yourself, for example `git -C /workspace/checkout worktree add /workspace/worktrees/<name> -b <branch>`,
and remove it with `git worktree remove` when you are done. Other panels share the same checkout, so
leave changes you did not make alone."""


def without_guide(original):
    """The text with the managed block removed, so the agent's own notes stay as written."""
    if GUIDE_BEGIN not in original or GUIDE_END not in original:
        return original
    before, rest = original.split(GUIDE_BEGIN, 1)
    return before.rstrip('\n') + '\n' + rest.split(GUIDE_END, 1)[1].lstrip('\n')


def save(path, text):
    pending = path.with_name(path.name + '.new')
    pending.write_text(text)
    pending.chmod(0o600)
    pending.replace(path)


def write_guide(path):
    path.parent.mkdir(parents=True, exist_ok=True)
    kept = without_guide(path.read_text() if path.exists() else '').strip('\n')
    save(path, (kept + '\n\n' if kept else '') + GUIDE_BEGIN + '\n' + GUIDE + '\n' + GUIDE_END + '\n')


def remove_guide(path):
    """An agent the profile no longer allows keeps its own notes and loses ours."""
    if not path.exists():
        return
    original = path.read_text()
    if GUIDE_BEGIN not in original:
        return
    kept = without_guide(original).strip('\n')
    if kept:
        save(path, kept + '\n')
    else:
        path.unlink()


for agent, name in (('claude', 'CLAUDE.md'), ('codex', 'AGENTS.md')):
    guide = home / ('.' + agent) / name
    if agent in capabilities.get('agents', []):
        write_guide(guide)
    else:
        remove_guide(guide)
