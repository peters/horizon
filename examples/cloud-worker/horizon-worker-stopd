#!/usr/bin/python3
"""Stop this dedicated worker when an agent whose task is done asks through
horizon-worker-stop.

Where the provider gives the worker a credential to stop itself (RunPod), this service
checks the request and stops the worker at once. Where it does not (Hetzner, a Docker
host), a worker started with HORIZON_WORKER_STOP=horizon has the service check the
request and record it, for Horizon to carry out the next time it reads the worker with
`horizon-worker-stopd --take`, which checks it again. Horizon does not give that setting
yet. A shared worker and a worker
with hosted devices offer no stop: the first runs other clouds' sessions, and the second
could not release the devices it holds once stopped."""
import fcntl
import json
import os
from pathlib import Path
import socket
import stat
import struct
import subprocess
import sys
import time
import urllib.request


CPU_STAT = Path('/sys/fs/cgroup/cpu.stat')
# Some provider hosts still use cgroup v1, which reports nanoseconds instead.
CPU_ACCOUNTING = (Path('/sys/fs/cgroup/cpuacct/cpuacct.usage'), Path('/sys/fs/cgroup/cpu,cpuacct/cpuacct.usage'))
# The pod credential is refused by the REST API but accepted by GraphQL, as runpodctl uses it.
GRAPHQL_URL = 'https://api.runpod.io/graphql'
STOP = 'mutation Stop($pod: String!) { podStop(input: {podId: $pod}) { id desiredStatus } }'
# Average cores used by the container that still count as work, such as a quiet build.
BUSY_CORES = 0.5
# Agents ask for a stop here; only this service holds the worker credential.
STOP_SOCKET = Path('/run/horizon-worker/stop.sock')
# Kept on the workspace volume, so it survives the stop and the checker reports it on resume.
STOP_LOG = Path('/workspace/.horizon/self-stops.jsonl')
# A request for Horizon to carry out. On the root-only runtime folder, which the stop of a
# server clears, so a request never outlives the worker it was made on.
REQUEST = Path('/run/horizon-worker/stop-request.json')
REQUEST_LOCK = Path('/run/horizon-worker/stop-request.lock')
# A request Horizon did not take in this time lapses, as its checks are stale, and so does a
# stop Horizon took this long ago that did not happen.
REQUEST_SECONDS = 600
# Another agent session with output this recent is still working.
QUIET_SECONDS = 120
CPU_SAMPLE_SECONDS = 3
REASON_LIMIT = 200
CONTRACT = 'horizon-agent-stop-contract=1'


def mode(environ=os.environ):
    """How this worker stops at an agent's request: 'self' with the provider credential,
    'horizon' when Horizon carries the request out, or None where no stop is offered. Agent
    sessions see HORIZON_WORKER_SELF_STOP_AVAILABLE in place of the credential. Capabilities
    that the worker's environment does not name offer no stop: they might hold hosted
    devices, and the copy on the volume belongs to the agent."""
    if 'HORIZON_WORKER_STARTUP' in environ:
        return None
    try:
        capabilities = json.loads(environ.get('HORIZON_WORKER_CAPABILITIES') or 'null')
    except ValueError:
        return None
    if not isinstance(capabilities, dict) or capabilities.get('browserstack') is not None:
        return None
    if (environ.get('RUNPOD_POD_ID') and environ.get('RUNPOD_API_KEY')) or \
            environ.get('HORIZON_WORKER_SELF_STOP_AVAILABLE') == '1':
        return 'self'
    if environ.get('HORIZON_WORKER_STOP') == 'horizon':
        return 'horizon'
    return None


def tmux_command():
    if os.geteuid() == 0 and Path('/run/horizon-tailnet/agent-isolation').exists():
        return ['env', '-i', 'PATH=/usr/local/bin:/usr/bin:/bin', 'HOME=/workspace/home',
                'setpriv', '--reuid=10001', '--regid=10001', '--clear-groups',
                '--no-new-privs', '--bounding-set=-all', '--', 'tmux', '-L', 'horizon-cloud']
    return ['tmux', '-L', 'horizon-cloud']


def cpu_seconds(path=CPU_STAT, accounting=CPU_ACCOUNTING):
    """CPU time used by this container's cgroup, or None where it is not exposed."""
    try:
        for line in path.read_text().splitlines():
            name, value = line.split()
            if name == 'usage_usec':
                return int(value) / 1e6
    except (OSError, ValueError):
        pass
    for usage in accounting:
        try:
            return int(usage.read_text()) / 1e9
        except (OSError, ValueError):
            continue
    return None


def stop_worker(pod_id, key):
    body = json.dumps({'query': STOP, 'variables': {'pod': pod_id}}).encode()
    request = urllib.request.Request(GRAPHQL_URL, data=body, method='POST',
                                     headers={'Authorization': 'Bearer ' + key, 'Content-Type': 'application/json',
                                              # The provider's edge rejects the default Python agent.
                                              'User-Agent': 'horizon-worker-stopd/1'})
    with urllib.request.urlopen(request, timeout=30) as response:
        reply = json.load(response)
    data = reply.get('data') if isinstance(reply, dict) else None
    stopped = data.get('podStop') if isinstance(data, dict) else None
    if (reply.get('errors') or not isinstance(stopped, dict) or stopped.get('id') != pod_id
            or stopped.get('desiredStatus') != 'EXITED'):
        print('Stop request refused: ' + json.dumps(reply.get('errors') or stopped)[:300], flush=True)
        return False
    return True


class Refused(Exception):
    """A stop this worker must not make now, with the reason to give the agent."""


def reason_text(reason):
    # Only text is a reason; anything else fails closed rather than being coerced.
    text = ' '.join(reason.split()) if isinstance(reason, str) else ''
    text = ''.join(character for character in text if character.isprintable())
    if not text:
        raise Refused('Give a short reason for stopping this worker.')
    return text[:REASON_LIMIT]


# What tmux says when no agent session was ever started, which is not a failed check.
NO_SERVER = ('no server running', 'error connecting to')


def tmux(*args, run=subprocess.run):
    """Output of one tmux query, empty without any agent session. Any other failure
    refuses the stop, since activity is unknown."""
    try:
        return run(tmux_command() + [ *args], capture_output=True, text=True, timeout=10,
                   check=True).stdout
    except subprocess.CalledProcessError as error:
        if any(message in (error.stderr or '') for message in NO_SERVER):
            return ''
        raise Refused('Agent sessions on this worker cannot be checked right now; leave it running.') from None
    except (OSError, subprocess.SubprocessError):
        raise Refused('Agent sessions on this worker cannot be checked right now; leave it running.') from None


def parent(pid, proc=Path('/proc')):
    """The parent process of `pid`, or 0 when it has ended."""
    try:
        return int((proc / str(pid) / 'stat').read_text().rsplit(') ', 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


# Agents horizon-worker-session binds; its other kind, shell, is a person's terminal.
AGENTS = ('claude', 'codex', 'grok')


def caller(pid, query=tmux, parent_of=parent, sessions=Path('/workspace/sessions')):
    """The agent session whose process tree `pid` belongs to, as (window, session, agent).
    The kernel names the connecting process, so a caller cannot speak for another window."""
    return pane(pid, query, parent_of, sessions)[1:]


def pane(pid, query=tmux, parent_of=parent, sessions=Path('/workspace/sessions')):
    """As `caller`, with the process of the session's pane first: (pane, window, session,
    agent)."""
    panes = {}
    for line in query('list-panes', '-a', '-F', '#{pane_pid} #{window_id} #{session_name}').splitlines():
        fields = line.split(' ', 2)
        if len(fields) == 3 and fields[0].isdigit():
            panes[int(fields[0])] = (fields[1], fields[2])
    seen = set()
    while pid > 1 and pid not in seen:
        if pid in panes:
            window, session = panes[pid]
            # A pane is an agent session only with the binding horizon-worker-session
            # wrote for it; a plain shell or an ad-hoc tmux session is not one.
            agent = binding(sessions / session / 'agent')
            if agent not in AGENTS:
                break
            return pid, window, session, agent
        seen.add(pid)
        pid = parent_of(pid)
    raise Refused('Only an agent session on this worker can stop it.')


def binding(path):
    """The agent that a session binding names, or '' when the binding is not one plain file.
    The sessions folder is the agent's to write: root reads it without following a link and
    without waiting on a pipe placed there, which would hold the service."""
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return ''
    with os.fdopen(descriptor, 'rb') as file:
        try:
            if not stat.S_ISREG(os.fstat(file.fileno()).st_mode):
                return ''
            return file.read(64).decode(errors='replace').strip()
        except OSError:
            return ''


def other_output(own, query=tmux):
    """Newest output time of any agent window except `own`, or None without others."""
    stamps = []
    for line in query('list-windows', '-a', '-F', '#{window_id} #{window_activity}').splitlines():
        window, _, stamp = line.partition(' ')
        if window != own and stamp.isdigit():
            stamps.append(int(stamp))
    return max(stamps, default=None)


def busy_cores(sample=CPU_SAMPLE_SECONDS):
    """Average cores the container used over a short sample, or None where it is not exposed."""
    before = cpu_seconds()
    time.sleep(sample)
    after = cpu_seconds()
    if before is None or after is None:
        return None
    return (after - before) / sample


def check_quiet(window, now=time.time, output=other_output, cores=busy_cores):
    """Refuses a stop while the worker works: its container is busy, or an agent session
    other than the one in `window` printed output in the last two minutes. With no
    `window`, every agent session counts."""
    used = cores()
    # Without CPU accounting a quiet build cannot be told from idle, so an agent may not stop it.
    if used is None:
        raise Refused('This worker cannot measure its CPU use, so it cannot tell whether it is busy; '
                      'leave it running.')
    if used >= BUSY_CORES:
        raise Refused(f'This worker is busy ({used:.1f} cores in use); leave it running.')
    # Checked after the CPU sample, right before the stop, so the sample is no blind spot.
    newest = output(window)
    if newest is not None and now() - newest < QUIET_SECONDS:
        raise Refused(('Another agent session' if window else 'An agent session') +
                      ' on this worker produced output in the last two minutes; leave the worker running.')


def open_log(log, flags):
    """The stop log, opened as root without following a link an agent placed at the log or
    at its folder on the agent-writable volume, and only when it is one plain file: a pipe
    there would hold the service, and a hard link would point elsewhere."""
    log.parent.mkdir(parents=True, exist_ok=True)
    folder = os.open(log.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        descriptor = os.open(log.name, flags | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, 0o644,
                             dir_fd=folder)
    finally:
        os.close(folder)
    status = os.fstat(descriptor)
    if not stat.S_ISREG(status.st_mode) or status.st_nlink != 1:
        os.close(descriptor)
        raise OSError('The stop log is not a plain file')
    return descriptor


def append(log, record):
    """Adds `record` to the stop log on the workspace volume. Returns the log's earlier size."""
    descriptor = open_log(log, os.O_WRONLY | os.O_APPEND | os.O_CREAT)
    with os.fdopen(descriptor, 'a') as file:
        before = os.fstat(file.fileno()).st_size
        file.write(json.dumps(record) + '\n')
    os.sync()
    return before


def self_stop(reason, requester, pod_id, key, log=STOP_LOG, now=time.time, output=other_output, cores=busy_cores,
              request=None):
    """Checks, records and requests a stop that the agent session `requester`, as
    (window, session, agent), asked for. Returns the agent's message."""
    text = reason_text(reason)
    window, session, agent = requester
    check_quiet(window, now, output, cores)
    before = append(log, {'at': int(now() * 1000), 'reason': text, 'session': session, 'agent': agent})
    try:
        stopped = (request or stop_worker)(pod_id, key)
    # Any failure of this one request is reported; an escaping error would end the service.
    except Exception as error:
        print('Stop request failed: ' + type(error).__name__, flush=True)
        stopped = False
    if not stopped:
        # Only stops the provider accepted stay on record.
        descriptor = open_log(log, os.O_WRONLY)
        try:
            os.ftruncate(descriptor, before)
        finally:
            os.close(descriptor)
        raise Refused('The provider did not accept the stop request; the worker keeps running.')
    print(f'Stopping this worker at the request of session {session}: {text}', flush=True)
    return 'Stop requested. This worker is stopping; the person can resume it.'


def locked(lock):
    """An exclusive hold on the stop request, released when the returned file closes. The
    lock is root's alone, whatever the umask."""
    lock.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(lock, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    os.fchmod(descriptor, 0o600)
    held = os.fdopen(descriptor, 'w')
    fcntl.flock(held, fcntl.LOCK_EX)
    return held


def record_request(reason, requester, path=REQUEST, lock=REQUEST_LOCK, now=time.time, output=other_output,
                   cores=busy_cores, log=STOP_LOG):
    """Checks a stop that the agent session `requester` asked for and records it for Horizon
    to carry out, replacing an earlier request. Returns the agent's message."""
    text = reason_text(reason)
    window, session, agent = requester
    check_quiet(window, now, output, cores)
    record = {'at': int(now() * 1000), 'reason': text, 'session': session, 'agent': agent, 'window': window}
    # Held so that a take never removes a request that arrived after it read the file.
    try:
        with locked(lock):
            refuse_over_taken(path, log, now)
            write_request(path, record)
    except OSError as error:
        raise Refused('The stop request could not be recorded (' + type(error).__name__ + '); '
                      'the worker keeps running.') from None
    print(f'Stop requested by session {session}: {text}', flush=True)
    return ('Stop requested. Horizon on the person\'s computer stops this worker the next time it checks, '
            'within about a minute, and keeps the workspace volume. It works only while Horizon runs; '
            'a request Horizon does not take within ten minutes lapses.')


def refuse_over_taken(path, log, now):
    """Refuses a request while Horizon carries out one it took. A taken stop that lapsed
    leaves the log first, as a take would remove it, so no stop that did not happen stays
    on record."""
    try:
        record = json.loads(path.read_text())
    except (OSError, ValueError):
        return
    if not isinstance(record, dict) or record.get('taken') is not True or not isinstance(record.get('at'), int):
        return
    if not lapsed(record, now):
        raise Refused('Horizon is already stopping this worker at the request of session '
                      + str(record.get('session')) + '.')
    remove_newest(log, record['at'])


def lapsed(record, now):
    """Whether `record` no longer counts: a request that Horizon did not take within
    REQUEST_SECONDS, or a stop it took that long ago that did not happen."""
    since = record.get('taken_at') if record.get('taken') is True else record['at']
    return not isinstance(since, int) or not 0 <= now() * 1000 - since <= REQUEST_SECONDS * 1000


def sessions(query=tmux):
    """The session of each agent window, by window id."""
    windows = {}
    for line in query('list-windows', '-a', '-F', '#{window_id} #{session_name}').splitlines():
        window, _, session = line.partition(' ')
        windows[window] = session
    return windows


def take(path=REQUEST, lock=REQUEST_LOCK, log=STOP_LOG, now=time.time, output=other_output, cores=busy_cores,
         query=tmux):
    """The recorded request, for Horizon to carry out, as the line it prints: null without a
    request, {"waiting": ...} while the worker works, which keeps the request for a later
    take until it lapses, {"refused": ...} when the request no longer counts, else the stop
    record that is now on the stop log. A taken stop is printed again by each later take
    until the worker stops, so a lost answer loses no stop; one that lapses taken is removed
    from the log. A stop that Horizon could not start is taken back with `untake`."""
    with locked(lock):
        try:
            record = json.loads(path.read_text())
        except FileNotFoundError:
            return None
        except ValueError:
            record = None
        if not isinstance(record, dict) or not all(isinstance(record.get(key), str)
                                                   for key in ('reason', 'session', 'agent', 'window')) \
                or not isinstance(record.get('at'), int):
            path.unlink(missing_ok=True)
            return {'refused': 'The stop request was malformed.'}
        stop = {key: record[key] for key in ('at', 'reason', 'session', 'agent')}
        if lapsed(record, now):
            if record.get('taken') is True:
                remove_newest(log, record['at'])
            path.unlink(missing_ok=True)
            return {'refused': 'The stop request lapsed before the worker stopped.'}
        if record.get('taken') is True:
            return stop
        try:
            # Window ids restart with the tmux server: the requester's window must still be
            # its session's.
            if sessions(query).get(record['window'], record['session']) != record['session']:
                path.unlink(missing_ok=True)
                return {'refused': 'The agent session that asked has ended and its window is in use again.'}
            # Every session counts now, the requester's too: it may have taken up new work.
            check_quiet(None, now, output, cores)
        except Refused as refusal:
            # The worker works now, or cannot tell: the next take decides again.
            return {'waiting': str(refusal)}
        try:
            append(log, stop)
        except OSError as error:
            return {'waiting': 'The stop could not be recorded on the workspace volume: ' + type(error).__name__}
        record['taken'] = True
        record['taken_at'] = int(now() * 1000)
        try:
            write_request(path, record)
        except OSError as error:
            # Untaken, the request would be logged again by the next take: the stop
            # leaves the log, and the next take decides again.
            remove_newest(log, stop['at'])
            return {'waiting': 'The stop could not be recorded on the worker: ' + type(error).__name__}
        return stop


def write_request(path, record):
    """Replaces the request file whole, readable by root only."""
    pending = path.with_suffix('.new')
    pending.write_text(json.dumps(record))
    pending.chmod(0o600)
    pending.replace(path)


def remove_newest(log, at):
    """Removes the stop at `at` from the stop log when it is the newest line there.
    Returns whether it was removed."""
    try:
        descriptor = open_log(log, os.O_RDWR)
    # Missing, or a link an agent placed: nothing of Horizon's to take back.
    except OSError:
        return False
    with os.fdopen(descriptor, 'r+b') as file:
        lines = file.read().splitlines(keepends=True)
        try:
            newest = json.loads(lines[-1]) if lines else None
        except ValueError:
            newest = None
        if not isinstance(newest, dict) or newest.get('at') != at:
            return False
        file.truncate(len(b''.join(lines[:-1])))
    os.sync()
    return True


def untake(at, path=REQUEST, log=STOP_LOG, lock=REQUEST_LOCK):
    """Takes back the stop taken at `at`, after Horizon failed to start it: removes it from
    the stop log and drops its request. Returns whether the log held it."""
    with locked(lock):
        try:
            record = json.loads(path.read_text())
        except (OSError, ValueError):
            record = None
        if isinstance(record, dict) and record.get('at') == at:
            path.unlink(missing_ok=True)
        return remove_newest(log, at)


def peer_pid(connection):
    """The process on the other end of a Unix socket, as the kernel reports it."""
    pid, _, _ = struct.unpack('3i', connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                                            struct.calcsize('3i')))
    return pid


def answer(line, pid, stop, identify=caller):
    """The reply to one request line from the process `pid`, where `stop` makes or records
    the stop for a reason and the requesting session."""
    try:
        request = json.loads(line)
        if not isinstance(request, dict):
            raise ValueError
        message = stop(request.get('reason'), identify(pid))
        return {'ok': True, 'message': message}
    except Refused as refusal:
        return {'ok': False, 'message': str(refusal)}
    except ValueError:
        return {'ok': False, 'message': 'Malformed stop request.'}
    except OSError as error:
        return {'ok': False, 'message': 'The stop could not be recorded on the workspace volume ('
                + type(error).__name__ + '); the worker keeps running.'}


def request_line(connection, limit=4096, seconds=10, clock=time.monotonic):
    """The first line a client sends, within `seconds` in all: the service answers one
    request at a time, so a client that sends a byte now and then must not hold it."""
    deadline = clock() + seconds
    data = b''
    while b'\n' not in data and len(data) < limit:
        left = deadline - clock()
        if left <= 0:
            raise TimeoutError('The stop request did not arrive in time')
        connection.settimeout(left)
        chunk = connection.recv(limit - len(data))
        if not chunk:
            break
        data += chunk
    return data.split(b'\n', 1)[0].decode(errors='replace')


def serve_stop_requests(stop, path=STOP_SOCKET, identify=caller):
    """Answers stop requests one at a time on a socket only this machine can reach."""
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.unlink(missing_ok=True)
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(str(path))
        path.chmod(0o660)
        if Path('/run/horizon-tailnet/agent-isolation').exists():
            os.chown(path, 0, 10001)
        server.listen(4)
    # Agents are then told the worker cannot stop itself.
    except OSError as error:
        print('Stop requests from agents unavailable: ' + type(error).__name__, flush=True)
        return
    while True:
        try:
            connection, _ = server.accept()
        # A failed accept must not end the service, and with it the worker.
        except OSError as error:
            print('Stop request not accepted: ' + type(error).__name__, flush=True)
            time.sleep(1)
            continue
        with connection:
            try:
                line = request_line(connection)
                reply = answer(line, peer_pid(connection), stop, identify)
                connection.sendall((json.dumps(reply) + '\n').encode())
            # One bad client must not end the service.
            except Exception as error:
                print('Stop request connection failed: ' + type(error).__name__, flush=True)


def main():
    # Only root may write requests; the supervisor makes the folder so, and so does this.
    REQUEST.parent.mkdir(parents=True, exist_ok=True)
    if os.geteuid() == 0:
        os.chown(REQUEST.parent, 0, 0)
        REQUEST.parent.chmod(0o755)
    # A request from before this start was made on a worker that has stopped since.
    with locked(REQUEST_LOCK):
        REQUEST.unlink(missing_ok=True)
    offered = mode()
    pod_id, key = os.environ.get('RUNPOD_POD_ID'), os.environ.get('RUNPOD_API_KEY')
    if offered == 'self' and pod_id and key:
        serve_stop_requests(lambda reason, requester: self_stop(reason, requester, pod_id, key))
    elif offered == 'horizon':
        serve_stop_requests(record_request)
    else:
        print('No agent stop on this worker', flush=True)
    # Exiting would end the supervised worker; stay passive instead.
    while True:
        time.sleep(3600)


def entry(arguments):
    if arguments == ['--contract']:
        print(CONTRACT)
        return 0
    if arguments == ['--mode']:
        print(mode() or 'none')
        return 0
    if arguments == ['--take']:
        print(json.dumps(take(), separators=(',', ':')))
        return 0
    if len(arguments) == 2 and arguments[0] == '--untake' and arguments[1].isdigit():
        print(json.dumps(untake(int(arguments[1]))))
        return 0
    if arguments:
        print('Usage: horizon-worker-stopd [--contract | --mode | --take | --untake AT]', file=sys.stderr)
        return 2
    return main()


if __name__ == '__main__':
    sys.exit(entry(sys.argv[1:]))
