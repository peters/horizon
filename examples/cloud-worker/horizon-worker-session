#!/bin/bash
# Attach:   horizon-worker-session SESSION AGENT REVISION
# Relaunch: horizon-worker-session --relaunch OPERATION SESSION AGENT REVISION
set -euo pipefail
umask 077
operation=
if [ "${1:-}" = --relaunch ]; then
    operation="${2:?operation required}"; shift 2
    [[ "$operation" =~ ^[a-zA-Z0-9_-]{1,100}$ ]] || exit 2
fi
id="${1:?session required}"; agent="${2:?agent required}"; revision="${3:?revision required}"
[[ "$id" =~ ^[a-zA-Z0-9_-]{1,100}$ && "$revision" =~ ^[0-9a-f]{40}$|^[0-9a-f]{64}$ ]] || exit 2
case "$agent" in codex|claude|grok|shell) ;; *) exit 2;; esac
export HOME=/workspace/home DISPLAY=:99 HORIZON_BROWSER_ROOT=/workspace/home/.horizon
export HORIZON_CLOUD_ACTOR="cloud:$id" HORIZON_BROWSER_ACTOR="cloud:$id"
unset HORIZON HORIZON_BROWSER_HOST_INSTANCE
horizon-worker-check --agent "$agent"
session="/workspace/sessions/$id"
worktree="/workspace/agents/$id"
bound() { [ "$(cat "$session/agent")" = "$agent" ] && [ "$(cat "$session/revision")" = "$revision" ]; }
running() { tmux -L horizon-cloud has-session -t "=$id" 2>/dev/null; }
# The persisted binding fully determines the launch, so a relaunch reproduces it exactly.
# The tmux server must not inherit the session lock (fd 9), or a crash before the unlock
# would hold it for the server's lifetime.
launch() { tmux -L horizon-cloud new-session -d -s "$id" -c "$worktree" "horizon-worker-run $id $agent" 9>&-; }
if [ -n "$operation" ]; then
    # Replace a lost process only. Never create, reset or check out the worktree.
    [ -d "$session" ] || { echo 'Unknown session. No process was started.' >&2; exit 3; }
    # The process takes its browser identity from this container's running services.
    horizon-worker-check --ready >/dev/null
    exec 9>"/workspace/sessions/$id.lock"
    flock 9
    bound || { echo 'Session binding mismatch' >&2; exit 3; }
    fence="$session/relaunch-requested-$operation"
    # The operation that started the current process; an older operation's fence alone proves nothing.
    current="$session/relaunch-operation"
    if [ -f "$fence" ]; then
        if running && [ "$(cat "$current" 2>/dev/null)" = "$operation" ]; then exit 0; fi
        echo 'The process relaunched by this operation was lost or its launch is uncertain. No replacement process was started.' >&2; exit 4
    fi
    if running; then
        echo 'Session process is running. No replacement process was started.' >&2; exit 5
    fi
    if [ ! -f "$session/launch-requested" ] && [ -f "$session/preparing" ]; then
        echo 'Session was never launched; attaching starts it. No process was started.' >&2; exit 5
    fi
    if [ ! -e "$worktree/.git" ] || [ "$(git -C "$worktree" rev-parse --is-inside-work-tree 2>/dev/null)" != true ]; then
        echo 'Session worktree is missing. No replacement process was started.' >&2; exit 3
    fi
    # Persist the fence before starting: a retry of this operation never starts a second process.
    touch "$fence"
    sync -f "$fence"
    printf '%s\n' "$operation" > "$current.new"
    sync -f "$current.new"
    mv "$current.new" "$current"
    # The rename must be durable too, so the fence and the record naming its operation survive together.
    sync -f "$current"
    rm -f "$session/exit-status"
    launch
    rm -f "$session/preparing"
    # Release the lock explicitly before exiting; the tmux server never holds it.
    flock -u 9
    printf 'Session relaunched in its existing worktree: %s\n' "$id"
    exit 0
fi
mkdir -p /workspace/sessions
exec 9>"/workspace/sessions/$id.lock"
flock 9
if [ -d "$session" ]; then
    bound || { echo 'Session binding mismatch' >&2; exit 3; }
    if ! running; then
        if [ -f "$session/launch-requested" ] || [ ! -f "$session/preparing" ]; then
            echo 'Remote process was lost or its launch is uncertain. No replacement process was started.' >&2; exit 4
        fi
    fi
else
    staging="$(mktemp -d /workspace/sessions/.preparing-XXXXXX)"
    printf '%s\n' "$agent" > "$staging/agent"
    printf '%s\n' "$revision" > "$staging/revision"
    touch "$staging/preparing"
    mv "$staging" "$session"
fi
if ! running; then
    if [ ! -e "$worktree/.git" ]; then
        if ! git --git-dir=/workspace/repository.git show-ref --verify --quiet "refs/heads/agent/$id"; then
            git --git-dir=/workspace/repository.git branch "agent/$id" "$revision"
        fi
        git --git-dir=/workspace/repository.git worktree add "$worktree" "agent/$id"
    fi
    [ "$(git -C "$worktree" rev-parse HEAD)" = "$revision" ] || { echo 'Initial worktree revision mismatch' >&2; exit 3; }
    # No process has been launched: finish a checkout interrupted after Git wrote HEAD.
    git -C "$worktree" reset --hard "$revision"
    horizon-worker-source checkout "$worktree"
    # Persist the launch fence before starting a process; an uncertain launch cannot be replayed.
    touch "$session/launch-requested"
    sync -f "$session/launch-requested"
    launch
    rm "$session/preparing"
fi
flock -u 9
exec 9>&-
exec tmux -L horizon-cloud attach-session -t "=$id"
