#!/bin/bash
# Attach:   horizon-worker-session SESSION AGENT REVISION
# Relaunch: horizon-worker-session --relaunch OPERATION SESSION AGENT REVISION
# Retry:    horizon-worker-session --retry-shared-checkout
set -euo pipefail
umask 077
# A failing flush on the attach path means the workspace storage refused earlier writes, so
# stop with the reason instead of ending the connection with a bare error. No process was
# started, and attaching again resumes the interrupted preparation.
flush_failed() {
    {
        echo "Workspace storage did not accept a write while saving $1."
        # Diagnostics only: they must never replace the instruction or the exit status.
        { df -h /workspace | tail -n 1; } 2>/dev/null || true
        { df -i /workspace | tail -n 1; } 2>/dev/null || true
        echo 'No process was started. Attach again; if it fails again, stop and resume the cloud (its workspace volume is kept).'
    } >&2
    exit 6
}
flush() {
    sync -f "$1" || flush_failed "$1"
}
shared_state=/workspace/shared-checkout-state
if [ "${1:-}" = --retry-shared-checkout ]; then
    [ "$#" -eq 1 ] || exit 2
    # Under the checkout lock no preparation is running, so the next attach resumes it.
    exec 8>/workspace/shared-checkout.lock
    flock 8
    if [ -f "$shared_state/failed" ]; then
        rm "$shared_state/failed"
        sync -f "$shared_state"
        echo 'Cleared the failed shared checkout preparation; the next attach resumes it without resetting files.'
    else
        echo 'No failed shared checkout preparation is recorded.'
    fi
    exit 0
fi
shared=false
if [ "${1:-}" = --shared ]; then
    shared=true; shift
fi
operation=
if [ "${1:-}" = --relaunch ]; then
    operation="${2:?operation required}"; shift 2
    [[ "$operation" =~ ^[a-zA-Z0-9_-]{1,100}$ ]] || exit 2
fi
id="${1:?session required}"; agent="${2:?agent required}"; revision="${3:?revision required}"
[[ "$id" =~ ^[a-zA-Z0-9_-]{1,100}$ && "$revision" =~ ^[0-9a-f]{40}$|^[0-9a-f]{64}$ ]] || exit 2
case "$agent" in codex|claude|grok|shell) ;; *) exit 2;; esac
export HOME=/workspace/home DISPLAY=:99 HORIZON_BROWSER_ROOT=/workspace/home/.horizon
export HORIZON_CLOUD_ACTOR="cloud:$id" HORIZON_BROWSER_ACTOR="cloud:$id"
unset HORIZON HORIZON_BROWSER_HOST_INSTANCE
horizon-worker-check --agent "$agent"
session="/workspace/sessions/$id"
root="/workspace/agents/$id"
worktree="$root"
siblings=()
bound() { [ "$(cat "$session/agent")" = "$agent" ] && [ "$(cat "$session/revision")" = "$revision" ]; }
running() { tmux -L horizon-cloud has-session -t "=$id" 2>/dev/null; }
# A session's own manifest snapshot fixes its layout, so a later manifest never moves it.
# Without one, the primary worktree is the session root itself.
load_layout() {
    if [ -f "$session/shared-checkout" ]; then
        shared=true
        root=/workspace/checkout
        worktree="$root"
    else
        shared=false
    fi
    [ -f "$session/siblings.json" ] || return 0
    local listing primary
    listing="$(horizon-worker-siblings layout "$session/siblings.json")"
    { read -r primary; mapfile -t siblings; } <<< "$listing"
    [ -n "$primary" ] && [ "${#siblings[@]}" -gt 0 ] || { echo 'Invalid session layout' >&2; exit 3; }
    worktree="$root/$primary"
}
# Holding fd 8 serializes every attach against the one preparation of the shared checkout.
lock_checkout() {
    exec 8>/workspace/shared-checkout.lock
    flock -n 8 && return 0
    if [ ! -f "$shared_state/ready" ]; then
        echo "Waiting for another panel to finish preparing the shared checkout; progress is in $shared_state/prepare.log" >&2
    fi
    flock 8
}
# Publish a shared checkout once, before any session can enter it. After that,
# another panel must never reset its edits or select a branch on the user's behalf.
prepare_shared() {
    local state="$shared_state"
    lock_checkout
    # A recorded failure outranks `ready`: a failure after `ready` was written still fences.
    [ ! -f "$state/failed" ] || refuse_failed
    if [ ! -f "$state/ready" ]; then
        start_preparation
        lock_checkout
        [ ! -f "$state/failed" ] || refuse_failed
        if [ ! -f "$state/ready" ]; then
            echo 'Shared checkout preparation was interrupted. Attach again to resume it; no files were reset.' >&2; exit 3
        fi
    fi
    [ "$(cat "$state/revision")" = "$revision" ] || { echo 'Shared checkout binding mismatch' >&2; exit 3; }
    same_layout "$state" || { echo 'Shared checkout layout mismatch' >&2; exit 3; }
    all_present || { echo 'Shared checkout is missing or belongs to another repository. No process was started.' >&2; exit 3; }
    flock -u 8
    exec 8>&-
}
refuse_failed() {
    echo "Shared checkout preparation failed; see $shared_state/prepare.log. After fixing the cause, run 'horizon-worker-session --retry-shared-checkout' on the worker and attach again; no files were reset." >&2
    exit 3
}
same_layout() {
    if [ -f "$session/siblings.json" ]; then
        cmp -s "$session/siblings.json" "$1/siblings.json"
    else
        [ ! -e "$1/siblings.json" ]
    fi
}
# Called holding the checkout lock. The preparation runs in its own session with the
# lock's open file description, so an SSH disconnect that ends this attach neither
# interrupts it nor lets a second preparation start until it exits.
start_preparation() {
    local state="$shared_state"
    if [ -e "$state" ]; then
        # Only a preparation killed without a recorded failure gets here; no session has entered it.
        [ "$(cat "$state/revision")" = "$revision" ] || { echo 'Shared checkout binding mismatch' >&2; exit 3; }
        same_layout "$state" || { echo 'Shared checkout layout mismatch' >&2; exit 3; }
        echo 'Resuming the interrupted shared checkout preparation.' >&2
    elif [ -e "$root" ]; then
        echo 'Shared checkout exists but was not prepared by Horizon. No files were reset.' >&2; exit 3
    else
        mkdir "$state"
        printf '%s\n' "$revision" > "$state/revision"
        if [ -f "$session/siblings.json" ]; then cp "$session/siblings.json" "$state/siblings.json"; fi
        flush "$state"
    fi
    : > "$state/prepare.log"
    export -f flush flush_failed prepare present prepare_checkout
    export shared id root worktree revision state
    # A signal (exit status 129 and above) leaves no failure record, so the next attach
    # resumes, as does 6, storage refusing a write. 128 is an ordinary failure, such as a fatal Git error.
    setsid -w bash -c '(set -euo pipefail; prepare_checkout "$@"); status=$?
        if [ "$status" -ne 0 ] && [ "$status" -ne 6 ] && [ "$status" -le 128 ]; then touch "$state/failed"; sync -f "$state"; fi
        exit "$status"' horizon-worker-prepare "${siblings[@]}" < /dev/null >> "$state/prepare.log" 2>&1 9>&- &
    local preparer=$!
    exec 8>&-
    tail -n +1 -f --pid="$preparer" "$state/prepare.log" >&2 || true
    # The log already says why; the exit status says it was storage, which nothing else records.
    local status=0
    wait "$preparer" || status=$?
    if [ "$status" -eq 6 ]; then exit 6; fi
}
prepare_checkout() {
    if [ "$worktree" != "$root" ]; then mkdir -p "$root"; fi
    prepare /workspace/repository.git "$worktree" "$revision"
    local entry fields
    for entry in "$@"; do
        read -r -a fields <<< "$entry"
        prepare "/workspace/siblings/${fields[0]}/repository.git" "$root/${fields[1]}" "${fields[2]}" "${fields[0]}"
    done
    flush "$root"
    touch "$state/ready"
    # No session may enter a checkout whose ready marker could vanish: a later attach would
    # prepare it again over their edits. Withdraw the marker, so the next attach resumes
    # the preparation while nothing has launched.
    sync -f "$state/ready" || { rm -f "$state/ready"; flush_failed "$state/ready"; }
}
# A worktree counts only when it belongs to its own repository; another clone at that path does not.
present() {
    local common expected
    [ -e "$1/.git" ] || return 1
    common="$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
    expected="$(cd "$2" 2>/dev/null && pwd -P)" || return 1
    [ -n "$expected" ] && [ "$(cd "$common" && pwd -P)" = "$expected" ]
}
# Sibling entries are "ALIAS DIRECTORY REVISION".
all_present() {
    present "$worktree" /workspace/repository.git || return 1
    local entry fields
    for entry in "${siblings[@]}"; do
        read -r -a fields <<< "$entry"
        present "$root/${fields[1]}" "/workspace/siblings/${fields[0]}/repository.git" || return 1
    done
}
prepare() {
    local repository="$1" path="$2" base="$3" alias="${4:-}"
    if [ ! -e "$path/.git" ]; then
        if "$shared"; then
            git --git-dir="$repository" worktree add --detach "$path" "$base"
        else
            if ! git --git-dir="$repository" show-ref --verify --quiet "refs/heads/agent/$id"; then
                git --git-dir="$repository" branch "agent/$id" "$base"
            fi
            git --git-dir="$repository" worktree add "$path" "agent/$id"
        fi
    elif ! present "$path" "$repository"; then
        echo 'Session worktree belongs to another repository. No process was started.' >&2; exit 3
    fi
    [ "$(git -C "$path" rev-parse HEAD)" = "$base" ] || { echo 'Initial worktree revision mismatch' >&2; exit 3; }
    # No process has been launched: finish a checkout interrupted after Git wrote HEAD.
    git -C "$path" reset --hard "$base"
    if [ -n "$alias" ]; then
        horizon-worker-source checkout "$path" --sibling "$alias"
    else
        horizon-worker-source checkout "$path"
    fi
}
# Per-session caches and test state that no other session on this worker shares.
session_data() { mkdir -p "/workspace/session-data/$id"; chmod 700 "/workspace/session-data/$id"; }
# The persisted binding fully determines the launch, so a relaunch reproduces it exactly.
# The tmux server must not inherit the session lock (fd 9), or a crash before the unlock
# would hold it for the server's lifetime.
launch() { tmux -L horizon-cloud new-session -d -s "$id" -c "$worktree" "horizon-worker-run $id $agent" 9>&-; }
if [ -n "$operation" ]; then
    # Replace a lost process only. Never create, reset or check out the worktree.
    [ -d "$session" ] || { echo 'Unknown session. No process was started.' >&2; exit 3; }
    # The process takes its browser identity from this container's running services.
    horizon-worker-check --ready >/dev/null
    exec 9>"/workspace/sessions/$id.lock"
    flock 9
    bound || { echo 'Session binding mismatch' >&2; exit 3; }
    load_layout
    fence="$session/relaunch-requested-$operation"
    # The operation that started the current process; an older operation's fence alone proves nothing.
    current="$session/relaunch-operation"
    if [ -f "$fence" ]; then
        if running && [ "$(cat "$current" 2>/dev/null)" = "$operation" ]; then exit 0; fi
        echo 'The process relaunched by this operation was lost or its launch is uncertain. No replacement process was started.' >&2; exit 4
    fi
    if running; then
        echo 'Session process is running. No replacement process was started.' >&2; exit 5
    fi
    if [ ! -f "$session/launch-requested" ] && [ -f "$session/preparing" ]; then
        echo 'Session was never launched; attaching starts it. No process was started.' >&2; exit 5
    fi
    if ! all_present; then
        echo 'Session worktree is missing or belongs to another repository. No replacement process was started.' >&2; exit 3
    fi
    session_data
    # Persist the fence before starting: a retry of this operation never starts a second process.
    touch "$fence"
    sync -f "$fence"
    printf '%s\n' "$operation" > "$current.new"
    sync -f "$current.new"
    mv "$current.new" "$current"
    # The rename must be durable too, so the fence and the record naming its operation survive together.
    sync -f "$current"
    rm -f "$session/exit-status"
    launch
    rm -f "$session/preparing"
    # Release the lock explicitly before exiting; the tmux server never holds it.
    flock -u 9
    printf 'Session relaunched in its existing worktree: %s\n' "$id"
    exit 0
fi
# A shared attach that ends before its launch fence leaves no session state behind, so a
# refusal never binds the session id. The shared checkout is never part of that state.
staging=
owner=
roll_back() {
    if [ -n "$staging" ]; then rm -rf "$staging"; fi
    # Only a directory carrying this attach's own marker was published by it.
    if [ -n "$owner" ] && [ ! -f "$session/launch-requested" ] \
        && [ "$(cat "$session/attach-owner" 2>/dev/null)" = "$owner" ]; then rm -rf "$session"; fi
}
trap roll_back EXIT
mkdir -p /workspace/sessions
exec 9>"/workspace/sessions/$id.lock"
flock 9
if [ -d "$session" ]; then
    bound || { echo 'Session binding mismatch' >&2; exit 3; }
    if ! running; then
        if [ -f "$session/launch-requested" ] || [ ! -f "$session/preparing" ]; then
            echo 'Remote process was lost or its launch is uncertain. No replacement process was started.' >&2; exit 4
        fi
    fi
else
    staging="$(mktemp -d /workspace/sessions/.preparing-XXXXXX)"
    printf '%s\n' "$agent" > "$staging/agent"
    printf '%s\n' "$revision" > "$staging/revision"
    if "$shared"; then touch "$staging/shared-checkout"; fi
    if [ -f /workspace/siblings.json ]; then
        horizon-worker-siblings show > "$staging/siblings.json"
        listing="$(horizon-worker-siblings layout "$staging/siblings.json")"
        [ -n "$listing" ] || rm "$staging/siblings.json"
    fi
    touch "$staging/preparing"
    # Claimed before the rename, so a signal right after it still rolls the binding back.
    if "$shared"; then
        owner="${staging##*/}"
        printf '%s\n' "$owner" > "$staging/attach-owner"
    fi
    mv "$staging" "$session"
    staging=
fi
load_layout
if ! running; then
    if "$shared"; then
        prepare_shared
    else
        if [ "$worktree" != "$root" ]; then mkdir -p "$root"; fi
        prepare /workspace/repository.git "$worktree" "$revision"
        for entry in "${siblings[@]}"; do
            read -r -a fields <<< "$entry"
            prepare "/workspace/siblings/${fields[0]}/repository.git" "$root/${fields[1]}" "${fields[2]}" "${fields[0]}"
        done
    fi
    session_data
    # Persist the launch fence before starting a process; an uncertain launch cannot be replayed.
    touch "$session/launch-requested"
    # Nothing launched yet: a fence that is not durable is withdrawn, or the next attach would
    # take the session for one whose launch is uncertain.
    sync -f "$session/launch-requested" || { rm -f "$session/launch-requested"; flush_failed "$session/launch-requested"; }
    launch
    rm "$session/preparing"
fi
flock -u 9
exec 9>&-
exec tmux -L horizon-cloud attach-session -t "=$id"
