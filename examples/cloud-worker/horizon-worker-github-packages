"""The package read access of the worker's GitHub access. GitHub's package API and its NuGet
registry take only a token with the `read:packages` scope, such as an OAuth app's token, which
a GitHub App's user token never has. Horizon gives this root service a token chain of such an
app (`horizon-worker-github packages`, JSON on stdin, never in argv or a log): its client ID,
an optional client secret and the chain. The service keeps it in a second chain store beside
the GitHub chain's, root-only, and renews it like that chain, with the client ID alone or with
the secret when one came, so it keeps working while Horizon is off. No agent gets it: no
variable, no file, no NuGet.Config. The API broker adds the access token only to the package
reads that the REST policy allows (horizon-worker-github-api-rest), and only for an owner of a
repository that the cloud's GitHub access grants. A module that horizon-worker-github loads,
not a command."""
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import re
import sys
import threading
import time


def load_common():
    name = 'horizon_worker_github_common'
    if name not in sys.modules:
        loader = importlib.machinery.SourceFileLoader(
            name, str(Path(__file__).resolve().with_name('horizon-worker-github-common')))
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
        sys.modules[name] = module
        loader.exec_module(module)
    return sys.modules[name]


common = load_common()
auth = common.auth

MAX_SOURCE = 4096
# Guards the creation of the one package chain store of each GitHub store.
STORES = threading.Lock()
FIELDS = {'version', 'client_id', 'client_secret', 'chain'}
# Fields a request may leave out.
OPTIONAL = {'client_id', 'client_secret'}
CLIENT_ID = re.compile(r'[A-Za-z0-9._-]{1,128}')
MISSING = ('this worker has no package read access, so GitHub\'s package API stays closed to agents. The person '
           'can give the cloud package read access in Horizon.')
REVOKED = ('the package read access of this worker ended (GitHub refused to renew it). The person can give the '
           'cloud package read access again in Horizon.')
EXPIRED = ('the package read access of this worker expired and was not renewed yet; try again in a minute. If '
           'this stays, the person can give the cloud package read access again in Horizon.')
REFUSED = ('GitHub refused the package read access of this worker. The person can give the cloud package read '
           'access again in Horizon.')


def store_for(store):
    """The chain store of the package read access, beside the GitHub chain's store: its own
    root-only directories on the volume and on tmpfs, with their own locks. One per GitHub
    store, so the broker sees a renewed chain that only the renewal's memory holds."""
    with STORES:
        if getattr(store, 'package_chains', None) is None:
            store.package_chains = common.Store(store.persistent.with_name(store.persistent.name + '-packages'),
                                                store.runtime.with_name(store.runtime.name + '-packages'))
        return store.package_chains


def parse(value, now):
    """The state to store for Horizon's request, or None to remove the package read access."""
    if not isinstance(value, dict) or not FIELDS - OPTIONAL <= set(value) <= FIELDS \
            or type(value['version']) is not int or value['version'] != 1:
        raise ValueError('Invalid package read access request')
    if value['chain'] is None:
        if set(value) != {'version', 'chain'}:
            raise ValueError('Invalid package read access request')
        return None
    if not isinstance(value.get('client_id'), str) or not CLIENT_ID.fullmatch(value['client_id']):
        raise ValueError('Invalid package read access client')
    if 'client_secret' in value and not auth.valid_token(value['client_secret']):
        raise ValueError('Invalid package read access client')
    chain = common.validate_chain(value['chain'])
    if chain['refresh_expires_at'] <= now:
        raise ValueError('The package read access chain expired')
    state = {'version': 1, 'state': 'ok', 'client_id': value['client_id'], 'chain': chain}
    if 'client_secret' in value:
        state['client_secret'] = value['client_secret']
    return state


def install(store, source, now=time.time):
    """Stores Horizon's chain in place of any earlier one, or removes it for a null chain.
    Returns what the worker holds now. The chain store's own lock serializes this with the
    renewal, which may rotate the stored chain at any time."""
    state = parse(json.loads(source), int(now()))
    chains = store_for(store)
    with chains.lock():
        if state is None:
            chains.clear()
        else:
            # A failed install keeps the earlier chain: GitHub did not cancel it.
            chains.save(state, retain=False)
    return {'packages': summary(store)}


def remove(store):
    """Removes the package read access, as when GitHub is disconnected."""
    chains = store_for(store)
    with chains.lock():
        chains.clear()


def summary(store):
    """What `status` reports: None, or the state and times of the chain, never a token."""
    state, persistent = store_for(store).load()
    if state is None:
        return None
    return {'state': state['state'], 'persistent': persistent,
            'access_expires_at': state['chain']['access_expires_at'],
            'refresh_expires_at': state['chain']['refresh_expires_at'],
            'last_refresh_at': state.get('last_refresh_at'), 'last_error': state.get('last_error')}


def load(store, now=time.time):
    """(access token, None) of the package read access, or (None, why there is none). A chain
    that is not stored yet, or whose access token is about to expire, serves nothing."""
    try:
        state, _ = store_for(store).load(serving=True)
    except (OSError, ValueError):
        state = None
    if state is None:
        return None, MISSING
    if state['state'] != 'ok':
        return None, REVOKED
    if state['chain']['access_expires_at'] - now() <= common.SERVE_MARGIN:
        return None, EXPIRED
    return state['chain']['access_token'], None


def owners(store, static=None):
    """The owners, in lowercase, of the repositories that the cloud's GitHub access grants:
    the grants of a chain that may serve, for the checkouts and for the whole cloud, and the
    static binding's. A revoked chain, or one that is not stored yet, opens no owner, and
    neither does a task grant."""
    state, _ = store.load(serving=True)
    if state is not None and state['state'] != 'ok':
        state = None
    names = [grant['repository'] for grant in state['grants'] + state.get('cloud_grants', [])] if state else []
    try:
        loaded = (static or auth.read_grants)()
    except (OSError, ValueError, RecursionError, UnicodeDecodeError):
        loaded = None
    names += [entry['repository'] for entry in loaded[1]] if loaded else []
    return {name.split('/')[0].casefold() for name in names}


def token_for(store, owner, static=None):
    """The token for a package read of `owner`, or the reason why there is none."""
    if owner.casefold() not in owners(store, static):
        return None, ('%s owns no repository that this worker has a GitHub grant for, so its packages stay closed.'
                      % owner)
    return load(store)


if __name__ == '__main__':
    raise SystemExit('horizon-worker-github-packages is a module of horizon-worker-github, not a command.')
