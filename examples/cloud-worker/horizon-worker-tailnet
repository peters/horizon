#!/usr/bin/python3
"""Root control lane for persistent cloud networking. Never prints private input."""
import fcntl
import json
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import tempfile
import time

STATE = Path('/workspace/.horizon-tailnet')
RUNTIME = Path('/run/horizon-tailnet')
PUBLIC = Path('/run/horizon-tailnet-devices')
USER = 10001
PROXY = 'socks5h://127.0.0.1:1055'
CLI = '/usr/local/bin/tailscale'
DAEMON = '/usr/local/bin/tailscaled'
SELF = '/usr/local/bin/horizon-worker-tailnet'


def private_directory(path):
    if path.is_symlink():
        raise ValueError()
    path.mkdir(mode=0o700, exist_ok=True)
    os.chmod(path, 0o700)
    info = path.stat()
    if info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o700:
        raise ValueError()


def call(*args, **kwargs):
    return subprocess.run([CLI, '--socket=' + str(RUNTIME / 'tailscaled.sock'), *args],
                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                          timeout=35, check=True, **kwargs).stdout


def start():
    private_directory(RUNTIME)
    pidfile = RUNTIME / 'supervisor.pid'
    if pidfile.exists():
        pid, started = pidfile.read_text().split()
        try:
            if Path('/proc', pid, 'stat').read_text().rsplit(') ', 1)[1].split()[19] == started:
                return
        except (OSError, IndexError):
            pass
    process = subprocess.Popen([SELF, 'serve'], stdin=subprocess.DEVNULL,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               start_new_session=True, env={'PATH': '/usr/local/bin:/usr/bin:/bin'})
    started = Path('/proc', str(process.pid), 'stat').read_text().rsplit(') ', 1)[1].split()[19]
    pidfile.write_text(f'{process.pid} {started}')


def serve():
    private_directory(STATE)
    private_directory(RUNTIME)
    # Userspace is provider-independent and does not grant agents NET_ADMIN.
    while True:
        child = subprocess.Popen([DAEMON, '--tun=userspace-networking',
                                  '--state=' + str(STATE / 'tailscaled.state'),
                                  '--socket=' + str(RUNTIME / 'tailscaled.sock'),
                                  '--socks5-server=127.0.0.1:1055',
                                  '--outbound-http-proxy-listen=127.0.0.1:1056'],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, env={'PATH': '/usr/local/bin:/usr/bin:/bin'})
        def stop(_signal, _frame):
            child.terminate()
            child.wait(timeout=5)
            sys.exit(0)
        signal.signal(signal.SIGTERM, stop)
        while child.poll() is None:
            try:
                publish_devices()
            except (OSError, ValueError, subprocess.SubprocessError):
                pass
            time.sleep(5)
        time.sleep(2)


def publish_devices():
    report = json.loads(call('status', '--json'))
    PUBLIC.mkdir(mode=0o755, exist_ok=True)
    os.chmod(PUBLIC, 0o755)
    own = report.get('Self')
    values = ([own] if own else []) + list((report.get('Peer') or {}).values())
    devices = [{'name': value.get('DNSName') or value.get('HostName', ''),
                'addresses': value.get('TailscaleIPs', []), 'online': bool(value.get('Online'))}
               for value in values]
    fd, name = tempfile.mkstemp(dir=PUBLIC, prefix='devices-')
    pending = Path(name)
    try:
        with os.fdopen(fd, 'w') as output:
            json.dump({'devices': devices}, output)
        os.chmod(pending, 0o644)
        os.replace(pending, PUBLIC / 'devices.json')
    finally:
        pending.unlink(missing_ok=True)


def status(wait=False):
    deadline = time.monotonic() + (5 if wait else 0)
    while True:
        result = json.loads(call('status', '--json'))
        state = result.get('BackendState')
        if state in {'Running', 'NeedsLogin'}:
            return state
        if time.monotonic() >= deadline:
            raise ValueError()
        time.sleep(0.1)


def prepare_agents():
    # The mount's top level is root-owned, so an agent cannot replace the private
    # directory or install startup code. FUSE volumes synthesizing permissive modes fail.
    workspace = Path('/workspace')
    info = workspace.lstat()
    if info.st_uid != 0 or info.st_mode & 0o022 or workspace.is_symlink():
        raise ValueError()
    subprocess.run(['/usr/bin/id', '-u', 'horizon-agent'], check=True, stdout=subprocess.DEVNULL)
    # Do not enroll alongside a pre-existing privileged agent. Stop and resume first.
    for process in Path('/proc').iterdir():
        if not process.name.isdecimal():
            continue
        try:
            command = (process / 'cmdline').read_bytes().split(b'\0')
            if process.stat().st_uid == 0 and any(Path(os.fsdecode(arg)).name in
                    {'codex', 'claude', 'grok', 'horizon-worker-run'} for arg in command if arg):
                raise ValueError()
        except (FileNotFoundError, PermissionError):
            pass
    (RUNTIME / 'agent-isolation').touch(mode=0o600)


def configure():
    request = json.loads(sys.stdin.buffer.read(4097))
    if set(request) != {'tailnet', 'key'}:
        raise ValueError()
    identity, key = request['tailnet'], request['key']
    if identity is not None and (not isinstance(identity, str) or not re.fullmatch(r'[A-Za-z0-9-]{1,64}', identity)):
        raise ValueError()
    if key is not None and (not isinstance(key, str) or not re.fullmatch(r'tskey-auth-[A-Za-z0-9-]{20,245}', key)):
        raise ValueError()
    private_directory(STATE)
    private_directory(RUNTIME)
    with open(RUNTIME / 'control.lock', 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        selected = STATE / 'selection'
        old = selected.read_text() if selected.exists() else ''
        if identity is None:
            if old:
                start()
                wait_socket()
                call('logout')
                selected.unlink()
            print('ready')
            return
        prepare_agents()
        start()
        wait_socket()
        if old and old != identity:
            call('logout')
        backend = status(wait=True)
        if old == identity and backend == 'Running':
            print('ready')
            return
        # A reconnect timeout is not proof that a persistent identity needs login.
        if backend != 'NeedsLogin':
            raise ValueError()
        if key is None:
            print('needs_key')
            return
        selected.write_text(identity)
        os.chmod(selected, 0o600)
        with open(selected, 'rb') as saved:
            os.fsync(saved.fileno())
        directory = os.open(STATE, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
        # An anonymous memory file avoids argv/environment/filesystem auth-key exposure.
        fd = os.memfd_create('tailnet-enrollment', os.MFD_CLOEXEC)
        try:
            os.write(fd, key.encode())
            call('up', '--auth-key=file:/proc/self/fd/' + str(fd), '--accept-dns=false',
                 '--timeout=30s', pass_fds=(fd,))
        finally:
            os.close(fd)
        if status(wait=True) != 'Running':
            raise ValueError()
        publish_devices()
        print('ready')


def wait_socket():
    deadline = time.monotonic() + 10
    while not (RUNTIME / 'tailscaled.sock').exists():
        if time.monotonic() > deadline:
            raise ValueError()
        time.sleep(0.1)


def agent(arguments):
    # Tailnet-enabled agents share the network, never the controller privilege.
    if os.geteuid() != 0:
        raise ValueError()
    worktree = Path.cwd().resolve()
    if not worktree.is_relative_to('/workspace'):
        worktree = Path('/workspace')
        os.chdir(worktree)
    if worktree.is_relative_to(STATE):
        raise ValueError()
    # All workspace code and tool services run with the same unprivileged identity.
    # The mount root and networking directories stay owned by the control lane.
    folders = ['home', 'agents', 'sessions', 'session-data', 'locks', 'credentials',
               'checkout', 'worktrees', 'companions', 'siblings', 'source', 'repository.git', '.horizon']
    files = ['agent-mcp.json', 'capabilities.json', 'siblings.json', 'horizon-transfer.pack',
             'horizon-source.tar', 'import.lock', 'source.lock', 'shared-checkout.lock', 'session-env.log', 'device.json',
             'shared-checkout.status', 'shared-checkout.log']
    roots = ([] if worktree == Path('/workspace') else [worktree]) + [Path('/workspace', name) for name in folders + files]
    for root in roots:
        if root.is_symlink():
            raise ValueError()
        if root.name in folders:
            root.mkdir(exist_ok=True)
        if root.name in {'agent-mcp.json', 'device.json', 'import.lock', 'source.lock', 'shared-checkout.lock', 'session-env.log'}:
            root.touch(exist_ok=True)
        if root.exists():
            subprocess.run(['/usr/bin/chown', '-R', '--no-dereference', f'{USER}:{USER}', str(root)], check=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    credentials = Path('/run/horizon-credentials')
    if credentials.is_symlink():
        raise ValueError()
    credentials.mkdir(mode=0o700, exist_ok=True)
    subprocess.run(['/usr/bin/chown', '-R', '--no-dereference', f'{USER}:{USER}', str(credentials)], check=True)
    transfers = Path('/workspace/source/transfers')
    if transfers.is_symlink():
        raise ValueError()
    transfers.mkdir(exist_ok=True)
    for name in ['horizon-transfer.pack', 'horizon-source.tar']:
        incoming = Path('/workspace', name)
        if incoming.exists():
            os.replace(incoming, transfers / name)
    subprocess.run(['/usr/bin/chown', '-R', '--no-dereference', f'{USER}:{USER}', str(transfers)], check=True)
    environment = dict(os.environ)
    environment['HORIZON_UNPRIVILEGED'] = '1'
    environment['HORIZON_WORKER_SELF_STOP_AVAILABLE'] = '1' if environment.get('RUNPOD_POD_ID') and environment.get('RUNPOD_API_KEY') else '0'
    environment['HOME'] = '/workspace/home'
    for name in list(environment):
        if name.startswith(('TS_', 'TAILSCALE_')) or name == 'RUNPOD_API_KEY':
            environment.pop(name)
    if (STATE / 'selection').exists():
        environment.update(ALL_PROXY=PROXY, all_proxy=PROXY,
                           HTTP_PROXY='http://127.0.0.1:1056', HTTPS_PROXY='http://127.0.0.1:1056',
                           http_proxy='http://127.0.0.1:1056', https_proxy='http://127.0.0.1:1056',
                           NO_PROXY='localhost,127.0.0.1,::1', no_proxy='localhost,127.0.0.1,::1')
    os.execve('/usr/bin/setpriv', ['setpriv', '--reuid=' + str(USER), '--regid=' + str(USER),
                                 '--clear-groups', '--no-new-privs', '--bounding-set=-all', '--', *arguments], environment)


def main():
    if sys.argv[1:] == ['configure']:
        configure()
    elif sys.argv[1:] == ['isolate']:
        private_directory(RUNTIME)
        prepare_agents()
        agent(['/usr/bin/true'])
    elif sys.argv[1:] == ['resume']:
        if (STATE / 'selection').exists():
            private_directory(RUNTIME)
            (RUNTIME / 'agent-isolation').touch(mode=0o600)
            start()
    elif sys.argv[1:] == ['serve']:
        serve()
    elif sys.argv[1:] == ['status']:
        # No credential or daemon state is returned.
        print('joined' if (STATE / 'selection').exists() and status() == 'Running' else 'none')
    elif len(sys.argv) >= 3 and sys.argv[1] == 'agent':
        agent(sys.argv[2:])
    else:
        raise ValueError()


if __name__ == '__main__':
    try:
        main()
    except Exception:
        print('Tailnet operation failed. Check key validity, worker storage permissions and restart privileged sessions.', file=sys.stderr)
        sys.exit(1)
