#!/bin/bash
set -u
# Re-enter once through the protected launcher; it drops privileges before any user code.
if [ "$(id -u)" = 0 ] && [ -f /run/horizon-tailnet/agent-isolation ]; then
    exec horizon-worker-tailnet agent /usr/local/bin/horizon-worker-run "$@"
fi
id="$1"; agent="$2"
if [ "$agent" = companion ]; then
    [[ "$id" =~ ^[a-zA-Z0-9_-]{1,100}$ ]] || exit 2
    export HOME=/workspace/home
    cd "/workspace/companions/worktrees/$id" || exit 3
    if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
        exec /bin/bash -c "$SSH_ORIGINAL_COMMAND"
    fi
    exec /bin/bash
fi
# Image layers' session environment reaches the agent process exactly as written, through
# env at launch, so this shell never interprets it. Names this script sets are refused.
refuse_session_env() {
    printf '%s\n' "$1" >&2
    printf '%s session %s: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$id" "$1" >> /workspace/session-env.log
    printf '3\n' > "/workspace/sessions/$id/exit-status"
    printf '\nThe session environment was refused, so no process was started.\n'
    exec sleep infinity
}
session_env="$(mktemp)"
if ! refusal="$(horizon-worker-session-env apply 2>&1 >"$session_env")"; then
    rm -f "$session_env"
    refuse_session_env "$refusal"
fi
mapfile -d '' -t session_env_assignments < "$session_env"
rm -f "$session_env"
export HOME=/workspace/home DISPLAY=:99 HORIZON_BROWSER_ROOT=/workspace/home/.horizon
export HORIZON_CLOUD_ACTOR="cloud:$id" HORIZON_BROWSER_ACTOR="horizon:cloud-$id"
export HORIZON_DEVICE_ACTOR="horizon:cloud-$id"
# Created by horizon-worker-session: this session's private caches and test state.
export HORIZON_SESSION_DIR="/workspace/session-data/$id"
# Shared by every session on this worker; see horizon-worker-gpu-lock.
mkdir -p /workspace/locks
export HORIZON_GPU_LOCK=/workspace/locks/gpu.lock
unset HORIZON HORIZON_BROWSER_HOST_INSTANCE
# The root supervisor publishes the control service's browser host instance here after the
# service answers. It removes the file at start and stop, so the read itself decides the fallback.
host_instance=/run/horizon-worker/browser-host-instance
if host_value="$(cat "$host_instance" 2>/dev/null)" && [ -n "$host_value" ]; then
    export HORIZON_BROWSER_HOST_INSTANCE="$host_value"
else
    printf 'The worker has not published its browser host instance (%s); browser tools in this session cannot identify their workspace.\n' "$host_instance" >&2
fi
[ "$agent" != shell ] || agent=bash
if [ "$agent" = claude ]; then
    # Readiness requires the runtime version recorded by the image.
    export DISABLE_AUTOUPDATER=1
    if [ -f /workspace/credentials/anthropic-api-key ]; then
        ANTHROPIC_API_KEY="$(cat /workspace/credentials/anthropic-api-key)"
        export ANTHROPIC_API_KEY
    fi
    if [ -f /workspace/credentials/anthropic-workspace ]; then
        ANTHROPIC_WORKSPACE_ID="$(cat /workspace/credentials/anthropic-workspace)"
        export ANTHROPIC_WORKSPACE_ID
        export ANTHROPIC_CUSTOM_HEADERS="anthropic-workspace-id: $ANTHROPIC_WORKSPACE_ID"
    fi
    # A worker is a disposable container, so its person has already chosen to run Claude Code
    # here: skip the first-run dialogs (theme, the API key, trusting the folder) rather than
    # leave every new panel asking them. Failing to seed only brings the dialogs back.
    python3 - <<'PY' || true
import fcntl, json, os
home = os.environ['HOME']
path = home + '/.claude.json'
key = os.environ.get('ANTHROPIC_API_KEY', '').strip()
# Claude keeps approvals by the last 20 characters. A key no longer than that would be copied
# whole, so it is not approved here and Claude asks about it as usual.
tail = key[-20:] if len(key) > 20 else ''


def current():
    try:
        with open(path, 'rb') as saved:
            return saved.read()
    except FileNotFoundError:
        return b''


def seeded(raw):
    try:
        config = json.loads(raw)
    except ValueError:
        config = {}
    if not isinstance(config, dict):
        config = {}
    config['hasCompletedOnboarding'] = True
    config.setdefault('theme', 'dark')
    projects = config.get('projects')
    if not isinstance(projects, dict):
        projects = config['projects'] = {}
    # Trust covers the folders below it: the checkout, the worktrees agents add, siblings.
    entry = projects.get('/workspace')
    if not isinstance(entry, dict):
        entry = projects['/workspace'] = {}
    entry['hasTrustDialogAccepted'] = True
    entry['hasCompletedProjectOnboarding'] = True
    if tail:
        answers = config.get('customApiKeyResponses')
        if not isinstance(answers, dict):
            answers = config['customApiKeyResponses'] = {}
        answers['approved'] = list(dict.fromkeys([*answers.get('approved', []), tail]))
        answers['rejected'] = [other for other in answers.get('rejected', []) if other != tail]
    return config


with open(path + '.horizon-lock', 'a') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    # Claude saves this file without taking the lock, so write only when something is missing,
    # and start over if it changed while the update was prepared.
    for _ in range(5):
        raw = current()
        try:
            unchanged = json.loads(raw) == seeded(raw)
        except ValueError:
            unchanged = False
        if unchanged:
            break
        pending = path + '.horizon-new'
        descriptor = os.open(pending, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(descriptor, 'w') as out:
            json.dump(seeded(raw), out)
        if current() == raw:
            os.replace(pending, path)
            break
PY
    # The first launch assigns an id. Resume only after Claude has written that
    # session's transcript; an id with no transcript must be started again.
    session_file="/workspace/sessions/$id/agent-session"
    if [ -s "$session_file" ]; then
        session_id="$(tr -d '[:space:]' < "$session_file")"
    else
        session_id="$(tr -d '[:space:]' < /proc/sys/kernel/random/uuid)"
        printf '%s\n' "$session_id" > "$session_file"
    fi
    claude_args=(--session-id "$session_id")
    if [ -n "$session_id" ]; then
        for transcript in /workspace/home/.claude/projects/*/"$session_id".jsonl; do
            if [ -f "$transcript" ]; then
                claude_args=(--resume "$session_id")
                break
            fi
        done
    fi
    env -- "${session_env_assignments[@]}" claude "${claude_args[@]}" --mcp-config /workspace/agent-mcp.json
elif [ "$agent" = grok ]; then
    env -- "${session_env_assignments[@]}" grok --no-leader
else
    env -- "${session_env_assignments[@]}" "$agent"
fi
status=$?
printf '%s\n' "$status" > "/workspace/sessions/$id/exit-status"
printf '\nSession process exited with status %s. Reconnect preserves this result.\n' "$status"
# Preserve terminal output and report process loss instead of silently restarting.
exec sleep infinity
