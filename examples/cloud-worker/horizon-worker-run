#!/bin/bash
set -u
# Re-enter once through the protected launcher; it drops privileges before any user code.
if [ "$(id -u)" = 0 ] && [ -f /run/horizon-tailnet/agent-isolation ]; then
    exec horizon-worker-tailnet agent /usr/local/bin/horizon-worker-run "$@"
fi
id="$1"; agent="$2"
if [ "$agent" = companion ]; then
    [[ "$id" =~ ^[a-zA-Z0-9_-]{1,100}$ ]] || exit 2
    export HOME=/workspace/home
    cd "/workspace/companions/worktrees/$id" || exit 3
    if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
        exec /bin/bash -c "$SSH_ORIGINAL_COMMAND"
    fi
    exec /bin/bash
fi
# Image layers' session environment reaches the agent process exactly as written, through
# env at launch, so this shell never interprets it. Names this script sets are refused.
refuse_session_env() {
    printf '%s\n' "$1" >&2
    printf '%s session %s: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$id" "$1" >> /workspace/session-env.log
    printf '3\n' > "/workspace/sessions/$id/exit-status"
    printf '\nThe session environment was refused, so no process was started.\n'
    exec sleep infinity
}
session_env="$(mktemp)"
if ! refusal="$(horizon-worker-session-env apply 2>&1 >"$session_env")"; then
    rm -f "$session_env"
    refuse_session_env "$refusal"
fi
mapfile -d '' -t session_env_assignments < "$session_env"
rm -f "$session_env"
export HOME=/workspace/home DISPLAY=:99 HORIZON_BROWSER_ROOT=/workspace/home/.horizon
export HORIZON_CLOUD_ACTOR="cloud:$id" HORIZON_BROWSER_ACTOR="horizon:cloud-$id"
export HORIZON_DEVICE_ACTOR="horizon:cloud-$id"
# Created by horizon-worker-session: this session's private caches and test state.
export HORIZON_SESSION_DIR="/workspace/session-data/$id"
# Shared by every session on this worker; see horizon-worker-gpu-lock.
mkdir -p /workspace/locks
export HORIZON_GPU_LOCK=/workspace/locks/gpu.lock
unset HORIZON HORIZON_BROWSER_HOST_INSTANCE
# The root supervisor publishes the control service's browser host instance here after the
# service answers. It removes the file at start and stop, so the read itself decides the fallback.
host_instance=/run/horizon-worker/browser-host-instance
if host_value="$(cat "$host_instance" 2>/dev/null)" && [ -n "$host_value" ]; then
    export HORIZON_BROWSER_HOST_INSTANCE="$host_value"
else
    printf 'The worker has not published its browser host instance (%s); browser tools in this session cannot identify their workspace.\n' "$host_instance" >&2
fi
# Auto mode: Claude and Codex run commands and edit files without asking. The worker is a
# disposable container and this process runs as the unprivileged agent account, so the
# container is the boundary. A profile with `agent_approvals: ask` keeps the prompts, and so
# does an agent that runs as root (an image without agent isolation) or a worker whose
# selection cannot be read.
approvals=ask
if [ "$(id -u)" != 0 ]; then
    approvals="$(/usr/bin/python3 -I - <<'PY' 2>/dev/null
with open('/run/horizon-worker/agent-approvals') as policy:
    approvals = policy.read()
if approvals not in ('auto\n', 'ask\n'):
    raise SystemExit(1)
approvals = approvals.strip()
print(approvals)
PY
)" || approvals=ask
    [ "$approvals" = auto ] || approvals=ask
fi
# A person can start claude by hand in a Shell panel, so the shell gets the same key,
# workspace and first-run settings as a Claude panel, whichever of the two opened first.
if [ "$agent" = claude ] || [ "$agent" = shell ]; then
    # Readiness requires the runtime version recorded by the image.
    export DISABLE_AUTOUPDATER=1
    if [ -f /workspace/credentials/anthropic-api-key ]; then
        ANTHROPIC_API_KEY="$(cat /workspace/credentials/anthropic-api-key)"
        export ANTHROPIC_API_KEY
    fi
    if [ -f /workspace/credentials/anthropic-workspace ]; then
        ANTHROPIC_WORKSPACE_ID="$(cat /workspace/credentials/anthropic-workspace)"
        export ANTHROPIC_WORKSPACE_ID
        export ANTHROPIC_CUSTOM_HEADERS="anthropic-workspace-id: $ANTHROPIC_WORKSPACE_ID"
    fi
    # A worker is a disposable container, so its person has already chosen to run Claude Code
    # here: skip the first-run dialogs (theme, the API key, trusting the folder) rather than
    # leave every new panel asking them. Failing to seed only brings the dialogs back. In
    # auto mode, it also accepts the one-time warning that Claude shows for skipped prompts.
    # Isolated mode: the current folder is the repository, and none of its files may be
    # imported here.
    SEED_BYPASS="$([ "$approvals" = auto ] && echo 1)" python3 -I - <<'PY' || true
import fcntl, glob, json, os
home = os.environ['HOME']
bypass = os.environ.get('SEED_BYPASS') == '1'
path = home + '/.claude.json'
key = os.environ.get('ANTHROPIC_API_KEY', '').strip()
# Claude keeps approvals by the last 20 characters. A key no longer than that would be copied
# whole, so it is not approved here and Claude asks about it as usual.
tail = key[-20:] if len(key) > 20 else ''
# Claude keeps the trust of a Git worktree under its repository, and here all worktrees of a
# repository share one bare repository: the checkout, each session's worktree, the worktrees
# an agent adds, and for a sibling its own. A person's answer is saved there too. Trust for
# /workspace stops at a repository, so it covers only the folders outside one.
trusted = ['/workspace', '/workspace/repository.git', *sorted(glob.glob('/workspace/siblings/*/repository.git'))]


def current():
    try:
        with open(path, 'rb') as saved:
            return saved.read()
    except FileNotFoundError:
        return b''


def seeded(raw):
    try:
        config = json.loads(raw)
    except ValueError:
        config = {}
    if not isinstance(config, dict):
        config = {}
    # Claude saves only the settings that differ from its defaults, so no theme is recorded:
    # dark is its default. Nor is the project onboarding flag, which Claude no longer reads
    # and drops. A key that Claude removes would make every launch write the file again.
    config['hasCompletedOnboarding'] = True
    projects = config.get('projects')
    if not isinstance(projects, dict):
        projects = config['projects'] = {}
    for folder in trusted:
        entry = projects.get(folder)
        if not isinstance(entry, dict):
            entry = projects[folder] = {}
        entry['hasTrustDialogAccepted'] = True
    if tail:
        answers = config.get('customApiKeyResponses')
        if not isinstance(answers, dict):
            answers = config['customApiKeyResponses'] = {}
        answers['approved'] = list(dict.fromkeys([*answers.get('approved', []), tail]))
        answers['rejected'] = [other for other in answers.get('rejected', []) if other != tail]
    if bypass:
        config['bypassPermissionsModeAccepted'] = True
    return config


with open(path + '.horizon-lock', 'a') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    # Claude saves this file without taking the lock, so write only when something is missing,
    # and start over if it changed while the update was prepared.
    for _ in range(5):
        raw = current()
        try:
            unchanged = json.loads(raw) == seeded(raw)
        except ValueError:
            unchanged = False
        if unchanged:
            break
        pending = path + '.horizon-new'
        descriptor = os.open(pending, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(descriptor, 'w') as out:
            json.dump(seeded(raw), out)
        if current() == raw:
            os.replace(pending, path)
            break
PY
fi
[ "$agent" != shell ] || agent=bash
if [ "$agent" = claude ]; then
    # The first launch assigns an id. Resume only after Claude has written that
    # session's transcript; an id with no transcript must be started again.
    session_file="/workspace/sessions/$id/agent-session"
    if [ -s "$session_file" ]; then
        session_id="$(tr -d '[:space:]' < "$session_file")"
    else
        session_id="$(tr -d '[:space:]' < /proc/sys/kernel/random/uuid)"
        printf '%s\n' "$session_id" > "$session_file"
    fi
    claude_args=(--session-id "$session_id")
    if [ -n "$session_id" ]; then
        for transcript in /workspace/home/.claude/projects/*/"$session_id".jsonl; do
            if [ -f "$transcript" ]; then
                claude_args=(--resume "$session_id")
                break
            fi
        done
    fi
    if [ "$approvals" = auto ]; then
        claude_args+=(--dangerously-skip-permissions)
    else
        # A saved user setting or resumed session must not keep a previous bypass mode.
        claude_args+=(--permission-mode default)
    fi
    env -- "${session_env_assignments[@]}" claude "${claude_args[@]}" --mcp-config /workspace/agent-mcp.json
elif [ "$agent" = grok ]; then
    env -- "${session_env_assignments[@]}" grok --no-leader
elif [ "$agent" = codex ]; then
    # Codex 0.156 and later start a shared background server, which refuses a control socket
    # folder that other users could write to. A network volume can report every folder as
    # writable by anyone to the agent user (RunPod's does), so Codex ends before it opens.
    # tmux already keeps the session running, so start without that server. An older Codex
    # has neither the server nor the option; the probe uses the PATH that the launch uses.
    codex_args=()
    if env -- "${session_env_assignments[@]}" codex --help 2>/dev/null | grep -q -e '--no-daemon'; then
        codex_args=(--no-daemon)
    fi
    if [ "$approvals" = auto ]; then
        # Codex asks once per repository folder whether to trust it, and only an entry for that
        # exact folder answers it; one for /workspace does not. This session's folder is trusted
        # like Claude's. An existing decision for it is kept, and failing to write only brings the
        # question back. The session environment can name another CODEX_HOME. Isolated mode: the
        # current folder is the repository, and none of its files may be imported here.
        env -- "${session_env_assignments[@]}" python3 -I - <<'PY' || true
import fcntl, json, os, tomllib
home = os.environ.get('CODEX_HOME') or os.path.join(os.environ['HOME'], '.codex')
path = os.path.join(home, 'config.toml')
folder = os.path.realpath(os.getcwd())


def addition(raw):
    # None: nothing to add, or a file Codex itself would refuse, which stays as it is.
    try:
        text = raw.decode()
        projects = tomllib.loads(text).get('projects', {})
        if not isinstance(projects, dict) or folder in projects:
            return None
    except (UnicodeDecodeError, tomllib.TOMLDecodeError):
        return None
    entry = f'\n[projects.{json.dumps(folder)}]\ntrust_level = "trusted"\n'
    try:
        tomllib.loads(text + entry)
    except tomllib.TOMLDecodeError:
        return None
    return entry


os.makedirs(home, mode=0o700, exist_ok=True)
with open(path + '.horizon-lock', 'a') as lock:
    # Launchers serialize on this lock, so two sessions never add the same entry. Codex saves
    # the file without it, so the entry is appended and the file is never replaced: a save
    # by a running Codex is never lost. The check and the append use one open file, so a
    # replacement by Codex at the same moment can only detach the entry from config.toml,
    # and the question then comes back once.
    fcntl.flock(lock, fcntl.LOCK_EX)
    descriptor = os.open(path, os.O_RDWR | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(descriptor, 'r+b') as saved:
        entry = addition(saved.read())
        if entry is not None:
            saved.write(entry.encode())
PY
        # Bypasses the sandbox too: where the container denies user namespaces, as RunPod's
        # does, the sandbox cannot start and every command would ask to run without it.
        codex_args+=(--dangerously-bypass-approvals-and-sandbox)
    else
        # CLI overrides also cover folders trusted by a previous auto-mode session: a
        # repository's project configuration must not disable the requested protections.
        codex_args+=(--config 'approval_policy="on-request"' --sandbox workspace-write)
    fi
    env -- "${session_env_assignments[@]}" codex "${codex_args[@]}"
else
    env -- "${session_env_assignments[@]}" "$agent"
fi
status=$?
printf '%s\n' "$status" > "/workspace/sessions/$id/exit-status"
printf '\nSession process exited with status %s. Reconnect preserves this result.\n' "$status"
# Preserve terminal output and report process loss instead of silently restarting.
exec sleep infinity
