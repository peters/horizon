#!/bin/bash
set -u
id="$1"; agent="$2"
if [ "$agent" = companion ]; then
    [[ "$id" =~ ^[a-zA-Z0-9_-]{1,100}$ ]] || exit 2
    export HOME=/workspace/home
    cd "/workspace/companions/worktrees/$id" || exit 3
    if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
        exec /bin/bash -c "$SSH_ORIGINAL_COMMAND"
    fi
    exec /bin/bash
fi
# Image layers' session environment reaches the agent process exactly as written, through
# env at launch, so this shell never interprets it. Names this script sets are refused.
refuse_session_env() {
    printf '%s\n' "$1" >&2
    printf '%s session %s: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$id" "$1" >> /workspace/session-env.log
    printf '3\n' > "/workspace/sessions/$id/exit-status"
    printf '\nThe session environment was refused, so no process was started.\n'
    exec sleep infinity
}
session_env="$(mktemp)"
if ! refusal="$(horizon-worker-session-env apply 2>&1 >"$session_env")"; then
    rm -f "$session_env"
    refuse_session_env "$refusal"
fi
mapfile -d '' -t session_env_assignments < "$session_env"
rm -f "$session_env"
export HOME=/workspace/home DISPLAY=:99 HORIZON_BROWSER_ROOT=/workspace/home/.horizon
export HORIZON_CLOUD_ACTOR="cloud:$id" HORIZON_BROWSER_ACTOR="horizon:cloud-$id"
export HORIZON_DEVICE_ACTOR="horizon:cloud-$id"
# Created by horizon-worker-session: this session's private caches and test state.
export HORIZON_SESSION_DIR="/workspace/session-data/$id"
# Shared by every session on this worker; see horizon-worker-gpu-lock.
mkdir -p /workspace/locks
export HORIZON_GPU_LOCK=/workspace/locks/gpu.lock
unset HORIZON
export HORIZON_BROWSER_HOST_INSTANCE="$(cat "$HORIZON_BROWSER_ROOT/cloud-host-instance")"
[ "$agent" != shell ] || agent=bash
if [ "$agent" = claude ]; then
    # Readiness requires the runtime version recorded by the image.
    export DISABLE_AUTOUPDATER=1
    if [ -f /workspace/credentials/anthropic-api-key ]; then
        ANTHROPIC_API_KEY="$(cat /workspace/credentials/anthropic-api-key)"
        export ANTHROPIC_API_KEY
    fi
    if [ -f /workspace/credentials/anthropic-workspace ]; then
        ANTHROPIC_WORKSPACE_ID="$(cat /workspace/credentials/anthropic-workspace)"
        export ANTHROPIC_WORKSPACE_ID
        export ANTHROPIC_CUSTOM_HEADERS="anthropic-workspace-id: $ANTHROPIC_WORKSPACE_ID"
    fi
    # The first launch assigns an id. Resume only after Claude has written that
    # session's transcript; an id with no transcript must be started again.
    session_file="/workspace/sessions/$id/agent-session"
    if [ -s "$session_file" ]; then
        session_id="$(tr -d '[:space:]' < "$session_file")"
    else
        session_id="$(tr -d '[:space:]' < /proc/sys/kernel/random/uuid)"
        printf '%s\n' "$session_id" > "$session_file"
    fi
    claude_args=(--session-id "$session_id")
    if [ -n "$session_id" ]; then
        for transcript in /workspace/home/.claude/projects/*/"$session_id".jsonl; do
            if [ -f "$transcript" ]; then
                claude_args=(--resume "$session_id")
                break
            fi
        done
    fi
    env -- "${session_env_assignments[@]}" claude "${claude_args[@]}" --mcp-config /workspace/agent-mcp.json
elif [ "$agent" = grok ]; then
    env -- "${session_env_assignments[@]}" grok --no-leader
else
    env -- "${session_env_assignments[@]}" "$agent"
fi
status=$?
printf '%s\n' "$status" > "/workspace/sessions/$id/exit-status"
printf '\nSession process exited with status %s. Reconnect preserves this result.\n' "$status"
# Preserve terminal output and report process loss instead of silently restarting.
exec sleep infinity
