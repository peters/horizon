#!/usr/bin/python3
"""Import only selected source objects; each agent keeps a separate module checkout."""
import fcntl
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import unicodedata

PRIMARY = Path('/workspace/source')
AGENTS = Path('/workspace/agents')
SHARED = Path('/workspace/checkout')


def material(alias=None):
    if alias is None:
        return PRIMARY
    if not re.fullmatch(r'[a-z][a-z0-9_-]{0,63}', alias):
        raise ValueError('Invalid sibling alias')
    return Path('/workspace/siblings') / alias / 'source'


def git(*args, **kwargs):
    subprocess.run(['git', *map(str, args)], check=True, **kwargs)


def lfs_selection(value):
    # The same rules as Horizon's source.lfs validation: lists of at most 64 patterns in
    # all, each a non-empty string of at most 256 characters without commas (git-lfs
    # joins them with commas) or Unicode control, format, surrogate or private-use
    # characters (unassigned ones depend on the Unicode version, so both ends allow them); skipped entries name exactly one LFS object each. git-lfs never lists
    # an empty object, nor a path with a newline in a way lfs_paths can read, so
    # neither can be one it excludes; Horizon sends both.
    selection = value.get('lfs', {})
    if not isinstance(selection, dict) or set(selection) - {'include', 'exclude', 'skipped'}:
        raise ValueError('Invalid LFS selection')
    patterns = {key: selection.get(key, []) for key in ('include', 'exclude')}
    if any(not isinstance(listed, list) for listed in patterns.values()) \
            or len(patterns['include']) + len(patterns['exclude']) > 64:
        raise ValueError('Invalid LFS selection')
    for pattern in patterns['include'] + patterns['exclude']:
        if not isinstance(pattern, str) or not pattern or len(pattern) > 256 \
                or any(c == ',' or unicodedata.category(c) in ('Cc', 'Cf', 'Cs', 'Co') for c in pattern):
            raise ValueError('Invalid LFS selection pattern')
    skipped = selection.get('skipped', [])
    if not isinstance(skipped, list) or any(
            not isinstance(asset, dict) or set(asset) != {'path', 'oid', 'size'} or not isinstance(asset['path'], str)
            or not isinstance(asset['oid'], str) or not re.fullmatch(r'[0-9a-f]{64}', asset['oid'])
            or type(asset['size']) is not int or asset['size'] < 0 for asset in skipped):
        raise ValueError('Invalid LFS selection')
    if any(asset['size'] == 0 for asset in skipped):
        raise ValueError('An empty LFS object is always transferred; a selection cannot skip it')
    if any('\n' in asset['path'] for asset in skipped):
        raise ValueError('An LFS path with a newline is always transferred; a selection cannot skip it')
    return patterns, skipped


def manifest(root):
    value = json.loads((root / 'manifest.json').read_text())
    _, skipped = lfs_selection(value)
    for item in value['modules'] + value['assets'] + skipped:
        path = PurePosixPath(item['path'])
        if path.is_absolute() or not path.parts or any(p in ('.', '..', '.git') for p in path.parts):
            raise ValueError('Invalid committed source path')
    return value


def staging(alias=None):
    # Each sibling has its own upload path, so no upload can replace another repository's.
    return material(alias).parent / 'horizon-source.tar' if alias else Path('/workspace/horizon-source.tar')


def import_source(root, upload):
    with tempfile.TemporaryDirectory(dir='/workspace') as temporary:
        folder = Path(temporary)
        with tarfile.open(upload) as archive:
            if any(not (m.isfile() or m.isdir()) for m in archive.getmembers()):
                raise ValueError('Unexpected source archive member')
            archive.extractall(folder, filter='data')
        value = manifest(folder)
        if (root / 'manifest.json').exists() and manifest(root) != value:
            raise ValueError('Cloud source dependency identity mismatch')
        root.mkdir(parents=True, exist_ok=True)
        for asset in value['assets']:
            oid = asset['oid']
            if len(oid) != 64 or any(c not in '0123456789abcdef' for c in oid):
                raise ValueError('Invalid LFS object identity')
            content = folder / 'lfs' / oid
            with content.open('rb') as stream:
                digest = hashlib.file_digest(stream, 'sha256').hexdigest()
            if digest != oid or content.stat().st_size != asset['size']:
                raise ValueError('LFS transfer checksum mismatch')
            destination = root / 'lfs' / 'objects' / oid[:2] / oid[2:4] / oid
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(content, destination)
        for index, module in enumerate(value['modules']):
            repo = root / f'module-{index}.git'
            revision = module['revision']
            if len(revision) not in (40, 64) or any(c not in '0123456789abcdef' for c in revision):
                raise ValueError('Invalid submodule revision')
            object_format = 'sha256' if len(revision) == 64 else 'sha1'
            if not repo.exists():
                git('init', '--bare', '-q', '--object-format=' + object_format, repo, stdout=subprocess.DEVNULL)
            actual_format = subprocess.check_output(['git', '--git-dir', str(repo), 'rev-parse', '--show-object-format'], text=True).strip()
            if actual_format != object_format:
                raise ValueError('Submodule object format mismatch')
            with (folder / f'module-{index}.pack').open('rb') as objects:
                git('--git-dir', repo, 'index-pack', '--stdin', stdin=objects, stdout=subprocess.DEVNULL)
            git('--git-dir', repo, 'cat-file', '-e', module['revision'] + '^{commit}')
            record_shallow(repo, revision, object_format)
            git('--git-dir', repo, 'update-ref', 'refs/heads/base', module['revision'])
        select_lfs(root.parent / 'repository.git', value)
        with (root / 'manifest.json.new').open('wb') as destination:
            destination.write((folder / 'manifest.json').read_bytes())
            destination.flush()
            os.fsync(destination.fileno())
        os.replace(root / 'manifest.json.new', root / 'manifest.json')
        durable_directory(root)
    upload.unlink()


def lfs_paths(repository, *filters):
    listed = subprocess.run(['git', '--git-dir', str(repository), 'lfs', 'ls-files', '--name-only', *filters,
                             'refs/heads/base'], capture_output=True, check=True).stdout.decode(errors='replace')
    # One name per '\n'-terminated line, as Horizon reads the same listing: other
    # separators, such as U+0085 or U+2028, belong to the name. The --json listing is
    # not used because git-lfs before 3.2, still shipped by some hosts and base images,
    # lacks it; a name with a newline is therefore never skipped on either end.
    return {line.removesuffix('\r') for line in listed.split('\n') if line}


def select_lfs(repository, value):
    # A repository may leave LFS paths out of the transfer. They stay pointers: git-lfs
    # skips smudging paths outside lfs.fetchinclude/fetchexclude. Every path left out
    # must be one git-lfs itself excludes, so a checkout never tries the network.
    if 'lfs' not in value and not repository.exists():
        return
    patterns, skipped = lfs_selection(value)
    if skipped:
        filters = []
        for key, flag in (('include', '-I'), ('exclude', '-X')):
            if patterns[key]:
                filters += [flag, ','.join(patterns[key])]
        excluded = lfs_paths(repository) - lfs_paths(repository, *filters)
        sent = {asset['path'] for asset in value['assets']}
        if any(asset['path'] not in excluded or asset['path'] in sent for asset in skipped):
            raise ValueError('Selected LFS content is missing from the transfer')
    local_lfs_filters(['--git-dir', repository], patterns)


def local_lfs_filters(target, patterns):
    # Both keys are always set locally, empty for an unselected side, so a global or
    # system lfs.fetchinclude/fetchexclude never changes what a checkout hydrates.
    for key, name in (('include', 'lfs.fetchinclude'), ('exclude', 'lfs.fetchexclude')):
        git(*target, 'config', '--replace-all', name, ','.join(patterns.get(key, [])))


def missing_objects(repo, revision, object_format, history):
    # Reads through a scratch repository that borrows repo's objects, so repo's own
    # shallow file cannot hide missing ancestors. Without history, only the pinned
    # commit and its tree are checked.
    with tempfile.TemporaryDirectory(dir=repo.parent) as scratch:
        probe = Path(scratch) / 'probe.git'
        git('init', '--bare', '-q', '--object-format=' + object_format, probe, stdout=subprocess.DEVNULL)
        (probe / 'objects' / 'info' / 'alternates').write_text(str((repo / 'objects').resolve()) + '\n')
        # Streamed: a full history can list millions of objects.
        missing = False
        with subprocess.Popen(['git', '--git-dir', str(probe), 'rev-list', '--objects', '--missing=print',
                               *([] if history else ['--no-walk']), revision],
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL) as listing:
            for line in listing.stdout:
                missing = missing or line.startswith(b'?')
        if listing.returncode != 0:
            raise subprocess.CalledProcessError(listing.returncode, listing.args)
    return missing


def durable_directory(path):
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def record_shallow(repo, revision, object_format):
    # A pinned-only pack carries the commit and its tree without ancestors. Git needs
    # the commit listed as shallow, or clones and history walks fail on the missing
    # history. Decide from what the repository holds: the entry is dropped only once
    # every ancestor and its tree is present, so a replay onto full history, or full
    # history arriving later, clears it, while partial history keeps it.
    if missing_objects(repo, revision, object_format, history=False):
        raise ValueError('Submodule tree is incomplete')
    listed = repo / 'shallow'
    shallow = set(listed.read_text().split()) if listed.exists() else set()
    if missing_objects(repo, revision, object_format, history=True):
        shallow.add(revision)
    else:
        shallow.discard(revision)
    # Durable before the caller publishes the manifest that makes this checkout usable.
    if shallow:
        with (repo / 'shallow.new').open('w') as pending:
            pending.write(''.join(oid + '\n' for oid in sorted(shallow)))
            pending.flush()
            os.fsync(pending.fileno())
        os.replace(repo / 'shallow.new', listed)
    elif listed.exists():
        listed.unlink()
    durable_directory(repo)


def beside_siblings(worktree, repository):
    # A sibling lives beneath the shared or legacy session root and must belong
    # to exactly this repository; the root itself must not be a worktree.
    if (worktree.parent.parent != AGENTS and worktree.parent != SHARED) or not (worktree / '.git').is_file() or (worktree.parent / '.git').exists():
        return False
    common = subprocess.run(['git', '-C', str(worktree), 'rev-parse', '--path-format=absolute', '--git-common-dir'],
                            capture_output=True, text=True, check=False)
    return common.returncode == 0 and Path(common.stdout.strip()).resolve() == repository.resolve()


def register(worktree, modules, index, origin):
    # Git treats a submodule as initialized only when its superproject's config names it,
    # so `git submodule status` would print it as uninitialized and `update --init` would
    # clone it again. Name the imported material, which also keeps both off the network.
    path = PurePosixPath(modules[index]['path'])
    parents = [PurePosixPath(m['path']) for m in modules[:index]]
    parent = max((p for p in parents if p in path.parents), key=lambda p: len(p.parts), default=None)
    superproject = worktree / parent if parent else worktree
    relative = str(path.relative_to(parent) if parent else path)
    listing = subprocess.run(['git', '-C', str(superproject), 'config', '-z', '-f', '.gitmodules',
                              '--get-regexp', r'^submodule\..*\.path$'], capture_output=True, text=True, check=False)
    names = [key.removeprefix('submodule.').removesuffix('.path')
             for key, _, value in (record.partition('\n') for record in listing.stdout.split('\0'))
             if value == relative]
    if len(names) != 1:
        # A raw gitlink without exactly one .gitmodules mapping stays checked out but
        # unregistered, as before: Git itself cannot name it for `submodule status`.
        print(f'horizon-worker-source: {path} has {"no" if not names else "more than one"} '
              '.gitmodules mapping; leaving it unregistered', file=sys.stderr)
        return
    git('-C', superproject, 'config', f'submodule.{names[0]}.url', origin)
    git('-C', superproject, 'config', f'submodule.{names[0]}.active', 'true')


def checkout(worktree, alias=None):
    root = material(alias)
    worktree = Path(worktree).resolve()
    alone = alias is None and (worktree == SHARED or worktree.parent in (AGENTS, Path('/workspace/companions/worktrees')))
    if not (alone or beside_siblings(worktree, root.parent / 'repository.git' if alias else Path('/workspace/repository.git'))):
        raise ValueError('Invalid agent worktree')
    if not (root / 'manifest.json').exists():
        raise ValueError('Source dependencies have not been imported')
    modules = manifest(root)['modules']
    for index, module in enumerate(modules):
        path = worktree / module['path']
        if not path.resolve().is_relative_to(worktree):
            raise ValueError('Submodule checkout escapes agent worktree')
        origin = root / f'module-{index}.git'
        if not (path / '.git').exists():
            git('clone', '--no-checkout', origin, path)
        actual = subprocess.check_output(['git', '-C', str(path), 'remote', 'get-url', 'origin'], text=True).strip()
        if actual != str(origin):
            raise ValueError('Submodule source binding mismatch')
        if alias is not None:
            # The global lfs.storage names the primary's store.
            git('-C', path, 'config', 'lfs.storage', root / 'lfs')
        # Submodule LFS content is always sent in full.
        local_lfs_filters(['-C', path], {})
        # Called only before the session launch fence: finish an interrupted checkout.
        git('-C', path, 'checkout', '--force', '--detach', module['revision'])
        git('-C', path, 'reset', '--hard', module['revision'])
        register(worktree, modules, index, origin)


if __name__ == '__main__':
    if sys.argv[1:] == ['--shallow-contract']:
        # Imports record pinned-only submodule packs as shallow (see record_shallow).
        print('horizon-source-shallow-contract=1')
        sys.exit(0)
    if sys.argv[1:] == ['--lfs-selection-contract']:
        # Imports honor a manifest's LFS selection (see select_lfs).
        print('horizon-source-lfs-selection-contract=1')
        sys.exit(0)
    os.umask(0o077)
    with open('/workspace/source.lock', 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        command, sibling = sys.argv[1:], None
        if len(command) in (3, 4) and command[-2] == '--sibling':
            command, sibling = command[:-2], command[-1]
        if command == ['import']:
            import_source(material(sibling), staging(sibling))
        elif len(command) == 2 and command[0] == 'checkout':
            checkout(command[1], sibling)
        else:
            raise ValueError('Usage: horizon-worker-source import|checkout WORKTREE [--sibling ALIAS]')
