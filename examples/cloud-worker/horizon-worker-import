#!/bin/bash
set -euo pipefail
umask 077
revision="${1:?revision required}"
[[ "$revision" =~ ^[0-9a-f]{40}$|^[0-9a-f]{64}$ ]] || exit 2
exec 9>/workspace/import.lock
flock 9
if [ ! -d /workspace/repository.git ]; then git init --bare /workspace/repository.git >/dev/null; fi
git --git-dir=/workspace/repository.git index-pack --stdin < /workspace/horizon-transfer.pack >/dev/null
git --git-dir=/workspace/repository.git cat-file -e "$revision^{commit}"
if git --git-dir=/workspace/repository.git rev-parse --verify refs/heads/base >/dev/null 2>&1; then
    [ "$(git --git-dir=/workspace/repository.git rev-parse refs/heads/base)" = "$revision" ] || { echo 'Cloud base revision mismatch' >&2; exit 3; }
else
    git --git-dir=/workspace/repository.git update-ref refs/heads/base "$revision"
fi
rm /workspace/horizon-transfer.pack
printf 'Committed revision imported: %s\n' "$revision"
