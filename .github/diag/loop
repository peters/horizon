#!/bin/bash
# Diagnostic loop: run the browser lane module repeatedly and keep the evidence of each failure.
set -u
n=${1:-25}
pass=0; fail=0
for i in $(seq 1 "$n"); do
  sudo bash .github/diag/sampler > /var/tmp/sampler.log 2>&1 & sampler=$!
  start=$(date +%s.%N)
  (cd examples/cloud-worker && python3 -B -m unittest test_browser_lane) > /var/tmp/out.log 2>&1; status=$?
  sudo kill $sampler; wait $sampler 2>/dev/null
  printf 'iteration %s status=%s elapsed=%.1f\n' "$i" "$status" "$(echo "$(date +%s.%N) - $start" | bc)"
  if [ "$status" = 0 ]; then pass=$((pass+1)); continue; fi
  fail=$((fail+1))
  echo "::group::iteration $i failure"
  cut -c1-6000 /var/tmp/out.log
  echo "--- sampler"; cut -c1-300 /var/tmp/sampler.log | head -400
  echo "::endgroup::"
done
echo "PASS=$pass FAIL=$fail"
