FROM rust:1.98.1-slim-bookworm@sha256:ff521445a372125ed4f76e1453a1f8098f2d05332d1601d30db1c1f62757e730 AS helpers
COPY build-worker-tools.sh /build-worker-tools.sh
RUN bash /build-worker-tools.sh
COPY collect-helper-notices.py /collect-helper-notices.py
RUN python3 /collect-helper-notices.py
FROM rust:1.98.1-slim-bookworm@sha256:ff521445a372125ed4f76e1453a1f8098f2d05332d1601d30db1c1f62757e730 AS browser-packages
RUN apt-get update && mkdir /packages && cd /packages \
    && apt-get download chromium=153.0.8010.52-1~deb12u1 chromium-common=153.0.8010.52-1~deb12u1 \
        chromium-sandbox=153.0.8010.52-1~deb12u1 libjpeg62-turbo=1:2.1.5-2 libdav1d6=1.0.0-2+deb12u1
FROM node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS agent-runtime
FROM ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
COPY --from=helpers /output/ /usr/local/
COPY --from=helpers /usr/local/cargo /usr/local/cargo
COPY --from=helpers /usr/local/rustup /usr/local/rustup
COPY --from=browser-packages /packages/ /tmp/browser-packages/
COPY --from=agent-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=agent-runtime /usr/local/LICENSE /usr/local/share/licenses/node/LICENSE
COPY --from=agent-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
COPY install-build-tools.sh retain-component-sources.py component-sources.json /usr/local/lib/horizon/
COPY THIRD-PARTY.md /usr/local/share/licenses/horizon/THIRD-PARTY.md
ENV RUSTUP_HOME=/usr/local/rustup RUSTUP_TOOLCHAIN=1.98.1 CARGO_HOME=/workspace/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"
ENV LIBGL_ALWAYS_SOFTWARE=1 WGPU_BACKEND=vulkan
RUN bash /usr/local/lib/horizon/install-build-tools.sh cpu
LABEL org.opencontainers.image.source="https://github.com/peters/horizon" \
    org.opencontainers.image.description="Cloud development environment with isolated workspaces" \
    io.horizon.worker.contract="1" io.horizon.worker.capabilities="1"
EXPOSE 22
ENTRYPOINT ["/usr/bin/tini", "-s", "--", "/usr/local/bin/horizon-worker-start"]
