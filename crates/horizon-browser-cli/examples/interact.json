{
  "version": 1,
  "variables": {
    "url": "https://example.com",
    "selector": "a"
  },
  "steps": [
    {
      "id": "panels",
      "tool": "browser_list"
    },
    {
      "id": "open",
      "tool": "browser_navigate",
      "arguments": {
        "panel_id": { "$ref": "panels#/panels/0/panel_id" },
        "url": { "$var": "url" }
      }
    },
    {
      "id": "matches",
      "tool": "browser_query",
      "arguments": {
        "panel_id": { "$ref": "panels#/panels/0/panel_id" },
        "selector": { "$var": "selector" }
      }
    },
    {
      "id": "click",
      "tool": "browser_act",
      "arguments": {
        "panel_id": { "$ref": "panels#/panels/0/panel_id" },
        "action": "click",
        "selector": { "$var": "selector" }
      }
    }
  ]
}
