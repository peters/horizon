{
  "version": 1,
  "variables": {
    "url": "http://127.0.0.1:8080/basic-auth",
    "origin": "http://127.0.0.1:8080",
    "username": "smoke-user",
    "password": "smoke-pass-zephyr"
  },
  "steps": [
    {
      "id": "panels",
      "tool": "browser_list"
    },
    {
      "id": "credentials",
      "tool": "browser_http_auth",
      "arguments": {
        "panel_id": { "$ref": "panels#/panels/0/panel_id" },
        "operation": "set",
        "username": { "$var": "username" },
        "password": { "$var": "password" },
        "origin": { "$var": "origin" }
      }
    },
    {
      "id": "open",
      "tool": "browser_navigate",
      "arguments": {
        "panel_id": { "$ref": "panels#/panels/0/panel_id" },
        "url": { "$var": "url" }
      }
    },
    {
      "id": "ready",
      "tool": "browser_wait",
      "arguments": {
        "panel_id": { "$ref": "panels#/panels/0/panel_id" },
        "selector": "#auth-marker",
        "state": "present"
      }
    }
  ]
}
