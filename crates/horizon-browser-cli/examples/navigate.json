{
  "version": 1,
  "variables": {
    "url": "https://example.com"
  },
  "steps": [
    {
      "id": "panels",
      "tool": "browser_list"
    },
    {
      "id": "open",
      "tool": "browser_navigate",
      "arguments": {
        "panel_id": { "$ref": "panels#/panels/0/panel_id" },
        "url": { "$var": "url" }
      }
    },
    {
      "id": "ready",
      "tool": "browser_wait",
      "arguments": {
        "panel_id": { "$ref": "panels#/panels/0/panel_id" },
        "selector": "body",
        "state": "present"
      }
    }
  ]
}
